# Termablo in French. Translated from en.maml; see docs/translating.md.
# Plural forms: one, other. Genders: m, f, mp, fp, mv, fv.
{
  msg: {
    welcome_help: "Appuyez sur ? pour l'aide. Le capitaine Voss, près de la taverne, a du travail pour vous."
    enter: "Vous entrez dans : {area}."
    far_beyond: "Quelque chose ici vous dépasse de loin."
