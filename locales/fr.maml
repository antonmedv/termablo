    open_chest: "Vous ouvrez le coffre."
    altar_cold: "L'autel est froid, désormais."
    altar_restore: "Une lumière de sang vous baigne. Vous voilà rétabli."
    altar_xp: "Un savoir interdit envahit votre esprit. (+{n} XP)"
    altar_gift: "L'autel vous offre un présent."
    slain: {
        m: "{who} vous a tué."
        f: "{who} vous a tué."
        other: "Vous avez été tué par {who}."
      }
    no_healing_potions: "Vous n'avez aucune potion de soins."
    full_life: "Votre vie est déjà au maximum."
    drink_healing: "Vous buvez une potion de soins."
    no_mana_potions: "Vous n'avez aucune potion de mana."
    full_mana: "Votre mana est déjà au maximum."
    drink_mana: "Vous buvez une potion de mana."
    already_in_town: "Vous êtes déjà en ville."
    no_scrolls: "Vous n'avez aucun parchemin de portail de ville."
    boneking_raises: "Le Roi des Os relève les morts !"
    boneking_greets: "Le Roi des Os : « Encore une torche à moucher. À genoux, et rejoignez ma cour. »"
    boneking_dead: "Les cryptes retombent dans le silence. Retournez voir le capitaine Voss."
    oracle_reforms: "La Sibylle se dissout en brume, puis se reforme."
    oracle_lights: "Des lumières froides s'assemblent autour de la Sibylle."
    oracle_greets: "La Sibylle Noyée : « J'ai vu votre fin, petite flamme. Elle est humide et froide. »"
    oracle_dead: "Le chant de la Sibylle s'éteint. Plus bas encore, quelque chose brûle... Retournez voir Voss."
    wanderer_greets: "Le Dernier Vagabond : « Encore un étranger. Ils envoient toujours un étranger. »"
    wanderer_portal: "Le Dernier Vagabond sort du portail. Celui-ci se referme derrière lui."
    wanderer_follows: "Le Dernier Vagabond vous suit."
    wanderer_home: "Le Dernier Vagabond : « Vous m'avez montré le chemin du retour. »"
    wanderer_cuts: "Le Dernier Vagabond entaille {who}."
    wanderer_kills: "Le Dernier Vagabond abat {who}."
    wanderer_taunt: "Le Dernier Vagabond : « À moi aussi, on a donné une épée et un discours de capitaine. »"
    town_empty: "Il ne reste plus personne à Emberhold, à part vous."
    forge_cold: "La forge d'Hadrik s'éteint."
    wanderer_last_words: "Le Dernier Vagabond : « Continuez de marcher. »"
    wanderer_dead: "La lumière rouge s'éteint, et les ténèbres lâchent le feu."
    unseal_here: "Là où il attendait, un passage s'ouvre vers les profondeurs."
    unseal_far: "Loin en contrebas, dans l'Âtre, un passage s'ouvre vers les profondeurs."
    running: "{who} fuit pour sauver sa vie."
    quest_reward: {
        m: "{who} vous remet {n} pièces d'or et le {item}."
        f: "{who} vous remet {n} pièces d'or et la {item}."
        mv: "{who} vous remet {n} pièces d'or et l'{item}."
        fv: "{who} vous remet {n} pièces d'or et l'{item}."
        mp: "{who} vous remet {n} pièces d'or et les {item}."
        fp: "{who} vous remet {n} pièces d'or et les {item}."
        other: "{who} vous remet {n} pièces d'or et {item}."
      }
    quest_new: "Nouvelle quête : {name}."
    topic_new: "En ville, vous pourriez vous renseigner sur : {topic}."
    cannot_afford: "Vous n'en avez pas les moyens."
    belt_full: "Votre ceinture est pleine."
    gamble: {
        m: "Hadrik déballe un {item}. {n}g, ni repris ni échangé."
        f: "Hadrik déballe une {item}. {n}g, ni repris ni échangé."
