    pack_full: "Votre sac est plein."
    pack_too_full: "Votre sac est trop plein pour cet échange."
    nothing_to_pick_up: "Il n'y a rien à ramasser ici."
    notice_item: "Vous remarquez quelque chose au sol."
    explored: "Plus rien à explorer ici."
    spot: "Vous repérez {who}."
    boss_destroyed: {
        m: "{who} a été détruit !"
        f: "{who} a été détruite !"
