# Termablo in Russian. Translated from en.maml; see docs/translating.md.
# Plural forms: one, few, many. Genders: m, f, n, pl.
{
  msg: {
    welcome_help: "Нажмите ?, чтобы открыть справку. У капитана Восса возле таверны есть для вас работа."
    enter: "Перед вами — {area}."
    far_beyond: "Здесь таится то, что вам далеко не по силам."
    fountain: "Холодная вода затягивает ваши раны."
    portal_step: "Вы шагаете в портал."
    portal_collapse: "Портал схлопывается за вашей спиной."
    portal_open: "Мерцающий синий портал разрывает воздух."
    see_item: {
        other: "Здесь лежит {item}. (g — поднять)"
        pl: "Здесь лежат {item}. (g — поднять)"
      }
    see_items: "Здесь лежит несколько вещей. (g — поднять)"
    pickup_gold: {
        one: "Вы подбираете {n} золотой."
        few: "Вы подбираете {n} золотых."
        many: "Вы подбираете {n} золотых."
      }
    pickup_potion: "Вы подбираете {item}."
    belt_no_room: "На поясе нет места: {item}."
    pickup_scroll: "Вы подбираете {item}."
    pickup_item: "Подобрано: {item}."
    pack_full: "Сумка полна."
    pack_too_full: "В сумке не хватает места для обмена."
    nothing_to_pick_up: "Здесь нечего поднять."
    notice_item: "Вы замечаете что-то на земле."
    explored: "Здесь больше нечего исследовать."
    spot: "Вы замечаете: {who}."
    boss_destroyed: {
        m: "{who} уничтожен!"
        f: "{who} уничтожена!"
        n: "{who} уничтожено!"
        pl: "{who} уничтожены!"
      }
    elite_slain: {
        m: "{who} повержен!"
        f: "{who} повержена!"
        n: "{who} повержено!"
        pl: "{who} повержены!"
      }
    monster_dies: "{who} погибает."
    out_of_range: "{who} вне досягаемости."
    no_target: "Целей не видно."
    no_mana: "Не хватает маны."
    level_up: "Вы достигли уровня {n}! (c — распределить 5 очков характеристик)"
    open_chest: "Вы открываете сундук."
    altar_cold: "Алтарь остыл."
    altar_restore: "Вас омывает кровавый свет. Силы возвращаются к вам."
    altar_xp: "Запретное знание затопляет ваш разум. (+{n} опыта)"
    altar_gift: "Алтарь подносит вам дар."
    slain: {
        other: "Вас настигло {who}."
        m: "Вас настиг {who}."
        f: "Вас настигла {who}."
        n: "Вас настигло {who}."
        pl: "Вас настигли {who}."
      }
    no_healing_potions: "У вас нет зелий лечения."
    full_life: "Ваше здоровье и так полное."
    drink_healing: "Вы пьёте зелье лечения."
    no_mana_potions: "У вас нет зелий маны."
    full_mana: "Ваша мана и так полна."
    drink_mana: "Вы пьёте зелье маны."
    already_in_town: "Вы уже в городе."
    no_scrolls: "У вас нет свитков городского портала."
    boneking_raises: "Костяной Король поднимает мёртвых!"
    boneking_greets: "Костяной Король: «Ещё один факел, который надо задуть. Преклони колени и встань при моём дворе.»"
    boneking_dead: "Склепы затихают. Возвращайтесь к капитану Воссу."
    oracle_reforms: "Провидица рассеивается туманом и собирается вновь."
    oracle_lights: "Вокруг Провидицы собираются холодные огни."
    oracle_greets: "Утопшая Провидица: «Я видела твой конец, огонёк. Он мокрый и холодный.»"
    oracle_dead: "Песнь Провидицы смолкает. А глубже что-то горит... Возвращайтесь к Воссу."
    wanderer_greets: "Последний Странник: «Ещё один чужак. Всегда присылают чужака.»"
    wanderer_portal: "Последний Странник выходит из портала. Портал схлопывается за его спиной."
    wanderer_follows: "Последний Странник идёт за вами."
    wanderer_home: "Последний Странник: «Ты показал мне дорогу домой.»"
    wanderer_cuts: "{who} получает рану от клинка Последнего Странника."
    wanderer_kills: "{who} падает под клинком Последнего Странника."
    wanderer_taunt: "Последний Странник: «Мне тоже дали меч. И капитанскую речь в придачу.»"
    town_empty: "В Эмберхолде не осталось никого, кроме вас."
    forge_cold: "Кузня Хадрика остывает."
    wanderer_last_words: "Последний Странник: «Иди дальше.»"
    wanderer_dead: "Красный свет гаснет, и тьма отпускает огонь."
    unseal_here: "Там, где он ждал, открывается путь вниз."
    unseal_far: "Далеко внизу, в Очаге, открывается путь вниз."
    running: {
        other: "{who} бежит, спасая свою жизнь."
        pl: "{who} бегут, спасая свою жизнь."
      }
    quest_reward: {
        one: "{who} вручает вам {n} золотой. И ещё: {item}."
        few: "{who} вручает вам {n} золотых. И ещё: {item}."
        many: "{who} вручает вам {n} золотых. И ещё: {item}."
      }
    quest_new: "Новое задание: {name}."
    topic_new: "Об этом можно расспросить в городе: {topic}."
    cannot_afford: "Вам это не по карману."
    belt_full: "Пояс полон."
    gamble: "Хадрик разворачивает свёрток: {item}. {n}g, возврата нет."
    reroll: "Хадрик выкладывает свежий товар за {n}g."
    bought: "Куплено: {item} за {n}g."
    sold: "Продано: {item} за {n}g."
    equip: "Надето: {item}."
    unequip: "Снято: {item}."
    drop: "Выброшено: {item}."
    mirela_healthy: "Мирела оглядывает вас. «Здоров как бык. Купи что-нибудь, милок.»"
    mirela_free: "Мирела перевязывает ваши раны. «С молодых не беру. А теперь купи что-нибудь, милок.»"
    mirela_broke: "Мирела качает головой. «Травы денег стоят, милок.»"
    mirela_partial: "Мирела делает, что можно на ваши {n}g. «Приходи с деньгами побольше, милок.»"
    mirela_paid: "Мирела перевязывает ваши раны за {n}g. «Вот так. А теперь купи что-нибудь, милок.»"
  }
  ref: {
    the: "{name}"
    a: "{name}"
    death_flames: { text: "предсмертное пламя ({name})", gender: "n" }
  }
  talk: {
    hadrik: {
      greet: "Сталь против тьмы. Гляди. В [кузне](forge) жарко. Там всегда жарко."
      greet_again: "Вернулся. Что чинить?"
      greet_boneking: "Утром слышал колокола склепа. Думал, умом тронулся. Твоих рук дело? Тогда ты заслужил добрую сталь."
      greet_oracle: "Последний [чужак](stranger), которого я снаряжал в глубину, так и не пришёл чинить доспех."
      greet_wanderer: "Когда он пал, кузня вспыхнула белым, потом унялась. Сорок лет при ней, а такого не видал. У этой наковальни тебе рады."
      greet_hurt: "Кровью мне всю наковальню залил. Сначала к Миреле. Сталь потом."
      greet_broke: "Глядеть даром. Остальное — нет."
      greet_kingsbane: "Королебой. Последнюю заточку этому топору давал я, для [отца](father) капитана. Покажи его Воссу. Или не показывай."
      greet_kingsbane_again: "Лезвие держи в масле. Оно это заслужило."
      greet_crown: "В моей кузне корону сними. Огонь от неё нервничает."
      greet_crown_again: "Корону. Сними."
      forge: "Сорок лет я её храню. Её передают из рук в руки, от кузнеца к кузнецу. В её утробе горит сам [Уголь](ember). В тот день, когда она погаснет, мы бежим. Это не присказка."
      ember: "Народ думает, он лежит на площади, на постаменте. Он живёт в моей кузне. Каждый фонарь в городе зажжён отсюда. Я об этом не болтаю. И ты не будешь."
      ember_again: "Сказал же: я об этом не болтаю."
      stranger: "Купил тот же меч, что и ты. Платил старой монетой, не торговался. Прошёл за топь и пошёл дальше. Его точило до сих пор у меня. Ещё захочет забрать."
      stranger_after: "Значит, всё-таки вернулся домой. Сегодня брошу его точило в огонь."
      cult: "Первыми они пришли ко мне — эти, из [Культа Угля](cult). Хотели, чтобы я дал огню погаснуть и покончил с долгом. Я указал им на дверь. С молотом в руке."
      portals: "Пепел из кузни, завёрнутый в бумагу. Каждая искра знает дорогу домой, к очагу, — значит, и пепел знает. Я его сметаю, Мирела заворачивает."
      aldous: "Олдос был одним из них. Теперь сидит у могил и твердит каждому встречному, что [Уголь](ember) — это рана. Может, и так. Рана лучше могилы. Не говори ему, что я сказал «может»."
      pell: "Мальчишка у фонтана. Раз пришёл в кузню погреться. Простоял у огня час и не оттаял."
    }
    mirela: {
      greet: "Садись, садись. От тебя пахнет дымом и могильной пылью. Посмотрим, что у тебя сломано."
      greet_again: "Опять ты, голубчик? Дай-ка на тебя посмотреть."
      greet_boneking: "Утром меня разбудили колокола склепа. Я плакала, голубчик, и сама не знаю отчего.\nТеперь Восс пошлёт тебя за [ней](oracle). Прежде чем идти, спроси меня о ней. Прошу тебя."
      greet_oracle: "Как тихо, дитя. Мой кристалл не издал ни звука с тех пор, как ты поднялся.\nЯ не сержусь, голубчик. Ты сделал то, за что тебе заплатили. Но положи руку на пол. Он тёплый."
      greet_wanderer: "Ты вернулся. А он так и не вернулся — по-настоящему. Садись, голубчик, я займусь твоими ожогами."
      greet_hurt: "Ох, дитя, да на кого ты похож. Сядь, пока не упал."
      greet_nopots: "Ни одной склянки на поясе? Там, внизу? Садись, голубчик. Сейчас поправим."
      greet_crown: "Сними корону за моим столом, голубчик. Она шепчет, а я слишком стара, чтобы слушать."
      greet_crown_again: "Корону, голубчик. Сними."
      oracle: "Мой кристалл — из её грота. Когда ей снятся сны, он поёт. Она ни на кого не охотится, дитя. Она что-то держит внизу, под водой. Не знаю что. Знаю, что оно горячее.\nВосс называет это «покончить с ней». Я называю это «открыть дверь». Иди вниз, раз должен, но сперва послушай, а уж потом поднимай клинок."
      oracle_again: "Я рассказала тебе, что говорит мой кристалл. У Восса есть меч, а у меня — поющий камень. Сам выбирай, кому верить."
      oracle_after: "Мой кристалл перестал петь. Весь город теперь спит спокойно. А я — нет. Что бы она там ни держала, оно поднимается из [Бездны](abyss)."
      blackmarsh: "Стоячие камни — её. Она подняла их по пути в воду, как Эдран поднял свои алтари. Огни не охотятся, голубчик. Они спрашивают. [Пелл](pell) ответил «да»."
      abyss: "Под её озером горит камень. Оттуда и вырезали тот уголь, если верить старым песням. Я уже начинаю верить."
      ember: "Тёплый свет пришёл снизу. А мой, холодный, — от неё. Город живёт меж двух огней, а думает, что живёт одним."
      pell: "Бедный ягнёнок. В него вошла вода. Он слышит её, как мой кристалл, только ему её на ночь на полку не отложить."
      pell_oracle: "Он не сказал ни слова с тех пор, как замолк мой кристалл. По вечерам я сижу с ним. Он, кажется, не против."
      pell_oracle_again: "Всё ни слова. Я приношу ему суп. Он не ест, но миску держит."
      pell_wanderer: "Он заговорил сегодня утром, голубчик! Попросил хлеба. Просто хлеба. Я опять плакала."
      pell_wanderer_again: "Он холодный, но ест. Уже что-то."
    }
    voss: {
      greet: "Странник. Хорошо. Нам нужен клинок, который не дрогнет.\nЧетырьмя этажами ниже, в [склепе](crypt), к востоку за полями, [Костяной Король](boneking) восседает на троне из рёбер. Уничтожьте его.\nДержите при себе [свиток портала](portals). Возвращайтесь живым."
      greet_again: "Ещё дышите. Хорошо. [Костяной Король](boneking) — в [склепе](crypt), четырьмя этажами ниже. Принесите мне его прах."
      boneking_reward: "Костяной Король обратился в прах? Значит, колокола склепа снова могут звонить.\nВозьмите — это принадлежало [моему отцу](father). И золото, разумеется."
      oracle_reward: "Провидица умолкла... Не думал, что когда-нибудь усну, не слыша её.\nПод её озером горит камень. Говорят, у [Бездны](abyss) нет дна. Будьте осторожны.\nОднажды я уже посылал туда [человека](stranger). Я перестал считать дни."
      greet_boneking: "В склепе тихо. Теперь — [Чёрная Топь](blackmarsh), к северу от полей.\nИдите за холодными огнями вниз, в грот. Покончите с [Провидицей](oracle)."
      greet_boneking_again: "[Чёрная Топь](blackmarsh), к северу от полей. Идите вниз за холодными огнями. Назад их за собой не ведите."
      greet_oracle: "Вы сделали больше, чем любой из нас осмелился.\nМирела говорит, ветер теперь пахнет кузней. Пусть говорит. Если нужно идти глубже... [Бездна](abyss) ждёт под озером Провидицы."
      greet_oracle_again: "Что бы ни ждало в [Бездне](abyss), на моих картах этого нет. Идите осторожно — или не идите вовсе."
      greet_wanderer: "Фонари снова горят. Кем бы он ни был, когда-то он был одним из нас.\nИдите дальше, чужак. За это мы вам и платим."
      greet_wanderer_again: "Стража снова спит посменно. Это ваша заслуга. Только речей не надо."
      greet_hurt: "Вы мне все ворота кровью залили. Сначала к Миреле, потом ко мне."
      greet_kingsbane: "Этот топор. Королебой. Мой [отец](father) унёс его вниз. Оставьте себе. Он предпочёл бы, чтобы топор рубил, а не ржавел."
      greet_kingsbane_again: "Всё ещё при вас. Хорошо."
      greet_crown: "Это корона [Костяного Короля](boneking)? Не носите её на площади. Люди помнят."
      greet_crown_again: "Корону, чужак. Не на моей площади."
      crypt: "Королевский склеп, на восток, по ту сторону Пепельных Полей. Четыре этажа, холод и пыль. Жаровни зажигаются сами. Не стойте рядом с ними."
      boneking: "Четыре этажа под часовней, на троне из рёбер. Мой [отец](father) спустился за ним с топором. Принесите мне его прах."
      boneking_after: "Прах, говорите. Хорошо. Поверю, когда услышу колокола."
      father: "Он взял Королебой, ушёл в [склеп](crypt) и не вернулся. Наутро стража выбрала меня. Больше выбирать было некого."
      father_again: "Я рассказал всё, что знаю. Оставьте это."
      father_after: "Вы принесли то, что было его. Никому из нас это не удалось. Больше не спрашивайте."
      oracle: "Она утопилась в гроте под [Чёрной Топью](blackmarsh), а теперь зовёт заблудших вниз, за собой. Покончите с этим.\nМирела скажет вам, что она что-то держит внизу. Мирела слушает камень. А я хороню тех, кому этот камень поёт."
      oracle_after: "Умолкла. Теперь я сплю. Странно, какой громкой бывает тишина."
      stranger: "До вас был один. Хорошо владел клинком. Я послал его вниз, за озеро Провидицы. Как правило, я не нанимаю дважды на одну работу."
      stranger_after: "Кем бы он ни был, когда-то он был одним из нас. На этом всё."
      cult: "Предатели. Поколение назад они ушли вниз, чтобы отдать огонь обратно. Некоторые до сих пор там. Всё отдают."
      aldous: "Всё, что осталось от Культа. Я позволяю ему сидеть у могил, потому что мёртвые его не слушают. Вам тоже не советую."
      pell: "Мальчишка пошёл за болотными огнями и вернулся холодным. Когда её не станет, он отогреется. Так я и говорю его сестре."
      pell_oracle: "Мальчик не сказал ни слова с тех пор, как вы поднялись. Дайте ему время. Холод уходит не сразу."
      pell_oracle_again: "Дайте мальчику время."
    }
    aldous: {
      greet: "Ещё один клинок Восса. Садись, если хочешь: могилы не против компании. Спроси меня о [Культе](cult). Город расскажет тебе, кем мы были. Я расскажу, что мы видели."
      greet_again: "Ещё дышишь. Огонь пока не решил, что с тобой делать."
      greet_boneking: "Значит, Эдран наконец улёгся. Ты оказал ему милость. Он бы поблагодарил, если бы тьма оставила ему рот."
      greet_oracle: "Положи руку на землю. Тёплая, правда? Вот что она держала. Ты выдернул пробку, Странник. Теперь посмотрим, что поднимется."
      greet_oracle_again: "Сегодня теплее. Завтра будет ещё теплее."
      greet_wanderer: "Он был тем, кем огонь хочет сделать каждого из нас. Ты его уложил. Огонь сделает другого. Он терпелив. Я тоже."
      greet_hurt: "Кровь идёт? Ступай к Миреле. Огонь любит этот запах."
      greet_crown: "Корона Эдрана. Уже слышишь её? Услышишь."
      cult: "Мы не были предателями. Мы единственные слушали. [Уголь](ember) никогда не был нашим, и мы пошли вниз, чтобы вернуть его. Огонь нам обрадовался. Тех, кто остался, он переделал. Я сбежал. Вот и вся моя ересь."
      ember: "В городе говорят, что Эдран вынес его наверх. Он его вырезал. Тьма не голодна, Странник. Это рана, которая пытается затянуться, а Эмберхолд — заноза в ней. Спроси Хадрика, почему он никогда не спит."
      edran: "Вор в короне. Его собственная [Провидица](oracle) умоляла вернуть уголь. Он оставил его себе, и тьма взяла в уплату его лицо."
      abyss: "Я был там, куда ты идёшь. Там кровоточит камень. Там Эдран вырезал уголь, и рана так и не закрылась. То, от чего его отсекли, — там, внизу, и оно не спит."
      abyss_after: "Теперь она открыта. Понюхай колодцы. То, что поднимется следующим, будет не мелким. И не глупым."
      oracle: "Из всех нас только она заплатила сполна. Легла в воду, чтобы огонь не жёг нам спины, и держит его уже много поколений. Восс хочет её смерти. Ну разумеется. Он ни разу не заглянул ниже собственных сапог."
      oracle_after: "Она держала его поколениями. Ты всё разрушил за одно утро. Я не сужу. Я ведь сбежал, помнишь?"
      stranger: "Я разминулся с ним по дороге наверх, под озером. Он спросил, далеко ли до дна. Я сказал правду: дна нет. Он поблагодарил. Он улыбался."
      stranger_after: "Так вот что огонь делает с человеком, который сам дошёл до него. А я-то надеялся, что он зол только на меня."
      pell: "Мальчишка слышит её. Я слышу другое. Вдвоём мы спим, как один человек в дурную ночь."
      aldous: "Брат. Не осталось ордена, в котором можно быть братом. Зови так, если хочешь: это всё, что я вынес оттуда."
    }
    pell: {
      greet: "Ты тёплый. Тут наверху все тёплые."
      greet_again: "Вода опять говорит. Не с тобой."
      greet_boneking: "Колокола. Она их почувствовала, под болотом. Она устала. Трудно держать, когда ты одна."
      greet_oracle: "(Пелл смотрит на фонтан и молчит. Вода совсем неподвижна.)"
      greet_oracle_again: "(Пелл не поднимает глаз.)"
      greet_wanderer: "Мне холодно. Мне никогда не было холодно. Это так — быть только собой?"
      greet_wanderer_again: "Сестра говорит, мне опять можно на болото. А я, наверно, не хочу."
      oracle: "Она холодная, чтобы мы не сгорели. Она попросила меня подержать немножко за неё. Я сказал «да». Теперь я тоже холодный."
      oracle_after: "(Пелл качает головой. О ней он говорить не станет.)"
      blackmarsh: "Огни не звали. Они спрашивали. Почти все говорят «да». Я сказал «да»."
    }
    any: {
      ember: "Король [Эдран](edran) вынес Уголь снизу голыми руками. Каждый фонарь Эмберхолда зажжён от [кузни](forge) Хадрика, а кузня — от Угля. Тьма останавливается у ворот."
      edran: "Первый король. Спустился один, а поднялся с огнём. Тьма взяла за это его лицо, а потом и череп. По пути наверх он воздвиг [алтари](altars); некоторые стоят до сих пор."
      altars: "На каждом Эдран оставил каплю своей крови, чтобы купить ещё час безопасного пути. Окропите алтарь своей кровью — и он заплатит. Один раз."
      forge: "Кузня Хадрика не гасла сорок лет. Спросите его о ней, если вам по душе тяжёлые взгляды."
      portals: "Прочтите свиток портала — и вы снова на площади у фонтана. Хадрик сметает для них пепел, Мирела заворачивает. Почему это действует — спросите у него."
      crypt: "Королевский склеп, к востоку от ворот, по ту сторону Пепельных Полей. Там покоится король [Эдран](edran) со всем своим двором. «Покоится» — это щедро сказано. Лучше всех о нём знает капитан."
      boneking: "Он восседает на троне из рёбер, четырьмя этажами ниже, под пустой короной. Говорят, он ещё не отцарствовал."
      boneking_after: "Говорят, Костяной Король обратился в прах. Колокола склепа снова могут звонить."
      father: "Отец капитана ушёл в склеп со старым топором. Капитан об этом не говорит. И вам не стоит."
      blackmarsh: "К северу от полей. Над водой плывут холодные огни. Не ходите за ними. Все за ними ходят. Мирела слушает эту воду; спросите её."
      oracle: "Провидица самого короля. Она говорила ему не брать уголь. Он не послушал, и тогда она ушла в воду под [Чёрной Топью](blackmarsh) и больше не поднялась."
      oracle_after: "Болотные огни погасли. Люди говорят, всё кончено. Мирела не говорит ничего."
      abyss: "Под озером Провидицы горит камень. Говорят, у Бездны нет дна. Туда ушёл [Культ Угля](cult)."
      cult: "Поколение назад кое-кто решил, что тьме задолжали её уголь. Они спустились расплатиться. Огонь переделал их. Вернулся один: [брат Олдос](aldous), тот, что у могил. Только не заводите его."
      stranger: "Спросите Хадрика. Он продал тому меч и кое-что из его вещей оставил себе."
      aldous: "Вернулся из Бездны прошлой зимой, обожжённый с одного бока. Зовёт себя братом. Сидит на кладбище и говорит с камнями."
      pell: "Мальчишка у фонтана. Пошёл за болотными огнями и вернулся холодным. Сестра после заката его имени не произносит."
      stranger_after: "Фонари снова горят. Его имени никто не произносит. Никто его и не знал."
    }
  }
  journal: {
    boneking: {
      taken: "Капитан Восс хочет, чтобы Костяной Король был уничтожен. Король восседает на троне из рёбер, четырьмя этажами ниже, в Склепе Павших — к востоку от ворот, по ту сторону Пепельных Полей. Отец Восса спустился за ним с топором и не вернулся."
      done: "Костяной Король обратился в прах, и склепы затихли. Восс захочет услышать это от вас."
      rewarded: "Восс заплатил золотом и отдал вам вещь, принадлежавшую его отцу. Колокола склепа снова могут звонить."
    }
    oracle: {
      taken: "Восс хочет, чтобы вы упокоили Утопшую Провидицу. Она ушла в воду под Чёрной Топью, к северу от полей, и зовёт заблудших за собой. Идите за холодными огнями вниз, в Затонувший Грот."
      done: "Песнь Провидицы смолкла. А глубже что-то горит. Воссу следует об этом узнать."
      rewarded: "Восс заплатил и предостерёг вас: под её озером горит камень, а у Пылающей Бездны нет дна."
    }
    wanderer: {
      taken: "Когда пала Провидица, из Бездны что-то поднялось. Рядом с ним гаснет любой свет, и оно похоже на вас: это чужак, которого Эмберхолд нанял до вас. Остановите Последнего Странника, пока он не дошёл до кузни."
      done: "Последний Странник пал. Тьма отпустила огонь, и фонари Эмберхолда снова горят."
    }
  }
