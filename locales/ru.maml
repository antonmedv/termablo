  ref: {
    the: "{name}"
    a: "{name}"
    death_flames: { text: "предсмертное пламя ({name})", gender: "n" }
  }
  talk: {
    hadrik: {
      greet: "Хадрик: «Сталь против тьмы. Гляди.»"
      after_oracle: "Хадрик: «Последний, кого я снаряжал в глубину, так и не пришёл чинить доспех.»"
    }
    voss: {
      intro: "Странник. Хорошо. Нам нужен клинок, который не дрогнет.\nУголь держит тьму снаружи. Тьма хочет его назад.\nК востоку от ворот, по ту сторону Пепельных Полей, лежит Склеп Павших.\nЧетырьмя этажами ниже Костяной Король восседает на троне из рёбер. Уничтожьте его.\nА на севере, в Чёрной Топи, Утопшая Провидица зовёт заблудших в воду.\nКупите зелья у Мирелы. Держите при себе свиток портала. Возвращайтесь живым."
      boneking_reward: "Костяной Король обратился в прах? Значит, колокола склепа снова могут звонить.\nВозьмите — это принадлежало моему отцу. И золото, разумеется."
      oracle_reward: "Провидица умолкла... Не думал, что когда-нибудь усну, не слыша её.\nПод её озером горит камень. Говорят, у Бездны нет дна. Будьте осторожны.\nОднажды я уже посылал туда человека. Я перестал считать дни."
      after_boneking: "В склепе тихо. Теперь — Чёрная Топь, к северу от полей.\nИдите за холодными огнями вниз, в грот. Покончите с Провидицей."
      after_oracle: "Вы сделали больше, чем любой из нас осмелился.\nЕсли нужно идти глубже... Бездна ждёт под озером Провидицы."
      after_wanderer: "Фонари снова горят. Кем бы он ни был, когда-то он был одним из нас.\nИдите дальше, чужак. За это мы вам и платим."
    }
  }
  rumor: {
    braziers: "Говорят, жаровни в склепе сами зажигаются в сумерках. Никто за ними не ходит."
    brother: "Мой брат ушёл в Чёрную Топь за огнями. Вернулся мокрым. Вернулся не таким."
    torch: "Держите факел повыше. Тьма там, внизу, не пустая — она голодная."
    forge: "Кузня Хадрика не гасла сорок лет. Он говорит: в тот день, когда она погаснет, мы бежим."
    glimmer: "Редкие вещи мерцают во тьме. Золотой свет — значит, что-то старое и с именем."
    crystal: "Кристалл старой Мирелы выкопали в гроте. Он поёт, когда Провидице снятся сны."
    scroll: "Свиток портала дешевле похорон."
    stranger: "До вас тут был один чужак. Купил тот же меч. Прошёл за топь и пошёл дальше."
    edran: "Король Эдран вынес Уголь наверх голыми руками. Это стоило ему лица."
    uncle: "Мой дядя ушёл в Культ Угля. Говорил, мы задолжали Тьме. Пошёл вниз платить."
    holding: "Мирела говорит, Провидица ни на кого не охотится. Она что-то держит там, внизу."
  }
