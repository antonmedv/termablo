    pack_too_full: "لا متسع في حقيبتك لهذا التبديل."
    nothing_to_pick_up: "لا شيء هنا لالتقاطه."
    notice_item: "تلاحظ شيئا على الأرض."
    explored: "لم يبق هنا ما يستكشف."
    spot: "تلمح {who}."
