    out_of_range: "{who} خارج مرماك."
    no_target: "لا هدف على مرأى منك."
    no_mana: "المانا لا تكفي."
    level_up: "بلغت المستوى {n}! (c لتوزيع 5 نقاط سمات)"
    open_chest: "تفتح الصندوق."
    altar_cold: "برد المذبح الآن."
    altar_restore: "يغمرك نور الدم. استعدت عافيتك."
    altar_xp: "معرفة محرمة تغمر عقلك. (+{n} خبرة)"
    altar_gift: "يقدم المذبح هدية."
    slain: {
        m: "قتلك {who}."
        f: "قتلتك {who}."
      }
    no_healing_potions: "ليس معك جرعات شفاء."
    full_life: "حياتك ممتلئة أصلا."
    drink_healing: "تشرب جرعة شفاء."
    no_mana_potions: "ليس معك جرعات مانا."
    full_mana: "المانا ممتلئة أصلا."
    drink_mana: "تشرب جرعة مانا."
    already_in_town: "أنت في البلدة أصلا."
    no_scrolls: "ليس معك لفافات بوابة البلدة."
    boneking_raises: "ملك العظام يبعث الموتى!"
    boneking_greets: "ملك العظام: «شعلة أخرى تطفأ. اركع، وانضم إلى بلاطي.»"
    boneking_dead: "سكنت السراديب. عد إلى القائد فوس."
    oracle_reforms: "تذوب العرافة في الضباب ثم تتشكل من جديد."
    oracle_lights: "تتجمع أضواء باردة حول العرافة."
    oracle_greets: "العرافة الغريقة: «رأيت نهايتك أيها اللهب الصغير. إنها رطبة وباردة.»"
    oracle_dead: "انتهت أغنية العرافة. وفي الأعماق، شيء ما يحترق... عد إلى فوس."
    wanderer_greets: "الجوال الأخير: «غريب آخر. دائما يرسلون غريبا.»"
    wanderer_portal: "يخرج الجوال الأخير من البوابة. تنهار خلفه."
    wanderer_follows: "الجوال الأخير يتبعك."
    wanderer_home: "الجوال الأخير: «أريتني طريق العودة إلى الديار.»"
    wanderer_cuts: "يجرح الجوال الأخير {who}."
    wanderer_kills: "يصرع الجوال الأخير {who}."
    wanderer_taunt: "الجوال الأخير: «أعطوني أنا أيضا سيفا وخطبة قائد.»"
    town_empty: "لم يبق في إمبرهولد أحد سواك."
    forge_cold: "يبرد كور هادريك."
    wanderer_last_words: "الجوال الأخير: «واصل المسير.»"
    wanderer_dead: "ينطفئ الضوء الأحمر، ويفلت الظلام النار."
    unseal_here: "حيث كان ينتظر، ينفتح طريق إلى الأسفل."
    unseal_far: "بعيدا في الأسفل، في الموقد، ينفتح طريق إلى الأعماق."
    running: {
        m: "يفر {who} طلبا للنجاة."
        f: "تفر {who} طلبا للنجاة."
      }
    voss_reward: {
        zero: "يكافئك فوس ب{n} قطعة ذهبية وب{item}."
        one: "يكافئك فوس بقطعة ذهبية واحدة وب{item}."
        two: "يكافئك فوس بقطعتين ذهبيتين وب{item}."
        few: "يكافئك فوس ب{n} قطع ذهبية وب{item}."
        many: "يكافئك فوس ب{n} قطعة ذهبية وب{item}."
        other: "يكافئك فوس ب{n} قطعة ذهبية وب{item}."
      }
    cannot_afford: "لا تملك ثمن ذلك."
    belt_full: "حزامك ممتلئ."
    gamble: "يكشف هادريك عن {item}. {n}g، ولا استرداد."
    reroll: "يجلب هادريك بضاعة جديدة مقابل {n}g."
    bought: "دفعت {n}g ثمنا ل{item}."
    sold: "قبضت {n}g ثمنا ل{item}."
    equip: "تتجهز ب{item}."
    unequip: "تنزع {item}."
    drop: "تلقي ب{item} أرضا."
    mirela_healthy: "تتفحصك ميريلا. «سليم كالثور. اشتر شيئا يا عزيزي.»"
    mirela_free: "تضمد ميريلا جراحك. «لا أجر على الشباب. والآن اشتر شيئا يا عزيزي.»"
    mirela_broke: "تهز ميريلا رأسها. «الأعشاب تكلف مالا يا عزيزي.»"
    mirela_partial: "تفعل ميريلا ما يسمح به ذهبك ({n}g). «عد بالمزيد يا عزيزي.»"
    mirela_paid: "تضمد ميريلا جراحك مقابل {n}g. «ها قد انتهينا. والآن اشتر شيئا يا عزيزي.»"
  }
  ref: {
    the: "{name}"
    a: "{name}"
    death_flames: { text: "لهيب احتضار {name}", gender: "m" }
  }
  talk: {
    hadrik: {
      greet: "فولاذ لمواجهة الظلام. ألق نظرة. [الكور](forge) حام، كما هو دائما."
      greet_again: "عدت. ما الذي يحتاج إصلاحا؟"
      greet_boneking: "سمعت أجراس السرداب هذا الصباح. ظننت أني بدأت أخرف. أهذا من صنعك؟ إذن استحققت الفولاذ الجيد."
      greet_oracle: "آخر [غريب](stranger) سلحته للأعماق لم يعد قط ليصلح عدته."
      greet_wanderer: "توهج الكور بياضا حين سقط، ثم هدأ. أربعون عاما ولم أره يفعل ذلك قط. مرحبا بك عند سنداني."
      forge: "أربعون عاما وأنا أرعاه. الحراسة تنتقل من يد إلى يد، من حداد إلى حداد. ما يتقد في جوفه هو [الجمرة](ember) نفسها. يوم يخمد، نهرب. وليس هذا مثلا."
      ember: "يظن الناس أنها في الساحة على قاعدة. إنها تعيش في كوري. كل فانوس في البلدة يوقد من هنا. لا أتكلم عن هذا، ولن تتكلم أنت أيضا."
      ember_again: "قلت لك إني لا أتكلم عن هذا."
      stranger: "اشترى السيف نفسه الذي اشتريته. دفع بعملة قديمة، ولم يساوم. تجاوز المستنقع ومضى. ما زال مسنه عندي. سيريد استعادته."
      stranger_after: "إذن عاد إلى الديار في النهاية. سألقي مسنه في النار الليلة."
      cult: "جاؤوني أولا، [طائفة الجمرة](cult). أرادوا أن أدع النار تخمد ونبرأ من الدين. أريتهم طريق الباب والمطرقة في يدي."
      portals: "رماد الكور، مطوي في ورق. كل شرارة تعرف طريق العودة إلى الموقد، والرماد كذلك. أنا أكنسه، وميريلا تطويه."
    }
    mirela: {
      greet: "اجلس، اجلس. تفوح منك رائحة الدخان وتراب القبور. لنر ما الذي انكسر."
      greet_again: "عدت ثانية يا عزيزي؟ دعني أنظر إليك."
      greet_boneking: "أيقظتني أجراس السرداب هذا الصباح. بكيت يا عزيزي، ولا أدري لماذا. اجلس؛ إنك تنزف على أرضي."
      greet_oracle: "ما أشد هذا السكون يا بني. لم تصدر بلورتي صوتا منذ صعدت. وما زلت أرفعها إلى أذني."
      greet_wanderer: "عدت. أما هو فلم يعد قط؛ لم تكن تلك عودة حقيقية. اجلس يا عزيزي، ودعني أداوي هذه الحروق."
      oracle: "بلورتي خرجت من كهفها. حين تحلم، تغني البلورة. إنها لا تطارد أحدا يا بني. إنها تكبح شيئا تحت الماء. لا أعرف ما هو. أعرف أنه حار."
      oracle_after: "كفت بلورتي عن الغناء. البلدة كلها تنام هانئة الآن. أما أنا فلا. ما كانت تكبحه يصعد عبر [الهاوية](abyss)."
      blackmarsh: "الأضواء الباردة فوق الماء أضواؤها. لا تتبعها. الجميع يتبعونها. والحجارة القائمة نصبتها بنفسها، في طريقها إلى الأسفل."
      abyss: "تحت بركتها يحترق الصخر. من هناك اقتطعت الجمرة، إن صدقت الأغاني القديمة. وقد بدأت أصدقها."
      ember: "النور الدافئ صعد من الأسفل. ونوري أنا، النور البارد، جاء منها. البلدة تعيش بين الاثنين، وتظن أنها تعيش بواحد."
      portals: "رماد الكور في ورق؛ هادريك يكنسه، وأنا أطويه. اقرأ واحدة فتجذبك [الجمرة](ember) إلى النافورة. أرخص من جنازة."
    }
    voss: {
      greet: "أيها الجوال. حسنا. نحتاج نصلا لا يرتجف.\n[الجمرة](ember) تبقي الظلام خارجا. والظلام يريد استعادتها.\nشرق البوابة، وراء حقول الرماد، يقع [سرداب الساقطين](crypt).\nعلى عمق أربعة طوابق، يجلس [ملك العظام](boneking) على عرشه من الأضلاع. اقض عليه.\nوفي الشمال، في [المستنقع الأسود](blackmarsh)، تدعو [العرافة الغريقة](oracle) التائهين إلى الماء.\nاشتر الجرعات من ميريلا. احتفظ [بلفافة بوابة](portals). وعد حيا."
      greet_again: "ما زلت تتنفس. حسنا. [ملك العظام](boneking) على عمق أربعة طوابق تحت [السرداب](crypt). أحضر لي ترابه."
      boneking_reward: "صار ملك العظام ترابا؟ إذن قد تقرع أجراس السرداب من جديد.\nخذ هذا — كان [لأبي](father). والذهب طبعا."
      oracle_reward: "العرافة صمتت... ما ظننت أني سأنام يوما دون أن أسمعها.\nتحت بركتها، الصخر يحترق. يقولون إن [الهاوية](abyss) بلا قرار. كن حذرا.\nأرسلت [أحدهم](stranger) إلى هناك ذات مرة. ثم كففت عن عد الأيام."
      greet_boneking: "السرداب هادئ. والآن: [المستنقع الأسود](blackmarsh)، شمال الحقول.\nاتبع الأضواء الباردة نزولا إلى الكهف. واقض على [العرافة](oracle)."
      greet_boneking_again: "[المستنقع الأسود](blackmarsh)، شمال الحقول. اتبع الأضواء الباردة نزولا. ولا تدعها تتبعك في العودة."
      greet_oracle: "فعلت أكثر مما جرؤ عليه أي منا.\nإن كان لا بد أن تنزل أعمق... [الهاوية](abyss) تنتظرك تحت بركة العرافة."
      greet_oracle_again: "ما ينتظر في [الهاوية](abyss) أبعد من خرائطي. امض بحذر، أو لا تمض."
      greet_wanderer: "أضيئت الفوانيس من جديد. أيا كان، فقد كان منا يوما.\nواصل المسير أيها الغريب. لهذا نستأجرك."
      greet_wanderer_again: "ينام الحرس بالتناوب من جديد. ذلك من صنعك. لا تجعل منه خطبة."
      crypt: "السرداب الملكي، شرقا وراء حقول الرماد. أربعة طوابق، باردة ومغبرة. المجامر تشتعل وحدها. لا تقف قربها."
      boneking: "أربعة طوابق تحت المصلى، على عرش من الأضلاع. نزل [أبي](father) في إثره بفأس. أحضر لي ترابه."
      boneking_after: "تراب، تقول. حسنا. سأصدق حين أسمع الأجراس."
      father: "أخذ حتف الملوك إلى [السرداب](crypt) ولم يعد. اختارني الحرس في الصباح التالي. لم يبق غيري ليختاروه."
      father_again: "قلت لك كل ما هناك. دع الأمر."
      father_after: "أعدت ما كان له. هذا أكثر مما قدر عليه سائرنا. لا تسألني أكثر."
      oracle: "أغرقت نفسها في الكهف تحت [المستنقع الأسود](blackmarsh)، والآن تدعو التائهين إلى الأسفل في إثرها. ضع لذلك حدا."
      oracle_after: "صمتت. صرت أنام الآن. غريب كم يمكن للسكون أن يكون صاخبا."
      stranger: "كان هناك واحد قبلك. ماهر بالنصل. أرسلته إلى ما وراء بركة العرافة. ليس من عادتي أن أستأجر مرتين للعمل نفسه."
      stranger_after: "أيا كان، فقد كان منا يوما. دع الأمر عند هذا الحد."
      cult: "خونة. قبل جيل نزلوا ليعيدوا النار. بعضهم ما زال هناك في الأسفل، يواصل العطاء."
    }
    any: {
      ember: "حمل الملك [إدران](edran) الجمرة من الأسفل بيديه العاريتين. كل فانوس في إمبرهولد يوقد من [كور](forge) هادريك، والكور من الجمرة. الظلام يتوقف عند البوابة."
      edran: "الملك الأول. نزل وحده وصعد بالنار. أخذ الظلام وجهه ثمنا لذلك، ثم جمجمته. أقام [مذابح](altars) في طريق صعوده؛ بعضها ما زال قائما."
      altars: "ترك إدران قطرة من دمه على كل واحد منها، ليشتري ساعة أخرى من العبور الآمن. انزف على واحد منها بنفسك فتؤتي الصفقة ثمرها. مرة واحدة."
      forge: "كور هادريك لم يخمد منذ أربعين عاما. كل فانوس في البلدة يوقد منه."
      portals: "اقرأ لفافة بوابة فتجد نفسك في ساحة النافورة. كل شرارة من الجمرة تعرف طريق العودة إلى الديار."
      crypt: "السرداب الملكي، شرق البوابة وراء حقول الرماد. يرقد فيه الملك [إدران](edran) مع بلاطه. و«يرقد» كلمة كريمة."
      boneking: "يجلس على عرشه من الأضلاع على عمق أربعة طوابق، تحت تاج أجوف. يقولون إنه لم يفرغ بعد من كونه ملكا."
      boneking_after: "صار ملك العظام ترابا، كما يقولون. قد تقرع أجراس السرداب من جديد."
      father: "أخذ والد القائد فأسا قديمة إلى السرداب. القائد لا يتكلم عن ذلك. ولا ينبغي أن تتكلم أنت."
      blackmarsh: "شمال الحقول. أضواء باردة تطفو فوق الماء. لا تتبعها. الجميع يتبعونها."
      oracle: "العرافة، عرافة الملك نفسه. قالت له ألا يأخذ الجمرة. وحين أبى أن يسمع، مشت إلى الماء تحت [المستنقع الأسود](blackmarsh) ولم تخرج قط."
      oracle_after: "انطفأت أضواء المستنقع. يقول الناس إن الأمر انتهى. ميريلا لا تقول شيئا."
      abyss: "تحت بركة العرافة يحترق الصخر. يقولون إن الهاوية بلا قرار. ومن هناك مضت [طائفة الجمرة](cult)."
      cult: "قبل جيل قرر بعض الناس أن للظلام حقا في جمرته. نزلوا ليسددوه. أعادت النار صنعهم. بعضهم ما زال يلبس وجوهنا."
      stranger: "كان هناك غريب قبلك. اشترى السيف نفسه. تجاوز المستنقع ومضى."
      stranger_after: "أضيئت الفوانيس من جديد. لا أحد ينطق باسمه. لم يعرفه أحد."
    }
  }
  topic: {
    rumors: "آخر الشائعات"
    ember: "الجمرة"
    edran: "الملك إدران"
    altars: "المذابح"
    forge: "الكور"
    portals: "لفافات البوابة"
    crypt: "السرداب"
    boneking: "ملك العظام"
    father: "والد فوس"
    blackmarsh: "المستنقع الأسود"
    oracle: "العرافة الغريقة"
    abyss: "الهاوية المشتعلة"
    cult: "طائفة الجمرة"
    stranger: "الغريب"
  }
  rumor: {
    braziers: "يقولون إن مجامر [السرداب](crypt) تشتعل وحدها عند الغسق. لا أحد يرعاها."
    brother: "ذهب أخي إلى [المستنقع الأسود](blackmarsh) في إثر الأضواء. عاد مبتلا. عاد على غير حاله."
    torch: "ارفع مشعلك عاليا. الظلام هناك ليس فارغا — إنه جائع."
    forge: "[كور هادريك](forge) لم يخمد منذ أربعين عاما. يقول إن اليوم الذي يخمد فيه، نهرب."
    glimmer: "الأشياء النادرة تلمع في الظلام. وضوء الذهب يعني شيئا قديما له اسم."
    crystal: "بلورة ميريلا العجوز استخرجت من الكهف. إنها تغني حين تحلم [العرافة](oracle)."
    scroll: "[لفافة البوابة](portals) أرخص من جنازة."
    stranger: "كان هناك [غريب](stranger) قبلك. اشترى السيف نفسه. تجاوز المستنقع ومضى."
    edran: "حمل [الملك إدران](edran) [الجمرة](ember) إلى الأعلى بيديه العاريتين. كلفه ذلك وجهه."
