  ref: {
    the: "{name}"
    a: "{name}"
    death_flames: "{name}的死亡烈焰"
  }
  talk: {
    hadrik: {
      greet: "哈德里克：“对付黑暗的钢铁。看看吧。”"
      after_oracle: "哈德里克：“上一个我武装去深处的人，再没回来修过装备。”"
    }
    voss: {
      intro: "流浪者。很好。我们需要一把不会发抖的剑。\n余烬把黑暗挡在外面。黑暗想把它夺回去。\n出了东门，越过灰烬原野，便是堕落者墓穴。\n往下四层，骸骨之王坐在他的肋骨王座上。消灭他。\n往北，在黑沼，溺亡先知把迷途之人唤入水中。\n去米蕾拉那里买药剂。随身带一张传送门卷轴。活着回来。"
      boneking_reward: "骸骨之王化为尘土了？那么墓穴的钟又可以敲响了。\n拿着这个——这是我父亲的。当然，还有金币。"
      oracle_reward: "先知沉默了……我从没想过，有一天能不听着她的声音入睡。\n她的水池之下，岩石在燃烧。人们说，深渊没有底。小心。\n我曾派过一个人下去。后来我不再数日子了。"
      after_boneking: "墓穴安静了。下一步：黑沼，在原野以北。\n跟着冷光下到洞窟里。了结先知。"
      after_oracle: "你做到的，比我们任何人敢做的都多。\n如果你非要再往深处去……深渊就在先知的水池之下等着。"
      after_wanderer: "灯火又点亮了。不管他是谁，他也曾是我们的人。\n继续走吧，外乡人。我们雇你，就是为了这个。"
    }
  }
  rumor: {
    braziers: "听说墓穴里的火盆每到黄昏就会自己点燃。没人照看它们。"
    brother: "我哥哥追着那些光进了黑沼。他回来时浑身湿透。回来的已经不是他了。"
    torch: "把火把举高。下面的黑暗不是空的——它饿着呢。"
    forge: "哈德里克的熔炉四十年没熄过。他说哪天熄了，我们就得逃。"
    glimmer: "稀有之物在黑暗中闪烁。金色的光意味着古老而有名之物。"
    crystal: "老米蕾拉的水晶是从洞窟里挖出来的。先知做梦时，它会歌唱。"
    scroll: "一张传送门卷轴，总比一场葬礼便宜。"
    stranger: "你之前还来过一个外乡人。买了同一把剑。穿过沼泽，就再没停下。"
    edran: "埃德兰王赤手把余烬捧了上来。代价是他的脸。"
    uncle: "我叔叔加入了余烬教团。说是欠了黑暗的债。他下去还债了。"
    holding: "米蕾拉说，先知并不是在猎杀谁。她是在镇压着什么。"
  }
