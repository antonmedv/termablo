# Termablo in Chinese (Simplified). Translated from en.maml; see docs/translating.md.
# Plural forms: other. 
{
  msg: {
    welcome_help: "按 ? 查看帮助。酒馆旁的沃斯队长有活交给你。"
    enter: "你进入了{area}。"
    far_beyond: "此处有你远远无法匹敌之物。"
    fountain: "冰冷的泉水抚平了你的伤口。"
    portal_step: "你踏入传送门。"
    portal_collapse: "传送门在你身后崩塌。"
    portal_open: "一道闪烁的蓝色传送门撕裂开来。"
    see_item: "你看到这里有{item}。（按 g 拾取）"
    see_items: "这里散落着几件物品。（按 g 拾取）"
    pickup_gold: "你拾起{n}枚金币。"
    pickup_potion: "你拾起一瓶{item}。"
    belt_no_room: "你的腰带放不下更多{item}了。"
    pickup_scroll: "你拾起一张{item}。"
    pickup_item: "你拾起{item}。"
    pack_full: "你的背包满了。"
    pack_too_full: "背包太满，无法交换。"
    nothing_to_pick_up: "这里没有可拾取的东西。"
    notice_item: "你注意到地上有东西。"
    explored: "此处已无可探索之地。"
    spot: "你发现了{who}。"
    boss_destroyed: "{who}已被摧毁！"
    elite_slain: "{who}被斩杀！"
    monster_dies: "{who}死了。"
    out_of_range: "{who}超出射程。"
    no_target: "视野内没有目标。"
    no_mana: "法力不足。"
    level_up: "你升到了{n}级！（按 c 分配5点属性点）"
    open_chest: "你打开了箱子。"
    altar_cold: "祭坛已经冷却。"
    altar_restore: "血光笼罩了你。你恢复如初。"
    altar_xp: "禁忌的知识涌入你的脑海。（+{n} 经验）"
    altar_gift: "祭坛献出了一件礼物。"
    slain: "你被{who}杀死了。"
    no_healing_potions: "你没有治疗药剂了。"
    full_life: "你的生命已满。"
    drink_healing: "你喝下一瓶治疗药剂。"
    no_mana_potions: "你没有法力药剂了。"
    full_mana: "你的法力已满。"
    drink_mana: "你喝下一瓶法力药剂。"
    already_in_town: "你已经在城里了。"
    no_scrolls: "你没有回城卷轴了。"
    boneking_raises: "骸骨之王唤起了亡者！"
    boneking_greets: "骸骨之王：“又一支待熄的火把。跪下，加入我的王庭。”"
    boneking_dead: "墓穴归于沉寂。回去找沃斯队长。"
    oracle_reforms: "先知化作雾气，又重新凝聚。"
    oracle_lights: "冷光聚拢在先知周围。"
    oracle_greets: "溺亡先知：“我已见过你的结局，小小的火苗。它潮湿而冰冷。”"
    oracle_dead: "先知的歌声止息了。更深处，有什么在燃烧……回去找沃斯。"
    wanderer_greets: "最后的流浪者：“又一个外乡人。他们总是派外乡人来。”"
    wanderer_portal: "最后的流浪者走出传送门。传送门在他身后崩塌。"
    wanderer_follows: "最后的流浪者跟上了你。"
    wanderer_home: "最后的流浪者：“是你给我指了回家的路。”"
    wanderer_cuts: "最后的流浪者砍伤了{who}。"
    wanderer_kills: "最后的流浪者砍倒了{who}。"
    wanderer_taunt: "最后的流浪者：“当年他们也给了我一把剑，还有队长的一番训话。”"
    town_empty: "余烬堡里，除了你，再无一人。"
    forge_cold: "哈德里克的熔炉冷了。"
    wanderer_last_words: "最后的流浪者：“继续走吧。”"
    wanderer_dead: "红光熄灭，黑暗松开了那团火。"
    unseal_here: "他等候之处，一条向下的路打开了。"
    unseal_far: "在遥远的下方，炉心之中，一条向下的路打开了。"
    running: "{who}正在逃命。"
    quest_reward: "{who}给了你{n}金币和{item}。"
    quest_new: "新任务：{name}。"
    topic_new: "你可以去城里打听：{topic}。"
    cannot_afford: "你买不起。"
    belt_full: "你的腰带满了。"
    gamble: "哈德里克拆开了{item}。{n}g，概不退换。"
    reroll: "你付了{n}g，哈德里克搬出一批新货。"
    bought: "以{n}g购得{item}。"
    sold: "以{n}g售出{item}。"
    equip: "你装备了{item}。"
    unequip: "你卸下了{item}。"
    drop: "你丢下了{item}。"
    mirela_healthy: "米蕾拉打量了你一番。“壮得像头牛。买点东西吧，亲爱的。”"
    mirela_free: "米蕾拉为你包扎伤口。“年轻人不收钱。好了，买点东西吧，亲爱的。”"
    mirela_broke: "米蕾拉摇了摇头。“草药可是要花钱的，亲爱的。”"
    mirela_partial: "米蕾拉用你的{n}g尽力医治。“多带些钱再来，亲爱的。”"
    mirela_paid: "米蕾拉收了{n}g，为你包扎伤口。“好了。现在买点东西吧，亲爱的。”"
  }
  ref: {
    the: "{name}"
    a: "{name}"
    death_flames: "{name}的死亡烈焰"
  }
  talk: {
    hadrik: {
      desc: "一个魁梧的秃头汉子，系着烧焦的皮围裙，两条胳膊黑到手肘。小臂上布满细小的白色烫疤，他呼吸又慢又深，像一只风箱。"
      desc_again: "哈德里克，黑灰沾到手肘，手里握着锤子。他没抬头。"
      desc_wanderer: "哈德里克脸上映着白金色的光，他头一回显得睡足了。他看着你，而不是火。"
      desc_wanderer_again: "哈德里克一边干活一边哼着曲子。他显得睡足了。"
      greet: "对付黑暗的钢铁。看看吧。[熔炉](forge)是热的，一直都是。"
      greet_again: "回来了。什么要修？"
      greet_boneking: "今早听见墓穴的钟响了。还当是自己老糊涂了。是你干的？那你配得上好钢。"
      greet_oracle: "上一个我武装去深处的[外乡人](stranger)，再没回来修过装备。"
      greet_wanderer: "他倒下那会儿，熔炉腾起一阵白焰，又落了回去。四十年了，从没见炉子这样过。这块铁砧前，总有你的位置。"
      greet_hurt: "你的血滴到我铁砧上了。先去找米蕾拉。钢铁的事，之后再说。"
      greet_broke: "看不要钱。别的都要。"
      greet_kingsbane: "弑王者。这把斧头最后一道刃是我开的，给队长的[父亲](father)。拿给沃斯看看。不看也行。"
      greet_kingsbane_again: "刃口记得上油。它配得上。"
      greet_crown: "在我的熔炉边，把那顶王冠摘了。炉火见了它不安。"
      greet_crown_again: "王冠。摘了。"
      forge: "这座炉子我守了四十年。守炉的差事一手传一手，铁匠传铁匠。炉膛里烧的，就是[余烬](ember)本身。哪天炉子熄了，我们就逃。这不是说说而已。"
      ember: "人们以为它供在广场的石台上。它在我的熔炉里。城里每盏灯都是从这儿点的。这事我不提，你也别提。"
      ember_again: "我说过，这事我不提。"
      stranger: "跟你买的是同一把剑。付的是旧币，没还价。过了沼泽，一直往前走。他的磨刀石还在我这儿。他会回来要的。"
      stranger_after: "这么说，他终究还是回家了。今晚我就把他的磨刀石扔进火里。"
      cult: "他们头一个找的就是我，那帮[余烬教团](cult)的人。要我把火熄了，从此两清。我手里拎着锤子，把他们请出了门。"
      portals: "熔炉的灰，用纸包好。每颗火星都认得回炉心的路，灰也一样。我扫，米蕾拉包。"
      aldous: "奥尔德斯以前是他们的人。如今他守着坟地，逢人路过就说[余烬](ember)是一道伤口。也许是吧。伤口总比坟强。别跟他说我讲了“也许”。"
      pell: "泉水边那孩子。来过熔炉一回，想暖暖身子。在火边站了一个时辰，一点没暖过来。"
    }
    mirela: {
      desc: "一个三十八九岁的美丽女人，丰腴的身段束在一件深色紧身胸衣里，头发盘得一丝不乱。一块苍白的水晶挂在她喉前，轻声哼鸣。她打量你的样子，像女教师打量一本撕破的作业簿。"
      desc_again: "米蕾拉在喉前的水晶下抱起双臂，等你给个交代。"
      desc_oracle: "米蕾拉用手指把喉前的水晶翻来覆去地转着。它一声不响，灰得像河里的石头。她的背头一回没挺得那么直。"
      desc_oracle_again: "米蕾拉喉前的水晶灰暗无声。她不去碰它。"
      greet: "坐，快坐。你一身烟味和坟土味。让我看看哪儿伤着了。"
      greet_again: "又回来了，亲爱的？让我看看你。"
      greet_boneking: "今早墓穴的钟声把我吵醒了。我哭了，亲爱的，也不知道为什么。\n沃斯下一个就要派你去找[她](oracle)。走之前，问问我她的事吧。求你了。"
      greet_oracle: "好安静啊，孩子。自打你上来，我的水晶就再没出过一点声音。\n我不怪你，亲爱的。你拿了钱，做了该做的事。可你把手按在地上试试。是热的。"
      greet_wanderer: "你回来了。他却没有，至少不是真的回来。坐下，亲爱的，让我看看这些烧伤。"
      greet_hurt: "哎呀，孩子，看看你这样子。快坐下，别倒下了。"
      greet_nopots: "腰带上一瓶药都没有？还要下去？坐吧，亲爱的。我们来补上。"
      greet_crown: "在我桌边把那顶王冠摘了吧，亲爱的。它会低语，我可不听一件首饰来教训我。"
      greet_crown_again: "王冠，亲爱的。摘了。"
      oracle: "我的水晶是从她的洞窟里来的。她做梦时，它就歌唱。她没在猎杀谁，孩子。她是在水底下镇压着什么。我不知道是什么。我只知道它是热的。\n沃斯管这叫了结她。我管这叫打开一扇门。非去不可就去吧，可举刀之前，先听一听。"
      oracle_again: "我的水晶告诉我的，我都告诉你了。沃斯有一把剑，我有一块会唱歌的石头。信哪个，你自己选。"
      oracle_after: "我的水晶不唱了。如今全城都睡得安稳。我睡不着。她镇压的东西，正从[深渊](abyss)里涌上来。"
      blackmarsh: "那些立石是她的。她走进水里的路上亲手立起来的，就像埃德兰立起他的祭坛。那些光不是在猎人，亲爱的。它们是在问。[佩尔](pell)答应了。"
      abyss: "她的水池之下，岩石在燃烧。老歌里说，那块炭就是从那儿凿下来的。我开始信了。"
      ember: "暖光是从下面上来的。我用的这种，冷光，是从她那儿来的。这座城活在两种光之间，却以为自己只靠一种活着。"
      pell: "可怜的小羊羔。水渗进他身子里去了。他能听见她，就像我的水晶一样，只是他没法在夜里把她搁到架子上。"
      pell_oracle: "自打我的水晶没了声音，他就一个字也没说过。每天傍晚我陪他坐坐。他好像不嫌弃。"
      pell_oracle_again: "还是一个字也不说。我给他端汤去。他不喝，可他捧着碗。"
      pell_wanderer: "他今早开口了，亲爱的！他要面包。就要面包。我又哭了。"
      pell_wanderer_again: "他身子还是冷的，可他肯吃东西了。这就是个开头。"
    }
    voss: {
      desc: "一个精瘦的男人，胸甲上满是凹痕，一只袖子上系着黑布条。他站着的样子，像是好多年没坐下过。"
      desc_again: "沃斯，一手按着剑，袖子上系着黑布条。"
      desc_boneking: "沃斯站得松快了些。他袖子上的黑布条不见了。"
      desc_boneking_again: "沃斯，一手按着剑。袖子上空空的。"
      greet: "流浪者。很好。我们需要一把不会发抖的剑。\n出了东门，越过原野，[墓穴](crypt)往下四层，[骸骨之王](boneking)坐在他的肋骨王座上。消灭他。\n随身带一张[传送门卷轴](portals)。活着回来。"
      greet_again: "还活着。很好。[骸骨之王](boneking)就在[墓穴](crypt)往下四层。把他的骨灰带给我。"
      boneking_reward: "骸骨之王化为尘土了？那么墓穴的钟又可以敲响了。\n拿着这个——这是[我父亲的](father)。当然，还有金币。"
      oracle_reward: "先知沉默了……我从没想过，有一天能不听着她的声音入睡。\n她的水池之下，岩石在燃烧。人们说，[深渊](abyss)没有底。小心。\n我曾派过[一个人](stranger)下去。后来我不再数日子了。"
      greet_boneking: "墓穴安静了。下一步：[黑沼](blackmarsh)，在原野以北。\n跟着冷光下到洞窟里。了结[先知](oracle)。"
      greet_boneking_again: "[黑沼](blackmarsh)，在原野以北。跟着冷光下去。别让它们跟着你回来。"
      greet_oracle: "你做到的，比我们任何人敢做的都多。\n米蕾拉说，如今风里有熔炉的味道。随她说去。如果你非要再往深处去，[深渊](abyss)就在先知的水池之下等着。"
      greet_oracle_again: "[深渊](abyss)里等着的东西，我的地图上没有。要去就小心，不然就别去。"
      greet_wanderer: "灯火又点亮了。不管他是谁，他也曾是我们的人。\n继续走吧，外乡人。我们雇你，就是为了这个。"
      greet_wanderer_again: "守夜的人又能轮班睡觉了。这是你的功劳。别拿这事说嘴。"
      greet_hurt: "你的血滴到我城门上了。先去找米蕾拉，再来见我。"
      greet_kingsbane: "那把斧头。弑王者。我[父亲](father)带着它下去的。你留着吧。他宁愿它挥舞，也不愿它生锈。"
      greet_kingsbane_again: "还带着它。很好。"
      greet_crown: "那是[骸骨之王的](boneking)王冠？别在广场上戴。人们都记得。"
      greet_crown_again: "王冠，外乡人。别在我的广场上。"
      crypt: "王家墓穴，往东，过了灰烬原野。四层，阴冷，满是尘土。火盆会自己点燃。别靠近。"
      boneking: "在礼拜堂下面四层，坐在肋骨王座上。我[父亲](father)拿着斧头下去找过他。把他的骨灰带给我。"
      boneking_after: "化为尘土，你说。很好。等我听见钟声，我才信。"
      father: "他带着弑王者进了[墓穴](crypt)，再没回来。第二天早上，卫队选了我。没有别人可选。"
      father_again: "该说的我都说了。别再问了。"
      father_after: "你把他的东西带回来了。我们其他人都没做到。别再问了。"
      oracle: "她在[黑沼](blackmarsh)下的洞窟里投水自尽，如今又把迷途之人唤下去陪她。做个了断。\n米蕾拉会跟你说她在镇压着什么。米蕾拉听的是一块石头。那块石头唱给谁听，我就埋谁。"
      oracle_after: "沉默了。我现在睡得着了。奇怪，寂静竟能这么响。"
      stranger: "在你之前，还有一个人。剑使得好。我派他越过先知的水池。按规矩，同一件差事我不雇两次。"
      stranger_after: "不管他是谁，他也曾是我们的人。就到此为止吧。"
      cult: "叛徒。上一代人里，他们下去要把火还回去。有些人至今还在下面，还没还完。"
      aldous: "教团剩下的人。我让他守着坟地，因为死人不听他的。你也别听。"
      pell: "那孩子追着沼泽上的光走了，回来就冷了。等她一死，他就会暖过来。我是这么跟他姐姐说的。"
      pell_oracle: "自打你上来，那孩子就一个字也没说过。给他点时间。寒气要过一阵才散。"
      pell_oracle_again: "给那孩子点时间。"
    }
    aldous: {
      desc: "一个枯瘦的男人，穿着教团的长袍。他半边身子烧得发亮，那一侧的眼睛白如牛乳。另半边脸冲你笑着。"
      desc_again: "奥尔德斯，烧伤的半边脸背着光。"
      desc_oracle: "奥尔德斯一只手掌平贴着地面，像在摸一颗心跳。"
      desc_oracle_again: "奥尔德斯一只手按在地上。他没抬手跟你打招呼。"
      greet: "又一把沃斯的刀。想坐就坐吧，坟里的人不嫌有伴。问问我[教团](cult)的事。镇上的人会告诉你我们是什么人。我告诉你我们看见了什么。"
      greet_again: "还喘着气。那火还没拿定主意怎么处置你。"
      greet_boneking: "这么说，埃德兰总算躺下了。你算是帮了他。他会谢你的，要是黑暗还给他留了张嘴。"
      greet_oracle: "把手按在地上。热的，对吧？她镇着的就是这个。你把塞子拔了，流浪者。现在就看会冒上来什么。"
      greet_oracle_again: "今天更热了。明天还会更热。"
      greet_wanderer: "他就是那火想让我们每个人变成的样子。你把他放倒了。它会再造一个。它有耐心。我也有。"
      greet_hurt: "在流血？去找米蕾拉。那火喜欢这股味儿。"
      greet_crown: "埃德兰的王冠。你已经听得见它了吗？你会听见的。"
      cult: "我们不是叛徒。我们是唯一肯听的人。[余烬](ember)从来不是我们的，所以我们下去把它还回去。那火见了我们很高兴。留下的人都被它重塑了。我跑了。我的异端，就这么多。"
      ember: "镇上说是埃德兰把它带上来的。他是把它剜出来的。黑暗并不饥饿，流浪者。它是一道想要愈合的伤口，而余烬堡就是那根刺。去问问哈德里克，他为什么从来不睡。"
      edran: "一个戴王冠的贼。他自己的[先知](oracle)求他把它放回去。他留下了它，黑暗就拿走他的脸作代价。"
      abyss: "你要去的地方，我去过。那里的岩石会流血。埃德兰就是在那儿剜下那块炭的，那伤口从没合上。不管它是从什么身上剜下来的，那东西就在下面，而且醒着。"
      abyss_after: "现在它敞开了。闻闻那些井。接下来冒上来的东西不会小，也不会蠢。"
      oracle: "我们之中，只有她付清了代价。她躺进水里，替我们挡住背后的火，一挡就是好几代人。沃斯想要她死。他当然想。他从来没往自己靴子底下看过一眼。"
      oracle_after: "她撑了好几代人。你一个下午就把它毁了。我不是在怪你。我跑过，记得吧。"
      stranger: "我上来的路上遇见过他，在水池下面。他问下面有多深。我跟他说了实话：一直到底。他谢了我。他在笑。"
      stranger_after: "原来那火就是这样对待一个一路走到它跟前的人。我还以为它只是在生我的气。"
      pell: "那孩子听得见她。我听得见另一个。我们俩加起来，凑成一夜噩梦。"
      aldous: "修士。早就没有修会可以让人当修士了。你想这么叫就叫吧，这名号是我唯一带回来的东西。"
    }
    pell: {
      desc: "一个九岁或十岁的瘦男孩。天没下雨，他的头发却是湿的，嘴唇微微发青，可他一点也不发抖。"
      desc_again: "佩尔，头发还是湿的。"
      desc_oracle: "佩尔抱着膝盖，目光越过你望向别处，好像有什么东西欠他一个回答。"
      desc_oracle_again: "佩尔抱着膝盖，目光越过你望向别处。"
      desc_wanderer: "佩尔裹着一条大得不合身的毯子，手里攥着一块面包皮。他在发抖。他的嘴唇红润了。"
      desc_wanderer_again: "佩尔裹着毯子，一边发抖，一边嚼着。"
      greet: "你是暖的。上面的人都是暖的。"
      greet_again: "水又在说话了。不是跟你说。"
      greet_boneking: "钟声。她在沼泽底下感觉到了。她累了。只有一个人撑着，很难。"
      greet_oracle: "（佩尔望着泉水，一言不发。水面静极了。）"
      greet_oracle_again: "（佩尔没有抬头。）"
      greet_wanderer: "我冷。我以前从来不冷。只剩我自己，就是这样吗？"
      greet_wanderer_again: "姐姐说我可以再去沼泽了。我不想去了。"
      oracle: "她冷着，我们才不会烧起来。她让我帮她拿一点。我答应了。现在我也冷了。"
      oracle_after: "（佩尔摇摇头。他不肯说她的事。）"
      blackmarsh: "那些光没有叫。它们是在问。大多数人都答应。我答应了。"
    }
    villager: {
      desc: "一个披着烟灰色斗篷的镇民，不时瞟一眼最近的灯笼。"
    }
    any: {
      ember: "[埃德兰](edran)王赤手把余烬从下面捧了上来。余烬堡的每盏灯都是从哈德里克的[熔炉](forge)点的，熔炉的火则来自余烬。黑暗止步于城门。"
      edran: "第一位国王。他独自下去，带着火上来。黑暗为此夺走了他的脸，后来又夺走了他的头骨。他在上来的路上立起了[祭坛](altars)，有些至今还在。"
      altars: "埃德兰在每座祭坛上都留了一滴血，换一个时辰的平安通行。你自己在上面滴血，这笔交易就会兑现。只有一次。"
      forge: "哈德里克的熔炉四十年没熄过。想挨白眼的话，就去问他。"
      portals: "念一张传送门卷轴，你就回到了泉水广场。炉灰是哈德里克扫来的，米蕾拉把它折进卷轴里。为什么管用，去问他。"
      crypt: "王家墓穴，出了东门，过了灰烬原野。[埃德兰](edran)王和他的王庭就安息在那里。说“安息”，是客气了。这事队长最清楚。"
      boneking: "他坐在地下四层的肋骨王座上，戴着一顶空心王冠。人们说，他的王还没当完。"
      boneking_after: "听说骸骨之王化为尘土了。墓穴的钟又可以敲响了。"
      father: "队长的父亲带着一把旧斧头进了墓穴。队长从不提这事。你也别提。"
      blackmarsh: "在原野以北。冷光在水面上飘荡。别跟着走。可人人都会跟着走。米蕾拉听得懂那片水，去问她。"
      oracle: "国王自己的先知。她劝他别拿那块炭。他不听，她便走进了[黑沼](blackmarsh)下的水里，再没上来。"
      oracle_after: "沼泽的光熄了。人们说一切都结束了。米蕾拉什么也没说。"
      abyss: "先知的水池之下，岩石在燃烧。人们说，深渊没有底。[余烬教团](cult)就是往那儿去的。"
      cult: "上一代，有些人认定欠了黑暗一块炭。他们下去还债。那火重塑了他们。回来了一个：[奥尔德斯修士](aldous)，就在坟地那边。别招他开口。"
      stranger: "去问哈德里克。他卖给那人一把剑，还留下了那人的一样东西。"
      aldous: "去年冬天从深渊回来的，半边身子都烧焦了。自称修士。整天坐在墓地里，跟石头说话。"
      pell: "泉水边那孩子。追着沼泽上的光走了，回来就冷了。天一黑，他姐姐就不肯提他的名字。"
      stranger_after: "灯又点亮了。没人提他的名字。也没人知道他叫什么。"
    }
  }
  journal: {
    boneking: {
      taken: "沃斯队长要你消灭骸骨之王。他坐在肋骨王座上，在堕落者墓穴往下四层，出了东门，越过灰烬原野。沃斯的父亲曾带着一把斧头下去找他，再没回来。"
      done: "骸骨之王已化为尘土，墓穴归于沉寂。沃斯会想亲耳听你说。"
      rewarded: "沃斯付了金币，还给了你一件他父亲的遗物。墓穴的钟或许又会敲响。"
    }
    oracle: {
      taken: "沃斯要你了结溺亡先知。她走进了原野以北、黑沼之下的水中，又把迷途之人唤下去追随她。跟着冷光，下到沉没洞窟。"
      done: "先知的歌声止息了。更深处，有什么在燃烧。该让沃斯知道。"
      rewarded: "沃斯付了酬劳，并警告你：她的水池之下，岩石在燃烧，而燃烧深渊没有底。"
    }
    wanderer: {
      taken: "先知倒下时，有什么东西从深渊里上来了。它所到之处，灯火尽灭，而它看起来像你：余烬堡在你之前雇来的那个外乡人。在最后的流浪者抵达熔炉之前，阻止他。"
      done: "最后的流浪者倒下了。黑暗松开了那团火，余烬堡的灯笼又燃了起来。"
    }
  }
  topic: {
    rumors: "最新传闻"
    ember: "余烬"
    edran: "埃德兰王"
    altars: "祭坛"
