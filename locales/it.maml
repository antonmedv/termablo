# Termablo in Italian. Translated from en.maml; see docs/translating.md.
# Plural forms: one, other. Genders: m, f, mp, fp, mv, fv.
{
  msg: {
    welcome_help: "Premi ? per l'aiuto. Il capitano Voss, vicino alla taverna, ha del lavoro per te."
    enter: "Entri in {area}."
    far_beyond: "Qualcosa, qui, è molto al di là delle tue forze."
    fountain: "L'acqua fredda chiude le tue ferite."
    portal_step: "Attraversi il portale."
    portal_collapse: "Il portale si chiude alle tue spalle."
    portal_open: "Si squarcia un portale blu e scintillante."
    see_item: "Qui vedi {item}. (g per raccogliere)"
    see_items: "Qui giacciono diversi oggetti. (g per raccogliere)"
    pickup_gold: {
        one: "Raccogli {n} moneta d'oro."
        other: "Raccogli {n} monete d'oro."
      }
    pickup_potion: {
        m: "Raccogli un {item}."
        f: "Raccogli una {item}."
      }
    belt_no_room: {
        m: "Nella cintura non c'è posto per un altro {item}."
        f: "Nella cintura non c'è posto per un'altra {item}."
      }
    pickup_scroll: {
        m: "Raccogli un {item}."
        f: "Raccogli una {item}."
      }
    pickup_item: "Raccogli {item}."
    pack_full: "Il tuo zaino è pieno."
    pack_too_full: "Lo zaino è troppo pieno per lo scambio."
    nothing_to_pick_up: "Qui non c'è niente da raccogliere."
    notice_item: "Noti qualcosa a terra."
    explored: "Qui non resta nulla da esplorare."
    spot: "Scorgi {who}."
    boss_destroyed: {
        m: "{who} è stato distrutto!"
        f: "{who} è stata distrutta!"
      }
    elite_slain: {
        m: "{who} è stato abbattuto!"
        f: "{who} è stata abbattuta!"
      }
    monster_dies: "{who} muore."
    out_of_range: "{who} è fuori portata."
    no_target: "Nessun bersaglio in vista."
    no_mana: "Mana insufficiente."
    level_up: "Hai raggiunto il livello {n}! (c per spendere 5 punti attributo)"
    open_chest: "Apri il forziere."
    altar_cold: "Ora l'altare è freddo."
    altar_restore: "La luce di sangue ti avvolge. Le forze ti tornano."
    altar_xp: "Una conoscenza proibita ti invade la mente. (+{n} PE)"
    altar_gift: "L'altare offre un dono."
    slain: "{who} ti ha ucciso."
    no_healing_potions: "Non hai pozioni curative."
    full_life: "La tua vita è già al massimo."
    drink_healing: "Bevi una pozione curativa."
    no_mana_potions: "Non hai pozioni di mana."
    full_mana: "Il tuo mana è già al massimo."
    drink_mana: "Bevi una pozione di mana."
    already_in_town: "Sei già in città."
    no_scrolls: "Non hai Pergamene del Portale cittadino."
    boneking_raises: "Il Re delle Ossa risveglia i morti!"
    boneking_greets: "Il Re delle Ossa: «Un'altra torcia da spegnere. Inginocchiati, e unisciti alla mia corte.»"
    boneking_dead: "Le cripte tacciono. Torna dal capitano Voss."
    buried_greets: "Il Capitano Sepolto: «Alt. La guardia non ha il cambio. Non lo ha mai.»"
    buried_rallies: "Il Capitano Sepolto: «Guardia, ai posti!» Il tumulo si ridesta."
    buried_dead: "Il Capitano Sepolto abbassa infine la lancia. La guardia ha avuto il cambio. Torna dal capitano Voss."
    oracle_reforms: "La Sibilla si dissolve in nebbia e si ricompone."
    oracle_lights: "Luci fredde si raccolgono attorno alla Sibilla."
    oracle_greets: "La Sibilla Annegata: «Ho visto la tua fine, piccola fiamma. È bagnata e fredda.»"
    oracle_dead: "Il canto della Sibilla si spegne. Più in basso ancora, qualcosa brucia... Torna da Voss."
    wanderer_greets: "L'Ultimo Viandante: «Un altro straniero. Mandano sempre uno straniero.»"
    wanderer_portal: "L'Ultimo Viandante esce dal portale, che si chiude alle sue spalle."
    wanderer_follows: "L'Ultimo Viandante ti segue."
    wanderer_home: "L'Ultimo Viandante: «Mi hai mostrato la strada di casa.»"
    wanderer_cuts: "L'Ultimo Viandante ferisce {who}."
    wanderer_kills: "L'Ultimo Viandante abbatte {who}."
    wanderer_taunt: "L'Ultimo Viandante: «Anche a me diedero una spada e un discorso da capitano.»"
    town_empty: "A Emberhold non resta nessuno, tranne te."
    forge_cold: "La forgia di Hadrik si raffredda."
    wanderer_last_words: "L'Ultimo Viandante: «Continua a camminare.»"
    wanderer_dead: "La luce rossa si spegne, e l'Oscurità lascia andare il fuoco."
    unseal_here: "Dove lui attendeva, si apre una via verso il basso."
    unseal_far: "Molto più in basso, nel Focolare, si apre una via verso il basso."
    running: "{who} fugge per salvarsi la vita."
    quest_reward: {
        one: "{who} ti dà {n} moneta d'oro e {item}."
        other: "{who} ti dà {n} monete d'oro e {item}."
      }
    quest_new: "Nuova missione: {name}."
    topic_new: "In città potresti chiedere di: {topic}."
    cannot_afford: "Non puoi permettertelo."
    belt_full: "La tua cintura è piena."
    gamble: "Hadrik apre l'involto: {item}. {n}g, niente rimborsi."
    reroll: "Hadrik tira fuori merce nuova per {n}g."
    bought: "Hai comprato {item} per {n}g."
    sold: "Hai venduto {item} per {n}g."
    equip: "Indossi {item}."
    unequip: "Ti togli {item}."
    drop: "Lasci cadere {item}."
    mirela_healthy: "Mirela ti squadra. «Sano come un pesce. Compra qualcosa, tesoro.»"
    mirela_free: "Mirela cura le tue ferite. «Ai giovani non faccio pagare. Ora compra qualcosa, tesoro.»"
    mirela_broke: "Mirela scuote la testa. «Le erbe costano, tesoro.»"
    mirela_partial: "Mirela fa quel che i tuoi {n}g le permettono. «Torna con qualcosa in più, tesoro.»"
    mirela_paid: "Mirela cura le tue ferite per {n}g. «Ecco. Ora compra qualcosa, tesoro.»"
  }
  ref: {
    the: {
        m: "il {name}"
        f: "la {name}"
        mv: "l'{name}"
        fv: "l'{name}"
        mp: "i {name}"
        fp: "le {name}"
      }
    a: {
        m: "un {name}"
        f: "una {name}"
        mv: "un {name}"
        fv: "un'{name}"
        mp: "dei {name}"
        fp: "delle {name}"
      }
    death_flames: {
        m: "la vampata mortale del {name}"
        f: "la vampata mortale della {name}"
        mv: "la vampata mortale dell'{name}"
        fv: "la vampata mortale dell'{name}"
        mp: "la vampata mortale dei {name}"
        fp: "la vampata mortale delle {name}"
      }
  }
  talk: {
    hadrik: {
      desc: "Un uomo massiccio e calvo, con un grembiule di cuoio bruciacchiato, nero di fuliggine fino ai gomiti. Ha gli avambracci butterati di piccole cicatrici bianche di bruciature, e respira lento e profondo, come un mantice."
      desc_again: "Hadrik, nero di fuliggine fino ai gomiti, il martello in mano. Non alza gli occhi."
      desc_wanderer: "Sul volto di Hadrik c'è un riflesso d'oro bianco, e per una volta sembra riposato. Guarda te, non il fuoco."
      desc_wanderer_again: "Hadrik canticchia mentre lavora. Sembra riposato."
      greet: "Acciaio contro il buio. Dai un'occhiata. La [forgia](forge) è calda; lo è sempre."
      greet_again: "Di nuovo qui. Cosa c'è da aggiustare?"
      greet_boneking: "Stamattina ho sentito le campane della cripta. Credevo di essere uscito di senno. Opera tua? Allora ti sei guadagnato l'acciaio buono."
      greet_oracle: "L'ultimo [straniero](stranger) che ho armato per scendere nel profondo non è mai tornato a farsi riparare niente."
      greet_wanderer: "Quando lui è caduto, la forgia ha dato una vampata bianca, poi si è calmata. Quarant'anni, e non gliel'avevo mai visto fare. A questa incudine sei il benvenuto."
      greet_hurt: "Stai sanguinando sulla mia incudine. Prima Mirela. Poi l'acciaio."
      greet_broke: "Guardare è gratis. Il resto no."
      greet_kingsbane: "Flagello dei Re. L'ultimo filo a quell'ascia gliel'ho dato io, per il [padre](father) del capitano. Mostrala a Voss. O no."
      greet_kingsbane_again: "Tieni oliato quel filo. Se l'è guadagnato."
      greet_crown: "Togliti quella corona nella mia forgia. Rende nervoso il fuoco."
      greet_crown_again: "Corona. Giù."
      forge: "Quarant'anni che la tengo. La custodia passa di mano in mano, da fabbro a fabbro. Quel che le brucia in pancia è la [Brace](ember) stessa. Il giorno che si spegne, scappiamo. Non è un modo di dire."
      ember: "La gente crede che stia in piazza, su un piedistallo. Vive nella mia forgia. Ogni lanterna della città si accende da qui. Io non ne parlo, e nemmeno tu."
      ember_again: "Ho detto che di quello non parlo."
      stranger: "Comprò la tua stessa spada. Pagò in moneta vecchia, senza mercanteggiare. Andò oltre la palude e non si fermò. Ho ancora la sua cote. La rivorrà."
      stranger_after: "Allora è tornato a casa, alla fine. Stanotte metto la sua cote nel fuoco."
      cult: "Vennero prima da me, quelli del [Culto della Brace](cult). Volevano che lasciassi spegnere il fuoco e la facessi finita col debito. Gli ho mostrato la porta col martello in mano."
      portals: "Cenere della forgia, piegata nella carta. Ogni scintilla conosce la strada per tornare al focolare, e così anche la cenere. Io la spazzo, Mirela la piega."
      aldous: "Aldous era uno di loro. Ora sta seduto tra le tombe e dice a chiunque si fermi che la [Brace](ember) è una ferita. Forse lo è. Meglio una ferita che una tomba. Non dirgli che ho detto forse."
      pell: "Il ragazzo vicino alla fontana. Una volta è venuto alla forgia a scaldarsi. È rimasto un'ora accanto al fuoco e non si è sgelato."
    }
    mirela: {
      desc: "Una bella donna di poco meno di quarant'anni, la figura piena stretta in un corpetto scuro, i capelli raccolti senza una ciocca fuori posto. Al collo le pende un cristallo pallido che ronza piano. Ti squadra come una maestra squadra un quaderno strappato."
      desc_again: "Mirela incrocia le braccia sotto il cristallo che porta al collo e aspetta che tu ti spieghi."
      desc_oracle: "Mirela rigira tra le dita il cristallo che porta al collo, ancora e ancora. È muto, e grigio come un sasso di fiume. Per una volta la sua schiena non è del tutto dritta."
      desc_oracle_again: "Il cristallo al collo di Mirela è grigio e muto. Lei non lo tocca."
      greet: "Siediti, siediti. Sai di fumo e di polvere di tomba. Vediamo cosa si è rotto."
      greet_again: "Di nuovo qui, tesoro? Fatti guardare."
      greet_boneking: "Stamattina mi hanno svegliata le campane della cripta. Ho pianto, tesoro, e non so perché.\nOra Voss ti manderà da [lei](oracle). Prima di andare, chiedimi di lei. Ti prego."
      greet_oracle: "C'è così tanto silenzio, figliolo. Il mio cristallo non ha più fatto un suono da quando sei risalito.\nNon sono arrabbiata, tesoro. Hai fatto ciò per cui ti hanno pagato. Ma posa la mano sul pavimento. È caldo."
      greet_wanderer: "Sei tornato. Lui no, non davvero. Siediti, tesoro, e lasciami curare quelle ustioni."
      greet_hurt: "Oh, figliolo, guardati. Siediti prima di cadere."
      greet_nopots: "Nemmeno una fiala alla cintura? Laggiù? Siediti, tesoro. Ci pensiamo noi."
      greet_crown: "Togliti quella corona alla mia tavola, tesoro. Sussurra, e io non prendo lezioni da un gioiello."
      greet_crown_again: "La corona, tesoro. Giù."
      oracle: "Il mio cristallo viene dalla sua grotta. Quando lei sogna, canta. Non dà la caccia a nessuno, figliolo. Tiene giù qualcosa, sotto l'acqua. Non so cosa. So che è caldo.\nVoss dice che è farla finita con lei. Io dico che è aprire una porta. Scendi, se devi, ma ascolta prima di alzare la lama."
      oracle_again: "Ti ho detto quello che mi dice il mio cristallo. Voss ha una spada e io ho un sasso che canta. Scegli tu a chi credere."
      oracle_after: "Il mio cristallo ha smesso di cantare. Ora tutta la città dorme tranquilla. Io no. Qualunque cosa lei tenesse giù, sta risalendo dall'[Abisso](abyss)."
      blackmarsh: "Le pietre ritte sono sue. Le ha innalzate mentre scendeva nell'acqua, come Edran innalzò i suoi altari. Le luci non danno la caccia, tesoro. Chiedono. [Pell](pell) ha detto sì."
      abyss: "Sotto la sua pozza la roccia brucia. È da lì che fu tagliato il carbone, se credi alle vecchie canzoni. Io ho cominciato a crederci."
      ember: "La luce calda è salita dal basso. La mia, quella fredda, è venuta da lei. La città vive tra le due e crede di vivere di una sola."
      pell: "Povero agnellino. L'acqua gli è entrata dentro. La sente come la sente il mio cristallo, solo che lui la notte non può posarla su una mensola."
      pell_oracle: "Non ha detto una parola da quando il mio cristallo tace. La sera sto seduta con lui. Non sembra dispiacergli."
      pell_oracle_again: "Ancora nemmeno una parola. Gli porto la minestra. Non la mangia, ma tiene in mano la scodella."
      pell_wanderer: "Stamattina ha parlato, tesoro! Ha chiesto del pane. Solo del pane. Ho pianto di nuovo."
      pell_wanderer_again: "È ancora freddo, ma mangia. È un inizio."
    }
    voss: {
      desc: "Un uomo asciutto in una corazza ammaccata, una fascia nera legata a una manica. Sta in piedi come chi non si siede da anni."
      desc_again: "Voss, una mano sulla spada, la fascia nera sulla manica."
      desc_boneking: "Voss sta un po' più sciolto. La fascia nera non è più sulla sua manica."
      desc_boneking_again: "Voss, una mano sulla spada. La sua manica è nuda."
      greet: "Viandante. Bene. Ci serve una lama che non tremi.\nQuattro piani sotto la [cripta](crypt), a est oltre i campi, il [Re delle Ossa](boneking) siede sul suo trono di costole. Distruggilo.\nTieni sempre con te una [pergamena del portale](portals). Torna vivo."
      greet_again: "Respiri ancora. Bene. Il [Re delle Ossa](boneking) è quattro piani sotto la [cripta](crypt). Portami la sua polvere."
      boneking_reward: "Il Re delle Ossa è polvere? Allora le campane della cripta potranno suonare di nuovo.\nPrendi questo: era di [mio padre](father). E l'oro, naturalmente."
      oracle_reward: "La Sibilla, messa a tacere... Non credevo che avrei mai dormito senza sentirla.\nSotto la sua pozza, la roccia brucia. Dicono che [l'Abisso](abyss) non abbia fondo. Fa' attenzione.\nUna volta ci ho mandato [qualcuno](stranger). Ho smesso di contare i giorni."
      greet_boneking: "La cripta tace. Ora la [Palude Nera](blackmarsh), a nord dei campi.\nSegui le luci fredde giù nella grotta. Metti fine alla [Sibilla](oracle).\nE se hai stomaco per un'altra tomba, chiedimi del [tumulo](barrow) a sud della strada della cripta."
      greet_boneking_again: "La [Palude Nera](blackmarsh), a nord dei campi. Segui le luci fredde giù. Non farti seguire al ritorno."
      greet_oracle: "Hai fatto più di quanto chiunque di noi abbia mai osato.\nMirela dice che ora il vento sa di forgia. Lasciala dire. Se devi scendere ancora, [l'Abisso](abyss) attende sotto la pozza della Sibilla."
      greet_oracle_again: "Qualunque cosa attenda nell'[Abisso](abyss), è oltre le mie mappe. Va' con prudenza, o non andare."
      greet_wanderer: "Le lanterne sono di nuovo accese. Chiunque fosse, un tempo era uno dei nostri.\nContinua a camminare, straniero. È per questo che ti paghiamo."
      greet_wanderer_again: "La guardia torna a dormire a turni. È merito tuo. Non farne un discorso."
      greet_hurt: "Stai sanguinando sul mio cancello. Va' da Mirela, poi da me."
      greet_kingsbane: "Quell'ascia. Flagello dei Re. L'ha portata giù mio [padre](father). Tienila. Lui la preferirebbe in pugno che arrugginita."
      greet_kingsbane_again: "La porti ancora. Bene."
      greet_crown: "Quella è la corona del [Re delle Ossa](boneking)? Non indossarla in piazza. La gente ricorda."
      greet_crown_again: "La corona, straniero. Non nella mia piazza."
      crypt: "La cripta reale, a est oltre i Campi di Cenere. Quattro piani, freddi e polverosi. I bracieri si accendono da soli. Non starci vicino."
      boneking: "Quattro piani sotto la cappella, su un trono di costole. Mio [padre](father) è sceso a cercarlo con un'ascia. Portami la sua polvere."
      boneking_after: "Polvere, dici. Bene. Ci crederò quando sentirò le campane."
      father: "Ha portato il Flagello dei Re nella [cripta](crypt) e non è tornato. La guardia ha scelto me la mattina dopo. Non c'era nessun altro da scegliere."
      father_again: "Ti ho detto quello che c'è da dire. Lascia stare."
      father_after: "Hai riportato ciò che era suo. È più di quanto siamo riusciti a fare noialtri. Non chiedermi altro."
      barrow: "La prima guardia di Emberhold. La guardia personale di Re [Edran](edran), prima che ci fosse una città da sorvegliare.\nQuando scese a prendere il carbone, si rifiutarono di seguirlo. Così li seppellì vivi in un tumulo a sud della strada della cripta e ordinò loro di montare la guardia. Per sempre.\nIl loro capitano teneva il mio posto prima che avesse un nome. Lo tiene ancora. Dagli il cambio. Vorrei che qualcuno facesse lo stesso per me."
      barrow_again: "A sud della strada della cripta, un anello di terra. Il loro capitano è ancora al suo posto. Dagli il cambio."
      barrow_after: "Ha avuto il cambio, dunque. Ora il posto è soltanto mio. Pesa più di quanto credessi."
      barrow_reward: "Il Capitano Sepolto, finalmente in pace. Ha montato la guardia più a lungo di quanto chiunque di noi farà mai.\nPrendi questo, e l'oro. La prossima volta che maledico il turno di notte, ricordami di lui."
      oracle: "Si è annegata nella grotta sotto la [Palude Nera](blackmarsh), e ora chiama gli smarriti a seguirla giù. Mettici fine.\nMirela ti dirà che sta tenendo giù qualcosa. Mirela dà retta a un sasso. Io seppellisco la gente a cui quel sasso canta."
      oracle_after: "Messa a tacere. Ora dormo. Strano quanto rumore possa fare il silenzio."
      stranger: "Ce n'era uno prima di te. Bravo con la lama. L'ho mandato oltre la pozza della Sibilla. Di regola, non assumo due volte per lo stesso lavoro."
      stranger_after: "Chiunque fosse, un tempo era uno dei nostri. Chiudiamola qui."
      cult: "Traditori. Una generazione fa sono scesi a restituire il fuoco. Alcuni sono ancora laggiù, a restituire."
      aldous: "Un avanzo del Culto. Lo lascio stare tra le tombe perché i morti non lo ascoltano. Non dovresti nemmeno tu."
      pell: "Il ragazzo è andato dietro alle luci della palude ed è tornato freddo. Quando lei non ci sarà più, si scalderà. È quello che dico a sua sorella."
      pell_oracle: "Il ragazzo non ha detto una parola da quando sei risalito. Dagli tempo. Il freddo ci mette un po' ad andarsene."
      pell_oracle_again: "Dai tempo al ragazzo."
    }
    aldous: {
      desc: "Un uomo scarno con una tonaca da cultista. Metà di lui è bruciata fino a lucidarsi, l'occhio da quel lato bianco come latte. L'altra metà ti sorride."
      desc_again: "Aldous, il lato bruciato del volto voltato lontano dalla luce."
      desc_oracle: "Aldous tiene un palmo premuto sulla terra, come a cercarvi un battito."
      desc_oracle_again: "Aldous tiene una mano sul terreno. Non la alza per salutarti."
      greet: "Un'altra delle lame di Voss. Siediti, se vuoi; alle tombe la compagnia non dispiace. Chiedimi del [Culto](cult). La città ti dirà cosa eravamo. Io ti dirò cosa abbiamo visto."
      greet_again: "Respiri ancora. Il fuoco non ha ancora deciso cosa fare di te."
      greet_boneking: "Così Edran si è coricato, finalmente. Gli hai fatto una gentilezza. Ti ringrazierebbe, se l'oscurità gli avesse lasciato una bocca."
      greet_oracle: "Posa la mano a terra. Calda, vero? Era questo che lei tratteneva. Hai tolto il tappo, Viandante. Ora vediamo cosa sale."
      greet_oracle_again: "Più caldo oggi. Più caldo ancora domani."
      greet_wanderer: "Era ciò che il fuoco vuole che ognuno di noi diventi. Tu l'hai abbattuto. Ne farà un altro. È paziente. Anch'io."
      greet_hurt: "Sanguini? Va' da Mirela. Al fuoco piace quell'odore."
      greet_crown: "La corona di Edran. La senti già? La sentirai."
      barrow: "Gli unici uomini di senno alla corte di Edran. Dissero no al carbone, e lui li seppellì per questo. La città li chiama spergiuri. Io li chiamo i primi che hanno ascoltato."
      cult: "Non eravamo traditori. Eravamo gli unici che ascoltavano. La [Brace](ember) non è mai stata nostra, così siamo scesi a restituirla. Il fuoco è stato lieto di vederci. Ha rifatto quelli che sono rimasti. Io sono fuggito. Tutta la mia eresia è questa."
      ember: "La città dice che Edran l'ha portata su. L'ha tagliata via. L'oscurità non ha fame, Viandante. È una ferita che cerca di chiudersi, ed Emberhold è la scheggia. Chiedi a Hadrik perché non dorme mai."
      edran: "Un ladro con la corona. La sua stessa [Sibilla](oracle) lo supplicò di rimetterla al suo posto. Lui la tenne, e l'oscurità gli prese il volto come compenso."
      abyss: "Sono stato dove stai andando. Laggiù la roccia sanguina. È lì che Edran tagliò il carbone, e la ferita non si è mai chiusa. Quello da cui fu tagliato è laggiù, ed è sveglio."
      abyss_after: "Ora è aperto. Annusa i pozzi. Quello che salirà adesso non sarà piccolo, e non sarà stupido."
      oracle: "È l'unica di noi che ha pagato come si deve. Si è distesa nell'acqua per tenerci il fuoco lontano dalla schiena, e lo trattiene da generazioni. Voss la vuole morta. Certo che la vuole. Non ha mai guardato una sola volta sotto i propri stivali."
      oracle_after: "Lo ha trattenuto per generazioni. Tu l'hai disfatto in un pomeriggio. Non ti giudico. Io sono fuggito, ricordi?"
      stranger: "L'ho incrociato mentre risalivo, sotto la pozza. Mi ha chiesto fin dove si scendesse. Gli ho detto la verità: fino in fondo. Mi ha ringraziato. Sorrideva."
      stranger_after: "Ecco cosa fa il fuoco di un uomo che scende fino in fondo a cercarlo. Speravo che ce l'avesse solo con me."
      pell: "Il ragazzo sente lei. Io sento l'altro. In due facciamo una brutta notte di sonno."
      aldous: "Fratello. Non resta nessun ordine di cui essere fratello. Tieniti pure il titolo, se vuoi; è tutto ciò che ho riportato su."
    }
    pell: {
      desc: "Un ragazzino magro di nove o dieci anni. Ha i capelli bagnati benché non abbia piovuto, le labbra appena azzurre, e non trema."
      desc_again: "Pell, i capelli ancora bagnati."
      desc_oracle: "Pell si stringe le ginocchia al petto e guarda oltre te, come se qualcosa gli dovesse una risposta."
      desc_oracle_again: "Pell, le ginocchia al petto, lo sguardo oltre te."
      desc_wanderer: "Pell è avvolto in una coperta troppo grande per lui, un tozzo di pane tra le mani. Trema. Le sue labbra sono rosa."
      desc_wanderer_again: "Pell nella sua coperta, trema e mastica."
      greet: "Sei caldo. Quassù sono tutti caldi."
      greet_again: "L'acqua parla di nuovo. Non a te."
      greet_boneking: "Le campane. Lei le ha sentite, sotto la palude. È stanca. Tenere giù è dura, se sei da sola."
      greet_oracle: "(Pell guarda la fontana e non dice nulla. L'acqua è immobile.)"
      greet_oracle_again: "(Pell non alza lo sguardo.)"
      greet_wanderer: "Ho freddo. Non ho mai avuto freddo prima. È così, essere solo me?"
      greet_wanderer_again: "Mia sorella dice che posso tornare alla palude. Non credo di volerci andare."
      oracle: "Lei è fredda così noi non bruciamo. Mi ha chiesto di tenerne un po' per lei. Ho detto sì. Ora anch'io sono freddo."
      oracle_after: "(Pell scuote la testa. Di lei non vuole parlare.)"
      blackmarsh: "Le luci non chiamavano. Chiedevano. Quasi tutti dicono sì. Io ho detto sì."
    }
    villager: {
      desc: "Un cittadino in un mantello grigio fuliggine, che continua a lanciare occhiate alla lanterna più vicina."
    }
    any: {
      ember: "Re [Edran](edran) portò su la Brace dal profondo a mani nude. Ogni lanterna di Emberhold si accende dalla [forgia](forge) di Hadrik, e la forgia dalla Brace. L'Oscurità si ferma al cancello."
      edran: "Il primo re. Scese da solo e risalì con il fuoco. In cambio l'Oscurità gli prese il volto, poi il cranio. Risalendo innalzò degli [altari](altars); alcuni sono ancora in piedi."
      altars: "Edran lasciò una goccia del suo sangue su ognuno, per comprare un'altra ora di passaggio sicuro. Versa il tuo sangue su uno e il patto ti ripaga. Una volta."
      forge: "La forgia di Hadrik non si spegne da quarant'anni. Chiedigli di lei, se ti piace farti fulminare con lo sguardo."
      portals: "Leggi una pergamena del portale e sei di nuovo nella piazza della fontana. Hadrik ne spazza la cenere, Mirela la piega. Chiedi a lui perché funziona."
      crypt: "La cripta reale, a est del cancello, oltre i Campi di Cenere. Re [Edran](edran) vi giace con la sua corte. «Giace» è una parola generosa. Il capitano la conosce meglio di tutti."
      boneking: "Siede sul suo trono di costole quattro piani più giù, sotto una corona vuota. Dicono che non abbia ancora finito di fare il re."
      boneking_after: "Il Re delle Ossa è polvere, dicono. Le campane della cripta potranno suonare di nuovo."
      father: "Il padre del capitano portò una vecchia ascia nella cripta. Il capitano non ne parla. E non dovresti nemmeno tu."
      barrow: "Un anello di terra a sud della strada della cripta. Dentro c'è la guardia di Edran, quelli che non vollero seguirlo giù. Sepolti in piedi, dicono, ancora di guardia. Tenevano il posto del capitano; chiedi a Voss."
      barrow_after: "Ora di notte i campi a sud sono quieti. I pastori sono tornati."
      blackmarsh: "A nord dei campi. Luci fredde vagano sull'acqua. Non seguirle. Tutti le seguono. Mirela ascolta quell'acqua; chiedi a lei."
      oracle: "La Sibilla del re in persona. Gli disse di non prendere il carbone. Quando lui non volle ascoltarla, lei entrò nell'acqua sotto la [Palude Nera](blackmarsh) e non riemerse più."
      oracle_after: "Le luci della palude si sono spente. La gente dice che è finita. Mirela non dice niente."
      abyss: "Sotto la pozza della Sibilla la roccia brucia. Dicono che l'Abisso non abbia fondo. Il [Culto della Brace](cult) è andato da quella parte."
      cult: "Una generazione fa, certa gente decise che all'oscurità si doveva il suo carbone. Scesero a pagare. Il fuoco li rifece. Uno è tornato: [Fratello Aldous](aldous), vicino alle tombe. Non farlo cominciare."
      stranger: "Chiedi a Hadrik. Gli ha venduto la spada, e ha tenuto qualcosa di suo."
      aldous: "È tornato dall'Abisso l'inverno scorso, bruciato su un fianco. Si fa chiamare Fratello. Sta seduto nel cimitero e parla con le pietre."
      pell: "Il ragazzo vicino alla fontana. È andato dietro alle luci della palude ed è tornato freddo. Sua sorella non pronuncia il suo nome dopo il tramonto."
      stranger_after: "Le lanterne sono di nuovo accese. Nessuno pronuncia il suo nome. Nessuno lo conosceva."
    }
  }
  journal: {
    boneking: {
      taken: "Il capitano Voss vuole che il Re delle Ossa sia distrutto. Siede sul suo trono di costole quattro piani sotto la Cripta dei Caduti, a est della porta, oltre i Campi di Cenere. Il padre di Voss scese a cercarlo con un'ascia e non tornò più."
      done: "Il Re delle Ossa è polvere, e le cripte tacciono. Voss vorrà sentirlo da te."
      rewarded: "Voss ti ha pagato in oro, e ti ha dato qualcosa che era di suo padre. Le campane della cripta potranno suonare di nuovo."
    }
    barrow: {
      taken: "Il capitano Voss vuole che si dia il cambio al Capitano Sepolto. Re Edran seppellì vivi gli uomini della sua guardia in un tumulo a sud della strada della cripta, nei Campi di Cenere, perché si erano rifiutati di seguirlo giù. Il loro capitano teneva il posto di Voss prima che avesse un nome, ed è ancora di guardia due piani più sotto."
      done: "Il Capitano Sepolto ha abbassato la lancia. La guardia ha avuto il cambio. Voss vorrà sentirlo da te."
      rewarded: "Voss ti ha pagato in oro, e ti ha chiesto di ricordargli il Capitano Sepolto la prossima volta che maledirà il turno di notte."
    }
    oracle: {
      taken: "Voss vuole che si metta fine alla Sibilla Annegata. Entrò nell'acqua sotto la Palude Nera, a nord dei campi, e chiama gli smarriti a seguirla giù. Segui le luci fredde fin dentro la Grotta Sommersa."
      done: "Il canto della Sibilla è finito. Più in basso ancora, qualcosa brucia. Voss dovrebbe saperlo."
      rewarded: "Voss ti ha pagato, e ti ha avvertito: sotto la sua pozza la roccia brucia, e l'Abisso Ardente non ha fondo."
    }
    wanderer: {
      taken: "Quando la Sibilla è caduta, qualcosa è risalito dall'Abisso. Ogni luce si spegne al suo passaggio, e ti somiglia: è lo straniero che Emberhold assoldò prima di te. Ferma l'Ultimo Viandante prima che raggiunga la forgia."
      done: "L'Ultimo Viandante è caduto. L'Oscurità ha lasciato andare il fuoco, e le lanterne di Emberhold ardono di nuovo."
    }
  }
  topic: {
    rumors: "Ultime voci"
