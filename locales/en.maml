    wanderer: "The Last Wanderer"
    smith: "Hadrik the Smith"
    alch: "Old Mirela"
    captain: "Captain Voss"
    villager: "Villager"
  }

  # Unique monsters are named first + last: "Bloodmaw the Hungry". The last
  # part may agree with the first, a noun with a gender.
  unique_monster: {
    name: "{first} {last}"
    first: {
      bloodmaw: "Bloodmaw"
      grimtooth: "Grimtooth"
      ashfang: "Ashfang"
      hollowgrin: "Hollowgrin"
      rotgut: "Rotgut"
      blackvein: "Blackvein"
      skullcleave: "Skullcleave"
