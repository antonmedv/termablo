  # Unique items: a proper name (a noun, it may carry a gender) and a line of
  # flavor. See docs/lore.md, "Named things".
  unique: {
    last_wanderers_shroud: {
      name: "Last Wanderer's Shroud"
      flavor: "Still warm. It was never yours, and now it is."
    }
    wanderers_shroud: {
      name: "Wanderer's Shroud"
      flavor: "Worn by one who never stopped walking."
    }
    shard_of_night: {
      name: "Shard of Night"
      flavor: "It drinks the torchlight."
    }
    hollow_crown: {
      name: "Hollow Crown"
      flavor: "The king it belonged to did not need a skull."
    }
    emberbrand: {
      name: "Emberbrand"
      flavor: "Its edge never cools."
    }
    the_last_lantern: {
      name: "The Last Lantern"
      flavor: "It burns when all else is dark."
    }
    moonstride: {
      name: "Moonstride"
      flavor: "Footsteps like falling snow."
    }
    band_of_ashes: {
      name: "Band of Ashes"
      flavor: "Warm to the touch, always."
    }
    gravewardens_coat: {
      name: "Gravewarden's Coat"
      flavor: "Stitched from the shrouds of the unquiet."
    }
    eye_of_the_deep: {
      name: "Eye of the Deep"
      flavor: "It blinks when you are not looking."
    }
    crown_of_the_drowned: {
      name: "Crown of the Drowned"
      flavor: "Water still drips from its rim."
    }
    bloodfist: {
      name: "Bloodfist"
      flavor: "Never clean. Never dry."
    }
    kingsbane: {
      name: "Kingsbane"
      flavor: "Seven crowns have rolled beneath it."
    }
    starfall_plate: {
      name: "Starfall Plate"
      flavor: "Forged from a fallen star; it remembers the sky."
    }
  }

  # What an unidentified item from Hadrik is called by its slot: see item.unidentified.
  gamble: {
    weapon: "Weapon"
    shield: "Shield"
    helm: "Helm"
    armor: "Armor"
    gloves: "Gloves"
    boots: "Boots"
    ring: "Ring"
    amulet: "Amulet"
  }

  # Monsters and townsfolk by ID: nouns. English marks the nouns that take
  # "an" with gender "an". Names starting "The" are bosses, used without an article.
  monster: {
    rat: "Plague Rat"
    bat: "Cave Bat"
    fallen: "Fallen One"
    shaman: "Fallen Shaman"
    zombie: "Zombie"
    wolf: "Dire Wolf"
    skel: "Skeleton"
    archer: "Skeleton Archer"
    ghoul: "Ghoul"
    cultist: { text: "Ember Cultist", gender: "an" }
    wraith: "Wraith"
    wisp: "Will-o'-Wisp"
    drowned: "Drowned Dead"
    horror: "Marsh Horror"
    spider: "Grotto Spider"
    golem: "Crystal Golem"
    imp: "Fire Imp"
    hellspawn: "Hellspawn"
    boneking: "The Bone King"
    oracle: "The Drowned Oracle"
    wanderer: "The Last Wanderer"
    smith: "Hadrik the Smith"
    alch: "Mirela the Alchemist"
    captain: "Captain Voss"
    exile: "Brother Aldous"
    boy: "Pell"
    villager: "Villager"
  }

  # Unique monsters are named first + last: "Bloodmaw the Hungry". The last
  # part may agree with the first, a noun with a gender.
  unique_monster: {
    name: "{first} {last}"
    first: {
      bloodmaw: "Bloodmaw"
      grimtooth: "Grimtooth"
      ashfang: "Ashfang"
      hollowgrin: "Hollowgrin"
      rotgut: "Rotgut"
      blackvein: "Blackvein"
      skullcleave: "Skullcleave"
      mournwind: "Mournwind"
      gravelurk: "Gravelurk"
      emberskull: "Emberskull"
      frostmarrow: "Frostmarrow"
      dreadhowl: "Dreadhowl"
      cinderjaw: "Cinderjaw"
      wormheart: "Wormheart"
    }
    last: {
      the_hungry: "the Hungry"
      the_vile: "the Vile"
      the_unburied: "the Unburied"
      the_defiler: "the Defiler"
      the_pale: "the Pale"
      the_cruel: "the Cruel"
      the_wretched: "the Wretched"
      the_weeping: "the Weeping"
      the_gnawer: "the Gnawer"
    }
  }

  # Champion and unique monster modifiers, listed after the name.
  # max: 14
  mod: {
    extra_strong: "Extra Strong"
    swift: "Swift"
    stone_skin: "Stone Skin"
    fire_enchanted: "Fire Enchanted"
    vampiric: "Vampiric"
  }

  # A monster hits the hero: {who} is the attacker as a subject ("the Plague
  # Rat", "Bloodmaw the Hungry"), {n} the damage. One line per verb.
  hit: {
    bites: "{who} bites you for {n}."
    stabs: "{who} stabs you for {n}."
    hurls_fire_at: "{who} hurls fire at you for {n}."
    claws: "{who} claws you for {n}."
    mauls: "{who} mauls you for {n}."
    slashes: "{who} slashes you for {n}."
    shoots: "{who} shoots you for {n}."
    rends: "{who} rends you for {n}."
    casts_fire_at: "{who} casts fire at you for {n}."
    chills: "{who} chills you for {n}."
    shocks: "{who} shocks you for {n}."
    grasps: "{who} grasps you for {n}."
    crushes: "{who} crushes you for {n}."
    pummels: "{who} pummels you for {n}."
    spits_fire_at: "{who} spits fire at you for {n}."
    cleaves: "{who} cleaves you for {n}."
    smites: "{who} smites you for {n}."
    drowns: "{who} drowns you for {n}."
    cuts: "{who} cuts you for {n}."
    hits: "{who} hits you for {n}."
    # {who} is "<monster>'s death flames" (ref.death_flames), a plural subject
    burn: "{who} burn you for {n}."
  }

  # Map tiles, as hover text. Lowercase; the game capitalizes the first letter.
  tile: {
    void: "void"
    stone_floor: "stone floor"
    wall: "wall"
