# Termablo's text, in English: the source every translation is made
# from and the fallback for any key a translation lacks. The runbook is
# docs/translating.md; the terms live in locales/glossary.maml.
#
# A value is a string, or an object:
#   - plural forms, chosen by the count {n}:   { one: "...", other: "..." }
#   - gender forms, chosen by a noun argument:  { m: "...", f: "...", n: "..." }
#   - a noun that other words agree with:       { text: "...", gender: "f" }
# Placeholders are {name}; {{ is a literal brace. Comments above a key are
# context for translators. "# max: N" limits the key (and everything inside
# it) to N terminal cells; a CJK character takes two.
{
  # The message log: whole sentences, the first letter capitalized by the
  # game. A monster in a message comes as {who}: already carrying its
  # article ("the Plague Rat", "a Fire Imp") or a proper name ("Bloodmaw
  # the Hungry"), in the nominative. Translations should keep {who} as the
  # sentence's subject so no other case is needed.
  msg: {
    welcome_goal: "Hunt the Bone King in the crypt and the Drowned Oracle beneath Blackmarsh."
    welcome_help: "Press ? for help. Captain Voss by the tavern has work for you."
    # {area}: the level's name, area.*
    enter: "You enter {area}."
    far_beyond: "Something here is far beyond you."
    fountain: "The cold water closes your wounds."
    portal_step: "You step through the portal."
    portal_collapse: "The portal collapses behind you."
    portal_open: "A shimmering blue portal tears open."
    # {item}: an item's name, no article. "g" is the pick-up key.
    see_item: "You see {item} here. (g to pick up)"
    see_items: "Several items lie here. (g to pick up)"
    pickup_gold: "You pick up {n} gold."
    # {item}: "Healing Potion" or "Mana Potion"
    pickup_potion: "You pick up a {item}."
    belt_no_room: "Your belt has no room for another {item}."
    # {item}: "Scroll of Town Portal"
    pickup_scroll: "You pick up a {item}."
    pickup_item: "You pick up {item}."
    pack_full: "Your pack is full."
    pack_too_full: "Your pack is too full to swap that."
    nothing_to_pick_up: "There is nothing here to pick up."
    notice_item: "You notice something on the ground."
    explored: "Nothing left to explore here."
    # {who}: a monster as met for the first time, ref.a ("a Fire Imp")
    spot: "You spot {who}."
    # A boss dies; {who} is its name ("The Bone King").
    boss_destroyed: "{who} has been destroyed!"
    # A champion or unique dies.
    elite_slain: "{who} is slain!"
    monster_dies: "{who} dies."
    out_of_range: "{who} is out of range."
    no_target: "No target in sight."
    no_mana: "Not enough mana."
    # {n}: the new character level; "c" opens the character sheet
    level_up: "You have reached level {n}! (c to spend 5 attribute points)"
    open_chest: "You open the chest."
    altar_cold: "The altar is cold now."
    altar_restore: "Blood-light washes over you. You are restored."
    altar_xp: "Forbidden knowledge floods your mind. (+{n} XP)"
    altar_gift: "The altar offers up a gift."
    # {who}: what killed the hero, as in hit.*
    slain: "You have been slain by {who}."
    no_healing_potions: "You have no healing potions."
    full_life: "You are already at full life."
    drink_healing: "You drink a healing potion."
    no_mana_potions: "You have no mana potions."
    full_mana: "Your mana is already full."
    drink_mana: "You drink a mana potion."
    already_in_town: "You are already in town."
    no_scrolls: "You have no Scrolls of Town Portal."
    boneking_raises: "The Bone King raises the dead!"
    boneking_greets: "The Bone King: \"Another torch to snuff. Kneel, and join my court.\""
    boneking_dead: "The crypts fall silent. Return to Captain Voss."
    oracle_reforms: "The Oracle dissolves into mist and reforms."
    oracle_lights: "Cold lights gather around the Oracle."
    oracle_greets: "The Drowned Oracle: \"I have seen your ending, little flame. It is wet and cold.\""
    oracle_dead: "The Oracle's song ends. Deeper still, something burns... Return to Voss."
    wanderer_greets: "The Last Wanderer: \"Another stranger. They always send a stranger.\""
    wanderer_portal: "The Last Wanderer steps out of the portal. It collapses behind him."
    wanderer_follows: "The Last Wanderer follows you."
    wanderer_home: "The Last Wanderer: \"You showed me the way home.\""
    # {who}: a townsperson, the object: "a Villager", "Old Mirela"
    wanderer_cuts: "The Last Wanderer cuts {who}."
    wanderer_kills: "The Last Wanderer cuts down {who}."
    wanderer_taunt: "The Last Wanderer: \"They gave me a sword and a captain's speech too.\""
    town_empty: "No one is left in Emberhold but you."
    forge_cold: "Hadrik's forge goes cold."
    wanderer_last_words: "The Last Wanderer: \"Keep walking.\""
    wanderer_dead: "The red light goes out, and the dark lets go of the fire."
    unseal_here: "Where he waited, a way down opens."
    unseal_far: "Far below, in the Hearth, a way down opens."
    # A townsperson while the Last Wanderer hunts the town; {who} is the
    # townsperson as the subject.
    running: "{who} is running for their life."
    # {n}: gold; {item}: the unique he hands over
    voss_reward: "Voss gives you {n} gold and {item}."
    cannot_afford: "You cannot afford that."
    belt_full: "Your belt is full."
    # Hadrik's gamble: {item} the item it turned out to be, {n} the price
    gamble: "Hadrik unwraps {item}. {n}g, no refunds."
    reroll: "Hadrik hauls out fresh stock for {n}g."
    bought: "Bought {item} for {n}g."
    sold: "Sold {item} for {n}g."
    equip: "You equip {item}."
    unequip: "You remove {item}."
    drop: "You drop {item}."
    # Mirela, the alchemist, calls the hero "dear". {n}: gold paid
    mirela_healthy: "Mirela looks you over. \"Hale as an ox. Buy something, dear.\""
    mirela_free: "Mirela tends your wounds. \"No charge for the young. Now buy something, dear.\""
    mirela_broke: "Mirela shakes her head. \"Herbs cost coin, dear.\""
    mirela_partial: "Mirela does what your {n}g allows. \"Come back with more, dear.\""
    mirela_paid: "Mirela tends your wounds for {n}g. \"There. Now buy something, dear.\""
  }

  # How a monster is referred to in messages. {name} is a monster noun;
  # write gender forms where the article agrees. Named monsters (uniques,
  # bosses, Hadrik, Mirela, Voss) skip these and appear by name.
  ref: {
    # the monster as a known subject: "the Plague Rat"
    the: "the {name}"
    # a monster first seen: "a Plague Rat"; English uses "an" for the nouns
    # marked gender "an"
    a: { other: "a {name}", an: "an {name}" }
    # a fire-enchanted monster's dying blast, the subject of hit.burn; may
    # be a noun { text, gender } so hit.burn can agree with it
    death_flames: "{name}'s death flames"
  }

  # Spoken lines, shown in the conversation window. Multi-line values are
  # dialogues, one paragraph a line. [words](topic) is a link: the words
  # are shown highlighted, and hearing them teaches the hero the topic
  # (topic.<id>). Translate the words, keep the (topic) as it is.
  #
  # talk.<who>.greet is what a speaker says on meeting the hero, and
  # talk.<who>.<topic> what they say when asked. Speakers remember: a line
  # they have said before gives way to its <line>_again. What the town
  # knows changes them too: <line>_boneking, _oracle and _wanderer are
  # news, said once that boss is dead (and, for the first two, Voss has
  # paid for it). Only the newest news is told, after the plain line has
  # been said once, and only once unless it has an _again. <topic>_after
  # is said for good once the topic's boss is dead.
  talk: {
    # Hadrik is gruff and few-worded. He keeps the forge, which keeps the
    # Ember, and knows it.
    hadrik: {
      greet: "Steel for the dark. Take a look. The [forge](forge) is hot; it always is."
      greet_again: "Back. What needs mending?"
      greet_boneking: "Heard the crypt bells this morning. Thought I'd gone soft in the head. Your doing? Then you've earned the good steel."
      greet_oracle: "Last [stranger](stranger) I armed for the deep never came back for repairs."
      greet_wanderer: "The forge flared white when he fell, then settled. Forty years, never seen her do that. You're welcome at this anvil."
      forge: "Forty years I've kept her. The keeping passes hand to hand, smith to smith. What burns in her belly is the [Ember](ember) itself. The day she goes out, we run. That's not a saying."
      ember: "Folk think it sits in the square on a pedestal. It lives in my forge. Every lantern in town is lit from here. I don't talk about that, and neither will you."
      ember_again: "I said I don't talk about that."
      stranger: "Bought the same sword you did. Paid in old coin, didn't haggle. Went past the marsh and kept going. I still have his whetstone. He'll want it back."
      stranger_after: "So he came home after all. I'll put his whetstone in the fire tonight."
      cult: "They came to me first, the [Ember Cult](cult). Wanted me to let the fire go out and be done owing. I showed them the door with a hammer in my hand."
      portals: "Forge ash, folded in paper. Every spark knows the way home to the hearth, so the ash does too. I sweep it, Mirela folds it."
    }
    # Old Mirela is warm and worried. Her crystal hears the Oracle.
    mirela: {
      greet: "Sit, sit. You smell of smoke and grave-dust. Let's see what's broken."
      greet_again: "Back again, dear? Let me look at you."
      greet_boneking: "The crypt bells woke me this morning. I cried, dear, and I don't know why. Sit; you're bleeding on my floor."
      greet_oracle: "It's so quiet, child. My crystal hasn't made a sound since you came up. I keep holding it to my ear."
      greet_wanderer: "You came back. He never did, not really. Sit, dear, and let me see to those burns."
      oracle: "My crystal came out of her grotto. When she dreams, it sings. She isn't hunting anyone, child. She is holding something down, under the water. I don't know what. I know it's hot."
      oracle_after: "My crystal has stopped singing. The whole town sleeps sound now. I don't. Whatever she held down is coming up through the [Abyss](abyss)."
      blackmarsh: "The cold lights over the water are hers. Don't follow them. Everyone follows them. The standing stones she raised herself, on her way down."
      abyss: "Beneath her pool the rock burns. It's where the coal was cut from, if you believe the old songs. I've started to."
      ember: "Warm light came up from below. My kind, the cold kind, came from her. The town lives between the two and thinks it lives by one."
      portals: "Forge ash in paper; Hadrik sweeps it, I fold it. Read one and the [Ember](ember) pulls you home to the fountain. Cheaper than a funeral."
    }
    # Captain Voss is earnest and clipped. He believes the town's story.
    voss: {
      greet: """
Wanderer. Good. We need a blade that doesn't shake.
The [Ember](ember) keeps the dark out. The dark wants it back.
East of the gate, past the Ashen Fields, lies the [Crypt of the Fallen](crypt).
Four floors down, the [Bone King](boneking) sits his throne of ribs. Destroy him.
And north, in [Blackmarsh](blackmarsh), the [Drowned Oracle](oracle) calls the lost into the water.
Buy potions from Mirela. Keep a [portal scroll](portals). Come back alive."""
      greet_again: "Still breathing. Good. The [Bone King](boneking) is four floors under the [crypt](crypt). Bring me his dust."
      boneking_reward: """
The Bone King is dust? Then the crypt bells may ring again.
Take this — it was [my father's](father). And the gold, of course."""
      oracle_reward: """
The Oracle, silenced... I never thought I'd sleep without hearing her.
Beneath her pool, the rock burns. [The Abyss](abyss) has no floor, they say. Be careful.
I sent [someone](stranger) down there once. I stopped counting the days."""
      greet_boneking: """
The crypt is quiet. Now: [Blackmarsh](blackmarsh), north of the fields.
Follow the cold lights down into the grotto. End the [Oracle](oracle)."""
      greet_boneking_again: "[Blackmarsh](blackmarsh), north of the fields. Follow the cold lights down. Don't let them follow you back."
      greet_oracle: """
You've done more than any of us dared.
If you must go deeper... [the Abyss](abyss) waits below the Oracle's pool."""
      greet_oracle_again: "Whatever waits in [the Abyss](abyss) is past my maps. Go carefully, or don't go."
      greet_wanderer: """
The lanterns are lit again. Whoever he was, he was one of ours once.
Keep walking, stranger. It is what we hire you for."""
      greet_wanderer_again: "The watch sleeps in shifts again. That's your doing. Don't make a speech of it."
      crypt: "The royal crypt, east past the Ashen Fields. Four floors, cold and dusty. The braziers light themselves. Don't stand near them."
      boneking: "Four floors under the chapel, on a throne of ribs. My [father](father) went down after him with an axe. Bring me his dust."
      boneking_after: "Dust, you say. Good. I'll believe it when I hear the bells."
      father: "He took Kingsbane into the [crypt](crypt) and didn't come back. The guard chose me the next morning. There was no one else to choose."
      father_again: "I told you what there is. Leave it."
      father_after: "You brought back what was his. That's more than the rest of us managed. Don't ask me more."
      oracle: "She drowned herself in the grotto under [Blackmarsh](blackmarsh), and now she calls the lost down after her. End it."
      oracle_after: "Silenced. I sleep now. Strange, how loud a quiet can be."
      stranger: "There was one before you. Good with a blade. I sent him past the Oracle's pool. I don't hire twice for the same job, as a rule."
      stranger_after: "Whoever he was, he was one of ours once. Leave it there."
      cult: "Traitors. A generation back they went down to give the fire back. Some of them are still down there, giving."
    }
    # What anyone in town says when they have nothing of their own to say.
    any: {
      ember: "King [Edran](edran) carried the Ember up from below in his bare hands. Every lantern in Emberhold is lit from Hadrik's [forge](forge), and the forge from the Ember. The dark stops at the gate."
      edran: "The first king. He went down alone and came up with fire. The dark took his face for it, then his skull. He raised [altars](altars) on the way up; some still stand."
      altars: "Edran left a drop of his blood on each, to buy another hour of safe passage. Bleed on one yourself and the bargain pays out. Once."
      forge: "Hadrik's forge hasn't gone out in forty years. Every lantern in town is lit from it."
      portals: "Read a portal scroll and you're back at the fountain square. Every spark of the Ember knows the way home."
      crypt: "The royal crypt, east of the gate past the Ashen Fields. King [Edran](edran) lies there with his court. Lies is a generous word."
      boneking: "He sits his throne of ribs four floors down, under a hollow crown. They say he isn't finished being king."
      boneking_after: "The Bone King is dust, they say. The crypt bells may ring again."
      father: "The captain's father took an old axe into the crypt. The captain doesn't talk about it. Neither should you."
      blackmarsh: "North of the fields. Cold lights drift over the water. Don't follow them. Everyone follows them."
      oracle: "The king's own Oracle. She told him not to take the coal. When he wouldn't listen she walked into the water under [Blackmarsh](blackmarsh) and never came up."
      oracle_after: "The marsh lights have gone out. People say it's over. Mirela doesn't say anything."
      abyss: "Under the Oracle's pool the rock burns. They say the Abyss has no floor. The [Ember Cult](cult) went that way."
      cult: "A generation ago some folk decided the dark was owed its coal. They went down to pay. The fire remade them. Some still wear our faces."
      stranger: "There was a stranger before you. Bought the same sword. Went past the marsh and kept going."
      stranger_after: "The lanterns are lit again. Nobody says his name. Nobody knew it."
    }
  }

  # The topics of conversation, as the list beside it shows them, sorted
  # by these names.
  # max: 18
  topic: {
    rumors: "Latest rumors"
    ember: "Ember"
    edran: "King Edran"
    altars: "Altars"
    forge: "Forge"
    portals: "Portal scrolls"
    crypt: "Crypt"
    boneking: "Bone King"
    father: "Voss's father"
    blackmarsh: "Blackmarsh"
    oracle: "Drowned Oracle"
    abyss: "Burning Abyss"
    cult: "Ember Cult"
    stranger: "Stranger"
  }

  # What villagers say, one picked at random. Rumors; most are true.
  # [words](topic) is a link, as in talk.
  rumor: {
    braziers: "They say the braziers in the [crypt](crypt) light themselves at dusk. Nobody tends them."
    brother: "My brother went into [Blackmarsh](blackmarsh) after the lights. He came back wet. He came back wrong."
    torch: "Keep your torch high. The dark down there isn't empty — it's hungry."
    forge: "[Hadrik's forge](forge) hasn't gone out in forty years. He says the day it does, we run."
    glimmer: "Rare things glimmer in the dark. Gold-light means something old and named."
    crystal: "Old Mirela's crystal was dug out of the grotto. It sings when the [Oracle](oracle) dreams."
    scroll: "A [portal scroll](portals) is cheaper than a funeral."
    stranger: "There was a [stranger](stranger) before you. Bought the same sword. Went past the marsh and kept going."
    edran: "[King Edran](edran) carried the [Ember](ember) up in his bare hands. It cost him his face."
    uncle: "My uncle joined the [Ember Cult](cult). Said the dark was owed. He went down to pay it."
    holding: "Mirela says the [Oracle](oracle) isn't hunting anyone. She's holding something down."
  }

  # Level names, as the side panel, the map and the log show them.
  # max: 26
  area: {
    town: "Emberhold"
    fields: "Ashen Fields"
    marsh: "Blackmarsh"
    # {n}: the floor, 1 to 3
    crypt: "Crypt of the Fallen {n}"
    throne: "Throne of the Bone King"
    grotto: "Sunken Grotto {n}"
    oracle_pool: "The Oracle's Pool"
    abyss: "The Burning Abyss {n}"
    hearth: "The Hearth Below"
  }

  # Where a path leads, before the level there exists: "Leads to {place}".
  region: {
    town: "Emberhold"
    fields: "the Ashen Fields"
    marsh: "Blackmarsh"
    crypt: "the Crypt of the Fallen"
    grotto: "the Sunken Grotto"
    abyss: "the Burning Abyss"
  }

  # Logged the first time the hero enters a level; {area} is its name.
  lore: {
    town: "Emberhold. The last lit town before the dark. Lanterns burn all night here."
    fields: "The Ashen Fields. Moonlight on the ash of a burned forest."
    marsh: "Blackmarsh. Cold lights drift over the water. Do not follow them."
    crypt: "{area}. A royal tomb; the air tastes of dust."
    grotto: "{area}. Cold water presses down; the crystals hum."
    abyss: "{area}. The rock itself is bleeding."
    hearth: "{area}. The braziers lean away from the middle of the room."
  }

  shop: {
    smith: "Hadrik's Forge"
    alch: "Mirela's Remedies"
  }

  item: {
    # {n} gold coins on the ground or in a shop list
    gold: "{n} gold"
    healing_potion: "Healing Potion"
    mana_potion: "Mana Potion"
    town_portal_scroll: "Scroll of Town Portal"
    # one of Hadrik's gambles; {base} is a gamble.* noun
    unidentified: "Unidentified {base}"
    fresh_stock: "Fresh stock"
    # A Magic item: prefix.*, base.*, suffix.*; either affix may be empty
    # and spaces around an empty one are dropped. Reorder freely.
    magic: "{prefix} {base} {suffix}"
    # A Rare item: rare.first.* and rare.second.*
    rare: "{first} {second}"
    # Tooltip lines of potions, scrolls and Hadrik's services; one line each.
    desc: {
      healing_potion: "Restores a large portion of life"
      mana_potion: "Restores a large portion of mana"
      town_portal_scroll: "Opens a portal back to Emberhold"
      unidentified: """
Hadrik's pick from the depth you have reached.
Could be anything. No refunds."""
      fresh_stock: "Hadrik hauls out new stock, and Mirela does too."
    }
  }

  # A Rare or Unique item's kind under its name: "Rare Chain Mail".
  rarity: {
    rare: "Rare {base}"
    unique: "Unique {base}"
  }

  # Equipment slots, the inventory's left column.
  # max: 12
  slot: {
    weapon: "Weapon"
    off_hand: "Off-hand"
    helm: "Helm"
    armor: "Armor"
    gloves: "Gloves"
    boots: "Boots"
    ring: "Ring"
    amulet: "Amulet"
  }

  # Item properties; {n} is the amount.
  stat: {
    str: "+{n} Strength"
    dex: "+{n} Dexterity"
    vit: "+{n} Vitality"
    ene: "+{n} Energy"
    life: "+{n} Life"
    mana: "+{n} Mana"
    dmg_pct: "+{n}% Enhanced Damage"
    flat_dmg: "+{n} Damage"
    armor: "+{n} Armor"
    armor_pct: "+{n}% Enhanced Armor"
    crit: "+{n}% Critical Strike"
    life_steal: "{n}% Life Stolen per Hit"
    light: "+{n} Light Radius"
    spell_pct: "+{n}% Spell Damage"
    # per turn
    life_regen: "Regenerate {n} Life"
    mana_regen: "Regenerate {n} Mana"
    mf: "+{n}% Magic Find"
    thorns: "Attackers take {n} Damage"
    to_hit: "+{n} Attack Rating"
    all_attr: "+{n} All Attributes"
    gold_find: "+{n}% Extra Gold"
  }

  # Hover notes on map tiles that do something.
  tile_note: {
    door: "Walk into it to open."
    chest: "Walk into it to open."
    fountain: "Walk into it to restore life."
    blood_altar: "Walk into it to make an offering."
    brazier: "Casts warm firelight."
    cold_forge: "Hadrik's forge. It has gone out."
    street_lamp: "Casts warm lamplight."
    campfire: "A camp of the Fallen is never far."
    glowing_crystal: "Glows with cold blue light."
    lava: "Molten rock. Impassable, and bright."
    deep_water: "Too deep to wade."
    shallow_water: "Shallow enough to wade."
    tree: "Blocks movement and sight."
    open_chest: "Already looted."
    grave: "Here lies someone unlucky."
  }

  # The help screen: each key and what it does. Key names (hjkl, tab,
  # ctrl+c) are keyboard keys and stay as they are; words like "arrows" and
  # "or" are translated.
  help: {
    # max: 26
    key: {
      move: "arrows hjkl yubn"
      wait: ". or 5"
      pickup: "g or ,"
      firebolt: "f"
      nova: "r"
      target: "tab / shift+tab"
      potions: "q / w"
      portal: "t"
      explore: "o"
      inventory: "i"
      character: "c"
      map: "m"
      quit: "Q / ctrl+c"
    }
    does: {
      move: "move / attack (numpad works too)"
      wait: "wait a turn"
      pickup: "pick up equipment (gold & potions are automatic)"
      firebolt: "Firebolt at target (lights up the dark!)"
      nova: "Frost Nova: damage + brief freeze around you"
      target: "next / previous target (or click one)"
      potions: "drink healing / mana potion (works over a few turns)"
      portal: "read Scroll of Town Portal"
      explore: "auto-explore (stops when enemies appear)"
      inventory: "inventory & equipment"
      character: "character sheet, spend attribute points"
      map: "map of explored area"
      quit: "quit"
    }
    tip: {
      walk_into: "Walk into doors, chests, altars and fountains to use them."
      talk: "Talk to townsfolk by walking into them."
      darkness: "Monsters in darkness are invisible until light touches them."
      names: "Blue names are champions; gold names are uniques."
      glow: "Glowing drops are rare or unique. Look for the light."
      upgrade: "Items with ▲ beat what you're wearing."
      hover: "Hover the mouse over the map to see what things are."
      belt: "Click a belt row to drink a potion or read the scroll."
    }
  }

  ui: {
    too_small: "Termablo needs at least 80x24."
    too_small_now: "Current: {w}x{h}"
    # joins a list: "Swift, Vampiric"
    list_sep: ", "
    esc_close: "esc to close"
    # the conversation window
    talk: {
      # max: 18
      barter: "Barter"
      # max: 18
      goodbye: "Goodbye"
      # max: 40
      keys: "↑↓ topic · enter ask · esc goodbye"
    }
    # max: 28
    currently_equipped: "Currently equipped:"
    more_above: "↑ {n} more"
    more_below: "↓ {n} more"
    # after a log line that repeated: "You drink a mana potion. (x3)"
    log: {
      repeat: " (x{n})"
    }

    title: {
      subtitle: "a descent into lit darkness"
      # under the row of languages; ←→ pick one
      begin: "←→ language · enter to begin"
    }

    # floats over a townsperson the Last Wanderer strikes; a word or two
    fx: {
      # max: 8
      cut: "cut"
    }

    # The side panel is 28 cells wide.
    panel: {
      # max: 28
      safe: "Safe haven"
      # max: 28
      area_level: "Area level {n}"
      # max: 28
      not_safe: "Not safe"
      # the hero is always "the Wanderer"
      # max: 23
      hero: "Wanderer  ·  Level {n}"
      # max: 16
      life: "Life"
      # max: 16
      mana: "Mana"
      # max: 28
      experience: "Experience"
      # max: 13
      gold: "Gold {n}"
      # the belt: hotkey, slot wells, then these right-aligned labels
      # max: 9
      belt_portal: "Portal {n}"
      # max: 7
      belt_heal: "Heal"
      # max: 7
      belt_mana: "Mana"
      # max: 14
      damage: "Damage {lo}-{hi}"
      # max: 13
      armor: "Armor {n}"
      # max: 14
      crit: "Crit {n}%"
      # {r}: the torch radius, like 4.5
      # max: 13
      light: "Light {r}"
      # max: 28
      skills: "Skills"
      # max: 20
      firebolt: "Firebolt {lo}-{hi}"
      # max: 20
      nova: "Frost Nova {lo}-{hi}"
      # mana cost; "mp" is mana points
      # max: 5
      mp: "{n}mp"
      # the target's level, short
      # max: 7
      target_lvl: "Lv {n}"
      # max: 28
      frozen: "Frozen"
      # max: 28
      no_enemies: "No enemies in sight"
      # max: 28
      quests: "Quests"
      # the hotkeys
      # max: 28
      keys: "? help  i inv  c char  m map"
    }

    hover: {
      darkness: "Darkness"
      unexplored: "Unexplored, or beyond your light."
      remembered: "Remembered — not currently in sight."
      you: "You — the Wanderer"
      you_stats: "Level {lvl} · Life {hp}/{maxhp} · Mana {mp}/{maxmp}"
      torch: "Torch radius {r}"
      townsfolk: "Townsfolk · walk into them to talk"
      # a monster's rank, level and life
      rank: {
        normal: "Level {lvl} · HP {hp}/{maxhp}"
        champion: "Champion · Level {lvl} · HP {hp}/{maxhp}"
        unique: "Unique · Level {lvl} · HP {hp}/{maxhp}"
        boss: "Boss · Level {lvl} · HP {hp}/{maxhp}"
      }
      hits: "Hits for {lo}-{hi} · armor {armor}"
      # a monster's state, listed with list_sep, the first capitalized
      state: {
        frozen: "frozen"
        unaware: "unaware of you"
        fleeing: "fleeing"
        ranged: "ranged"
        glows: "glows"
      }
      # {item}: what the hero wears in that slot now
      replaces: "Replaces {item}"
      pick_up: "Step on it and press g to pick up"
      portal: "Town Portal"
      # {place}: area.* or region.*
      leads_back: "Leads back to {place}"
      leads_to: "Leads to {place}"
      # after a tile's name: "Stone floor · bloodstained"
      decal: {
        corpse: "a corpse"
        blood: "bloodstained"
        scorch: "scorched"
      }
    }

    # tooltip lines of an equipment item
    item: {
      damage: "Damage: {lo}-{hi}"
      damage_2h: "Damage: {lo}-{hi} (two-handed)"
      armor: "Armor: {n}"
      # {lvl}: item level; {n}: what a merchant pays
      footer: "Item level {lvl}  ·  worth {n}g"
    }

    inv: {
      title: "Inventory"
      # max: 26
      equipped: "Equipped"
      pack: "Pack {n}/{max}"
      empty: "Your pack is empty."
      # beside an item no slot holds yet
      # max: 3
      new: "new"
      # max: 76
      keys: "←→/tab switch · ↑↓ select · enter equip/remove · d drop · esc"
    }

    char: {
      title: "Character"
      hero: "Wanderer · Level {lvl}"
      experience: "Experience {xp} / {next}"
      # max: 14
      attr: {
        str: "Strength"
        dex: "Dexterity"
        vit: "Vitality"
        ene: "Energy"
      }
      # what an attribute point buys
      # max: 26
      attr_desc: {
        str: "+melee damage"
        dex: "+hit, crit, dodge"
        vit: "+life"
        ene: "+mana, spell damage"
      }
      # max: 50
      points: "{n} points to spend — press 1-4"
      # max: 17
      stat: {
        life: "Life"
        mana: "Mana"
        damage: "Damage"
        firebolt: "Firebolt"
        armor: "Armor"
        attack: "Attack"
        crit: "Critical"
        life_steal: "Life steal"
        magic_find: "Magic find"
        kills: "Kills"
      }
    }

    shop: {
      # max: 10
      buy: "Buy"
      # max: 10
      sell: "Sell"
      gold: "Gold: {n}"
      empty: "Nothing here."
      # max: 72
      keys: "tab buy/sell · ↑↓ select · enter confirm · esc leave"
    }

    help: {
      title: "Help"
      scroll: "↑↓ scroll"
    }

    dead: {
      # max: 46
      title: "YOU HAVE DIED"
      # {who}: the killer as in hit.*
      # max: 46
      slain_by: "Slain by {who}"
      # max: 46
      summary: "Level {lvl} · {kills} kills · {gold} gold"
      # {area}: area.*
      # max: 46
      where: "in {area}"
      # max: 46
      keys: "n: new game   Q: quit"
    }
  }

  # ---- game data: one line per row of the Go tables (TestCatalogCoversData)

