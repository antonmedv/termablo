  # The help screen: each key and what it does. Key names (hjkl, tab,
  # ctrl+c) are keyboard keys and stay as they are; words like "arrows" and
  # "or" are translated.
  help: {
    # max: 26
    key: {
      move: "arrows hjkl yubn"
      wait: ". or 5"
      pickup: "g or ,"
      firebolt: "f"
      nova: "r"
      target: "tab / shift+tab"
      potions: "q / w"
      portal: "t"
      explore: "o"
      inventory: "i"
      character: "c"
      map: "m"
      quests: "J"
      quit: "Q / ctrl+c"
    }
    does: {
      move: "move / attack (numpad works too)"
      wait: "wait a turn"
      pickup: "pick up equipment (gold & potions are automatic)"
      firebolt: "Firebolt at target (lights up the dark!)"
      nova: "Frost Nova: damage + brief freeze around you"
      target: "next / previous target (or click one)"
      potions: "drink healing / mana potion (works over a few turns)"
      portal: "read Scroll of Town Portal"
      explore: "auto-explore (stops when enemies appear)"
      inventory: "inventory & equipment"
      character: "character sheet, spend attribute points"
      map: "map of explored area"
      quests: "quest journal (or click the quests in the panel)"
      quit: "quit"
    }
    tip: {
      walk_into: "Walk into doors, chests, altars and fountains to use them."
      talk: "Talk to townsfolk by walking into them."
      darkness: "Monsters in darkness are invisible until light touches them."
      names: "Blue names are champions; gold names are uniques."
      glow: "Glowing drops are rare or unique. Look for the light."
      upgrade: "Items with ▲ beat what you're wearing."
      hover: "Hover the mouse over the map to see what things are."
      belt: "Click a belt row to drink a potion or read the scroll."
    }
  }

  ui: {
    too_small: "Termablo needs at least 80x24."
    too_small_now: "Current: {w}x{h}"
    # joins a list: "Swift, Vampiric"
    list_sep: ", "
    esc_close: "esc to close"
    # the conversation window
    talk: {
      # max: 18
      barter: "Barter"
      # max: 18
      goodbye: "Goodbye"
      # max: 40
      keys: "↑↓ topic · enter ask · esc goodbye"
    }
    # The quest journal (J): the quests given down one side, the one picked
    # on the other.
    journal: {
      title: "Quests"
      # max: 40
      keys: "↑↓ quest · esc close"
      none: "No one has asked anything of you yet. Talk to the townsfolk of Emberhold."
      # what to do now. {name}: the boss as its name reads ("The Bone
      # King"), a noun
      goal: "{name} must be destroyed."
      # the boss is dead and the giver yet to pay. {who}: who gave the
      # quest ("Captain Voss"), a noun
      return: "Return to {who} for your reward."
      over: "Completed."
      # {who}: who gave the quest, a noun
      giver: "Given by {who}"
      # {area}: where the boss waits, an area name
      where: "Where: {area}"
      reward: "Reward: gold, and a unique item"
    }
    # max: 28
    currently_equipped: "Currently equipped:"
    more_above: "↑ {n} more"
    more_below: "↓ {n} more"
