      dreadhowl: "Dreadhowl"
      cinderjaw: "Cinderjaw"
      wormheart: "Wormheart"
    }
    last: {
      the_hungry: "the Hungry"
      the_vile: "the Vile"
      the_unburied: "the Unburied"
      the_defiler: "the Defiler"
