# Termablo's text, in English: the source every translation is made
# from and the fallback for any key a translation lacks. The runbook is
# docs/translating.md; the terms live in locales/glossary.maml.
#
# A value is a string, or an object:
#   - plural forms, chosen by the count {n}:   { one: "...", other: "..." }
#   - gender forms, chosen by a noun argument:  { m: "...", f: "...", n: "..." }
#   - a noun that other words agree with:       { text: "...", gender: "f" }
# Placeholders are {name}; {{ is a literal brace. Comments above a key are
# context for translators. "# max: N" limits the key (and everything inside
# it) to N terminal cells; a CJK character takes two.
{
  # The message log: whole sentences, the first letter capitalized by the
  # game. A monster in a message comes as {who}: already carrying its
  # article ("the Plague Rat", "a Fire Imp") or a proper name ("Bloodmaw
  # the Hungry"), in the nominative. Translations should keep {who} as the
  # sentence's subject so no other case is needed.
  msg: {
    welcome_help: "Press ? for help. Captain Voss by the tavern has work for you."
    # {area}: the level's name, area.*
    enter: "You enter {area}."
    far_beyond: "Something here is far beyond you."
    fountain: "The cold water closes your wounds."
    portal_step: "You step through the portal."
    portal_collapse: "The portal collapses behind you."
    portal_open: "A shimmering blue portal tears open."
    # {item}: an item's name, no article. "g" is the pick-up key.
    see_item: "You see {item} here. (g to pick up)"
    see_items: "Several items lie here. (g to pick up)"
    pickup_gold: "You pick up {n} gold."
    # {item}: "Healing Potion" or "Mana Potion"
    pickup_potion: "You pick up a {item}."
    belt_no_room: "Your belt has no room for another {item}."
    # {item}: "Scroll of Town Portal"
    pickup_scroll: "You pick up a {item}."
    pickup_item: "You pick up {item}."
    pack_full: "Your pack is full."
    pack_too_full: "Your pack is too full to swap that."
    nothing_to_pick_up: "There is nothing here to pick up."
    notice_item: "You notice something on the ground."
    explored: "Nothing left to explore here."
    # {who}: a monster as met for the first time, ref.a ("a Fire Imp")
    spot: "You spot {who}."
    # A boss dies; {who} is its name ("The Bone King").
    boss_destroyed: "{who} has been destroyed!"
    # A champion or unique dies.
    elite_slain: "{who} is slain!"
    monster_dies: "{who} dies."
    out_of_range: "{who} is out of range."
    no_target: "No target in sight."
    no_mana: "Not enough mana."
    # {n}: the new character level; "c" opens the character sheet
    level_up: "You have reached level {n}! (c to spend 5 attribute points)"
    open_chest: "You open the chest."
    altar_cold: "The altar is cold now."
    altar_restore: "Blood-light washes over you. You are restored."
    altar_xp: "Forbidden knowledge floods your mind. (+{n} XP)"
    altar_gift: "The altar offers up a gift."
    # {who}: what killed the hero, as in hit.*
    slain: "You have been slain by {who}."
    no_healing_potions: "You have no healing potions."
    full_life: "You are already at full life."
    drink_healing: "You drink a healing potion."
    no_mana_potions: "You have no mana potions."
    full_mana: "Your mana is already full."
    drink_mana: "You drink a mana potion."
    already_in_town: "You are already in town."
    no_scrolls: "You have no Scrolls of Town Portal."
    boneking_raises: "The Bone King raises the dead!"
    boneking_greets: "The Bone King: \"Another torch to snuff. Kneel, and join my court.\""
    boneking_dead: "The crypts fall silent. Return to Captain Voss."
    oracle_reforms: "The Oracle dissolves into mist and reforms."
    oracle_lights: "Cold lights gather around the Oracle."
    oracle_greets: "The Drowned Oracle: \"I have seen your ending, little flame. It is wet and cold.\""
    oracle_dead: "The Oracle's song ends. Deeper still, something burns... Return to Voss."
    wanderer_greets: "The Last Wanderer: \"Another stranger. They always send a stranger.\""
    wanderer_portal: "The Last Wanderer steps out of the portal. It collapses behind him."
    wanderer_follows: "The Last Wanderer follows you."
    wanderer_home: "The Last Wanderer: \"You showed me the way home.\""
    # {who}: a townsperson, the object: "a Villager", "Mirela the Alchemist"
    wanderer_cuts: "The Last Wanderer cuts {who}."
    wanderer_kills: "The Last Wanderer cuts down {who}."
    wanderer_taunt: "The Last Wanderer: \"They gave me a sword and a captain's speech too.\""
    town_empty: "No one is left in Emberhold but you."
    forge_cold: "Hadrik's forge goes cold."
    wanderer_last_words: "The Last Wanderer: \"Keep walking.\""
    wanderer_dead: "The red light goes out, and the dark lets go of the fire."
    unseal_here: "Where he waited, a way down opens."
    unseal_far: "Far below, in the Hearth, a way down opens."
    # A townsperson while the Last Wanderer hunts the town; {who} is the
    # townsperson as the subject.
    running: "{who} is running for their life."
    # A townsperson pays for a finished quest. {who}: their name ("Captain
    # Voss"); {n}: gold; {item}: the unique they hand over. Only Voss pays
    # for now; where a verb agrees with {who}, write it for a man
    quest_reward: "{who} gives you {n} gold and {item}."
    # Someone in town has asked the hero to kill a boss. {name}: the
    # boss's name ("Bone King"), as the quest list shows it
    quest_new: "New quest: {name}."
    # The hero has come upon something the townsfolk can be asked about.
    # {topic}: the topic's name, as the conversation's list shows it
    topic_new: "You could ask in town about: {topic}."
    cannot_afford: "You cannot afford that."
    belt_full: "Your belt is full."
    # Hadrik's gamble: {item} the item it turned out to be, {n} the price
    gamble: "Hadrik unwraps {item}. {n}g, no refunds."
    reroll: "Hadrik hauls out fresh stock for {n}g."
    bought: "Bought {item} for {n}g."
    sold: "Sold {item} for {n}g."
    equip: "You equip {item}."
    unequip: "You remove {item}."
    drop: "You drop {item}."
    # Mirela, the alchemist, calls the hero "dear". {n}: gold paid
    mirela_healthy: "Mirela looks you over. \"Hale as an ox. Buy something, dear.\""
    mirela_free: "Mirela tends your wounds. \"No charge for the young. Now buy something, dear.\""
    mirela_broke: "Mirela shakes her head. \"Herbs cost coin, dear.\""
    mirela_partial: "Mirela does what your {n}g allows. \"Come back with more, dear.\""
    mirela_paid: "Mirela tends your wounds for {n}g. \"There. Now buy something, dear.\""
  }

  # How a monster is referred to in messages. {name} is a monster noun;
  # write gender forms where the article agrees. Named monsters (uniques,
  # bosses, Hadrik, Mirela, Voss) skip these and appear by name.
  ref: {
    # the monster as a known subject: "the Plague Rat"
    the: "the {name}"
    # a monster first seen: "a Plague Rat"; English uses "an" for the nouns
    # marked gender "an"
    a: { other: "a {name}", an: "an {name}" }
    # a fire-enchanted monster's dying blast, the subject of hit.burn; may
    # be a noun { text, gender } so hit.burn can agree with it
    death_flames: "{name}'s death flames"
  }

  # Spoken lines, shown in the conversation window. Multi-line values are
  # dialogues, one paragraph a line. [words](topic) is a link: the words
  # are shown highlighted, and hearing them teaches the hero the topic
  # (topic.<id>). Translate the words, keep the (topic) as it is.
  #
  # talk.<who>.greet is what a speaker says on meeting the hero, and
  # talk.<who>.<topic> what they say when asked. Speakers remember: a line
  # they have said before gives way to its <line>_again. What the town
  # knows changes them too: <line>_boneking, _oracle and _wanderer are
  # news, said once that boss is dead (and, for the first two, once its
  # quest has been paid for). Only the newest news is told, after the
  # plain line has been said once, and only once unless it has an
  # _again. Some lines give the hero a quest (quest.go). <topic>_after
  # is said for good once the topic's boss is dead.
  #
  # <line>_hurt, _kingsbane, _crown, _nopots and _broke remark on how the
  # hero looks as they walk up: badly hurt, wearing Kingsbane (Voss's
  # father's axe) or the Hollow Crown (the Bone King's), no healing
  # potion on the belt, or not the coin for one. Said whenever it holds,
  # over anything said before; news not yet told comes first.
  #
  # desc is not said but seen, in gray before the greeting: how the
  # speaker looks to the hero, in the voice of the log, present tense:
  # the person, never where they stand.
  # Its _again is a glance on later visits; a fact's variant tells what
  # has changed since.
  #
  # Each fact has one owner, who tells it best; the rest point the hero
  # to them. talk.any is the town's voice, for anyone with no line of
  # their own, but not Aldous or Pell: they came back from below and
  # speak only for themselves.
  talk: {
    # Hadrik is gruff and few-worded. He keeps the forge, which keeps the
    # Ember, and knows it.
    hadrik: {
      desc: "A broad, bald man in a scorched leather apron, soot-black to the elbows. His forearms are pocked with small white burn scars, and he breathes slow and deep, like a bellows."
      desc_again: "Hadrik, soot to the elbows, hammer in hand. He doesn't look up."
      desc_wanderer: "There is a white-gold glow on Hadrik's face, and for once he looks rested. He's watching you, not the fire."
      desc_wanderer_again: "Hadrik hums as he works. He looks rested."
      greet: "Steel for the dark. Take a look. The [forge](forge) is hot; it always is."
      greet_again: "Back. What needs mending?"
      greet_boneking: "Heard the crypt bells this morning. Thought I'd gone soft in the head. Your doing? Then you've earned the good steel."
      greet_oracle: "Last [stranger](stranger) I armed for the deep never came back for repairs."
      greet_wanderer: "The forge flared white when he fell, then settled. Forty years, never seen her do that. You're welcome at this anvil."
      greet_hurt: "You're bleeding on my anvil. Mirela first. Steel after."
      greet_broke: "Looking's free. The rest isn't."
      greet_kingsbane: "Kingsbane. I put the last edge on that axe, for the captain's [father](father). Show it to Voss. Or don't."
      greet_kingsbane_again: "Keep that edge oiled. It's earned it."
      greet_crown: "Take that crown off in my forge. It makes the fire nervous."
      greet_crown_again: "Crown. Off."
      forge: "Forty years I've kept her. The keeping passes hand to hand, smith to smith. What burns in her belly is the [Ember](ember) itself. The day she goes out, we run. That's not a saying."
      ember: "Folk think it sits in the square on a pedestal. It lives in my forge. Every lantern in town is lit from here. I don't talk about that, and neither will you."
      ember_again: "I said I don't talk about that."
      stranger: "Bought the same sword you did. Paid in old coin, didn't haggle. Went past the marsh and kept going. I still have his whetstone. He'll want it back."
      stranger_after: "So he came home after all. I'll put his whetstone in the fire tonight."
      cult: "They came to me first, the [Ember Cult](cult). Wanted me to let the fire go out and be done owing. I showed them the door with a hammer in my hand."
      portals: "Forge ash, folded in paper. Every spark knows the way home to the hearth, so the ash does too. I sweep it, Mirela folds it."
      aldous: "Aldous was one of them. Now he sits with the graves and tells anyone who stops that the [Ember](ember) is a wound. Maybe it is. A wound's better than a grave. Don't tell him I said maybe."
      pell: "The boy by the fountain. Came to the forge once to get warm. Stood by the fire an hour and didn't thaw."
    }
    # Mirela, in her late thirties, is a schoolmistress with a healer's
    # hands: firm, never soft, and worried for the hero all the same.
    # Her crystal hears the Oracle.
    mirela: {
      desc: "A handsome woman in her late thirties, her full figure laced into a dark bodice, her hair pinned up without a strand out of place. A pale crystal hangs at her throat, humming faintly. She looks you over the way a schoolmistress looks over a torn copybook."
      desc_again: "Mirela folds her arms beneath the crystal at her throat and waits for you to explain yourself."
      desc_oracle: "Mirela turns the crystal at her throat over and over in her fingers. It is silent, and gray as river stone. For once her back is not quite straight."
      desc_oracle_again: "The crystal at Mirela's throat is gray and silent. She doesn't touch it."
      greet: "Sit, sit. You smell of smoke and grave-dust. Let's see what's broken."
      greet_again: "Back again, dear? Let me look at you."
      greet_boneking: """
The crypt bells woke me this morning. I cried, dear, and I don't know why.
Voss will send you after [her](oracle) next. Before you go, ask me about her. Please."""
      greet_oracle: """
It's so quiet, child. My crystal hasn't made a sound since you came up.
I'm not angry, dear. You did what you were paid to do. But put your hand on the floor. It's warm."""
      greet_wanderer: "You came back. He never did, not really. Sit, dear, and let me see to those burns."
      greet_hurt: "Oh, child, look at you. Sit down before you fall down."
      greet_nopots: "Not one flask on your belt? Down there? Sit, dear. We'll fix that."
      greet_crown: "Take that crown off at my table, dear. It whispers, and I don't take lessons from jewelry."
      greet_crown_again: "The crown, dear. Off."
      oracle: """
My crystal came out of her grotto. When she dreams, it sings. She isn't hunting anyone, child. She is holding something down, under the water. I don't know what. I know it's hot.
Voss calls it ending her. I call it opening a door. Go down if you must, but listen before you lift your blade."""
      oracle_again: "I've told you what my crystal tells me. Voss has a sword and I have a rock that sings. You choose which to believe."
      oracle_after: "My crystal has stopped singing. The whole town sleeps sound now. I don't. Whatever she held down is coming up through the [Abyss](abyss)."
      blackmarsh: "The standing stones are hers. She raised them on her way into the water, the way Edran raised his altars. The lights aren't hunting, dear. They're asking. [Pell](pell) said yes."
      abyss: "Beneath her pool the rock burns. It's where the coal was cut from, if you believe the old songs. I've started to."
      ember: "Warm light came up from below. My kind, the cold kind, came from her. The town lives between the two and thinks it lives by one."
      pell: "Poor lamb. The water got into him. He hears her the way my crystal does, only he can't set her down on a shelf at night."
      pell_oracle: "He hasn't said a word since my crystal went quiet. I sit with him in the evenings. He doesn't seem to mind."
      pell_oracle_again: "Still not a word. I bring him soup. He doesn't eat it, but he holds the bowl."
      pell_wanderer: "He talked this morning, dear! He asked for bread. Just bread. I cried again."
      pell_wanderer_again: "He's cold, but he's eating. That's a start."
    }
    # Captain Voss is earnest and clipped. He believes the town's story.
    voss: {
      desc: "A lean man in a dented breastplate, a black band tied around one sleeve. He stands like a man who hasn't sat down in years."
      desc_again: "Voss, one hand on his sword, the black band on his sleeve."
      desc_boneking: "Voss stands a little easier. The black band is gone from his sleeve."
      desc_boneking_again: "Voss, one hand on his sword. His sleeve is bare."
      greet: """
Wanderer. Good. We need a blade that doesn't shake.
Four floors under the [crypt](crypt), east past the fields, the [Bone King](boneking) sits his throne of ribs. Destroy him.
Keep a [portal scroll](portals) on you. Come back alive."""
      greet_again: "Still breathing. Good. The [Bone King](boneking) is four floors under the [crypt](crypt). Bring me his dust."
      boneking_reward: """
The Bone King is dust? Then the crypt bells may ring again.
Take this — it was [my father's](father). And the gold, of course."""
      oracle_reward: """
The Oracle, silenced... I never thought I'd sleep without hearing her.
Beneath her pool, the rock burns. [The Abyss](abyss) has no floor, they say. Be careful.
I sent [someone](stranger) down there once. I stopped counting the days."""
      greet_boneking: """
The crypt is quiet. Now: [Blackmarsh](blackmarsh), north of the fields.
Follow the cold lights down into the grotto. End the [Oracle](oracle)."""
      greet_boneking_again: "[Blackmarsh](blackmarsh), north of the fields. Follow the cold lights down. Don't let them follow you back."
      greet_oracle: """
You've done more than any of us dared.
Mirela says the wind smells of the forge now. Let her. If you must go deeper, [the Abyss](abyss) waits below the Oracle's pool."""
      greet_oracle_again: "Whatever waits in [the Abyss](abyss) is past my maps. Go carefully, or don't go."
      greet_wanderer: """
The lanterns are lit again. Whoever he was, he was one of ours once.
Keep walking, stranger. It is what we hire you for."""
      greet_wanderer_again: "The watch sleeps in shifts again. That's your doing. Don't make a speech of it."
      greet_hurt: "You're bleeding on my gate. See Mirela, then see me."
      greet_kingsbane: "That axe. Kingsbane. My [father](father) carried it down. Keep it. He'd rather it swung than rusted."
      greet_kingsbane_again: "Still carrying it. Good."
      greet_crown: "Is that the [Bone King's](boneking) crown? Don't wear it in the square. People remember."
      greet_crown_again: "The crown, stranger. Not in my square."
      crypt: "The royal crypt, east past the Ashen Fields. Four floors, cold and dusty. The braziers light themselves. Don't stand near them."
      boneking: "Four floors under the chapel, on a throne of ribs. My [father](father) went down after him with an axe. Bring me his dust."
      boneking_after: "Dust, you say. Good. I'll believe it when I hear the bells."
      father: "He took Kingsbane into the [crypt](crypt) and didn't come back. The guard chose me the next morning. There was no one else to choose."
      father_again: "I told you what there is. Leave it."
      father_after: "You brought back what was his. That's more than the rest of us managed. Don't ask me more."
      oracle: """
She drowned herself in the grotto under [Blackmarsh](blackmarsh), and now she calls the lost down after her. End it.
Mirela will tell you she's holding something down. Mirela listens to a rock. I bury the people that rock sings to."""
      oracle_after: "Silenced. I sleep now. Strange, how loud a quiet can be."
      stranger: "There was one before you. Good with a blade. I sent him past the Oracle's pool. I don't hire twice for the same job, as a rule."
      stranger_after: "Whoever he was, he was one of ours once. Leave it there."
      cult: "Traitors. A generation back they went down to give the fire back. Some of them are still down there, giving."
      aldous: "The Cult's leftover. I let him sit with the graves because the dead don't listen to him. You shouldn't either."
      pell: "The boy went after the marsh lights and came back cold. When she's gone, he'll warm up. That's what I tell his sister."
      pell_oracle: "The boy hasn't said a word since you came up. Give him time. The cold takes a while to leave."
      pell_oracle_again: "Give the boy time."
    }
    # Brother Aldous was of the Ember Cult, went down to the Abyss with
    # them, and alone came back, burned. Bitter, wry, unafraid. He knows
    # what the town will not: the Ember is a wound, the Oracle its dam.
    aldous: {
      desc: "A gaunt man in a cultist's robe. One side of him is burned to a shine, the eye on that side milk-white. The other side smiles at you."
      desc_again: "Aldous, the burned side of his face turned away from the light."
      desc_oracle: "Aldous keeps one palm pressed flat to the earth, as if feeling for a heartbeat."
      desc_oracle_again: "Aldous keeps one hand on the ground. He doesn't lift it to greet you."
      greet: "Another of Voss's blades. Sit, if you like; the graves don't mind company. Ask me about the [Cult](cult). The town will tell you what we were. I'll tell you what we saw."
      greet_again: "Still breathing. The fire hasn't made up its mind about you."
      greet_boneking: "So Edran's lying down at last. You did him a kindness. He'd thank you, if the dark had left him a mouth."
      greet_oracle: "Put your hand on the ground. Warm, isn't it? That's what she was holding. You've pulled out the stopper, Wanderer. Now we see what comes up."
      greet_oracle_again: "Warmer today. Warmer still tomorrow."
      greet_wanderer: "He was what the fire wants every one of us to become. You put him down. It will make another. It's patient. So am I."
      greet_hurt: "Bleeding? Go and see Mirela. The fire likes the smell of it."
      greet_crown: "Edran's crown. Can you hear it yet? You will."
      cult: "We weren't traitors. We were the only ones who listened. The [Ember](ember) was never ours, so we went down to give it back. The fire was glad to see us. It remade the ones who stayed. I ran. That's the whole of my heresy."
      ember: "The town says Edran carried it up. He cut it out. The dark isn't hungry, Wanderer. It's a wound trying to close, and Emberhold is the splinter. Ask Hadrik why he never sleeps."
      edran: "A thief with a crown. His own [Oracle](oracle) begged him to put it back. He kept it, and the dark took his face for the fee."
      abyss: "I've been where you're going. The rock bleeds there. It's where Edran cut the coal, and it never closed. Whatever it was cut from is down there, and it's awake."
      abyss_after: "It's open now. Smell the wells. What comes up next won't be small, and it won't be stupid."
      oracle: "She's the only one of us who paid properly. She lay down in the water to keep the fire off our backs, and she's held it for generations. Voss wants her dead. Of course he does. He's never once looked below his own boots."
      oracle_after: "She held it for generations. You undid it in an afternoon. I'm not judging. I ran, remember."
      stranger: "I passed him on my way up, below the pool. He asked how far down it went. I told him the truth: all the way. He thanked me. He was smiling."
      stranger_after: "So that's what the fire makes of a man who walks all the way down to it. I'd hoped it was only angry with me."
      pell: "The boy hears her. I hear the other one. Between us we make one bad night's sleep."
      aldous: "Brother. There's no order left to be a brother of. Keep the title if you like; it's all I brought back."
    }
    # Pell followed the marsh lights and came back cold: the Oracle speaks
    # through him, a little. A child, few words, no fear. When she dies he
    # goes silent; when the Last Wanderer does, he is only a boy again.
    # Lines in parentheses are what he does, not what he says.
    pell: {
      desc: "A thin boy of nine or ten. His hair is wet though it hasn't rained, his lips are faintly blue, and he doesn't shiver."
      desc_again: "Pell, his hair still wet."
      desc_oracle: "Pell hugs his knees and stares past you, as if something owes him an answer."
      desc_oracle_again: "Pell, knees drawn up, staring past you."
      desc_wanderer: "Pell is wrapped in a blanket too big for him, a heel of bread in his hands. He is shivering. His lips are pink."
      desc_wanderer_again: "Pell in his blanket, shivering and chewing."
      greet: "You're warm. Everyone up here is warm."
      greet_again: "The water's talking again. Not to you."
      greet_boneking: "The bells. She felt them, under the marsh. She's tired. Holding is hard when you're the only one."
      greet_oracle: "(Pell watches the fountain and says nothing. The water is very still.)"
      greet_oracle_again: "(Pell doesn't look up.)"
      greet_wanderer: "I'm cold. I've never been cold before. Is this what it's like, being only me?"
      greet_wanderer_again: "My sister says I can go to the marsh again. I don't think I want to."
      oracle: "She's cold so we don't burn. She asked me to hold a little of it for her. I said yes. Now I'm cold too."
      oracle_after: "(Pell shakes his head. He won't speak of her.)"
      blackmarsh: "The lights didn't call. They asked. Most people say yes. I said yes."
    }
    # Villagers only describe; what they say is a rumor.
    villager: {
      desc: "A townsperson in a soot-gray cloak, who keeps glancing at the nearest lantern."
    }
    # What anyone in town says when they have nothing of their own to say.
    any: {
      ember: "King [Edran](edran) carried the Ember up from below in his bare hands. Every lantern in Emberhold is lit from Hadrik's [forge](forge), and the forge from the Ember. The dark stops at the gate."
      edran: "The first king. He went down alone and came up with fire. The dark took his face for it, then his skull. He raised [altars](altars) on the way up; some still stand."
      altars: "Edran left a drop of his blood on each, to buy another hour of safe passage. Bleed on one yourself and the bargain pays out. Once."
      forge: "Hadrik's forge hasn't gone out in forty years. Ask him about it, if you like being glared at."
      portals: "Read a portal scroll and you're back at the fountain square. Hadrik sweeps the ash for them, Mirela folds it. Ask him why it works."
      crypt: "The royal crypt, east of the gate past the Ashen Fields. King [Edran](edran) lies there with his court. Lies is a generous word. The captain knows it best."
      boneking: "He sits his throne of ribs four floors down, under a hollow crown. They say he isn't finished being king."
      boneking_after: "The Bone King is dust, they say. The crypt bells may ring again."
      father: "The captain's father took an old axe into the crypt. The captain doesn't talk about it. Neither should you."
      blackmarsh: "North of the fields. Cold lights drift over the water. Don't follow them. Everyone follows them. Mirela listens to that water; ask her."
      oracle: "The king's own Oracle. She told him not to take the coal. When he wouldn't listen she walked into the water under [Blackmarsh](blackmarsh) and never came up."
      oracle_after: "The marsh lights have gone out. People say it's over. Mirela doesn't say anything."
      abyss: "Under the Oracle's pool the rock burns. They say the Abyss has no floor. The [Ember Cult](cult) went that way."
      cult: "A generation ago some folk decided the dark was owed its coal. They went down to pay. The fire remade them. One came back: [Brother Aldous](aldous), by the graves. Don't get him started."
      stranger: "Ask Hadrik. He sold him his sword, and kept something of his."
      aldous: "Came back from the Abyss last winter, burned down one side. Calls himself Brother. Sits in the graveyard and talks to the stones."
      pell: "The boy by the fountain. Went after the marsh lights and came back cold. His sister won't say his name after dark."
      stranger_after: "The lanterns are lit again. Nobody says his name. Nobody knew it."
    }
  }

  # The quest journal's entries, journal.<quest>.<stage>: written when
  # the quest is given (taken), when its boss dies (done), and when its
  # giver pays (rewarded), and shown in that order. Second person, the
  # voice of the log; a stage may come without the one before it: a boss
  # killed before anyone asked is still paid for.
  journal: {
    boneking: {
      taken: "Captain Voss wants the Bone King destroyed. He sits his throne of ribs four floors under the Crypt of the Fallen, east of the gate past the Ashen Fields. Voss's father went down after him with an axe and did not come back."
      done: "The Bone King is dust, and the crypts have fallen silent. Voss will want to hear it from you."
      rewarded: "Voss paid in gold, and gave you something that was his father's. The crypt bells may ring again."
    }
    oracle: {
      taken: "Voss wants the Drowned Oracle ended. She walked into the water under Blackmarsh, north of the fields, and calls the lost down after her. Follow the cold lights down into the Sunken Grotto."
      done: "The Oracle's song has ended. Deeper still, something burns. Voss should hear of it."
      rewarded: "Voss paid, and warned you: beneath her pool the rock burns, and the Burning Abyss has no floor."
    }
    wanderer: {
      taken: "Something came up out of the Abyss when the Oracle fell. Every light goes out near it, and it looks like you: the stranger Emberhold hired before you. Stop the Last Wanderer before he reaches the forge."
      done: "The Last Wanderer has fallen. The dark let go of the fire, and the lanterns of Emberhold burn again."
    }
  }

  # The topics of conversation, as the list beside it shows them, sorted
  # by these names.
  # max: 18
  topic: {
    rumors: "Latest rumors"
    ember: "Ember"
    edran: "King Edran"
    altars: "Altars"
    forge: "Forge"
    portals: "Portal scrolls"
    crypt: "Crypt"
    boneking: "Bone King"
    father: "Voss's father"
    blackmarsh: "Blackmarsh"
    oracle: "Drowned Oracle"
    abyss: "Burning Abyss"
    cult: "Ember Cult"
    stranger: "Stranger"
    aldous: "Brother Aldous"
    pell: "Pell"
  }

  # What villagers say, one picked at random, those not yet heard first.
  # Rumors; most are true. Some are only told once a boss is dead and its
  # quest paid for, some no more after (talk.go). [words](topic) is a
  # link, as in talk.
  rumor: {
    braziers: "They say the braziers in the [crypt](crypt) light themselves at dusk. Nobody tends them."
    brother: "My brother [Pell](pell) went into [Blackmarsh](blackmarsh) after the lights. He came back wet. He came back wrong. Now he sits by the fountain and listens to it."
    torch: "Keep your torch high. The dark down there isn't empty — it's hungry."
    forge: "[Hadrik's forge](forge) hasn't gone out in forty years. He says the day it does, we run."
    glimmer: "Rare things glimmer in the dark. Gold-light means something old and named."
    crystal: "Mirela's crystal was dug out of the grotto. It sings when the [Oracle](oracle) dreams."
    scroll: "A [portal scroll](portals) is cheaper than a funeral."
    stranger: "There was a [stranger](stranger) before you. Bought the same sword. Went past the marsh and kept going."
    edran: "[King Edran](edran) carried the [Ember](ember) up in his bare hands. It cost him his face."
    uncle: "My uncle joined the [Ember Cult](cult). Said the dark was owed. He went down to pay it, and came back last winter, what's left of him. [Brother Aldous](aldous), he calls himself now."
    holding: "Mirela says the [Oracle](oracle) isn't hunting anyone. She's holding something down."
    # once the Bone King is dead
    bells: "The crypt bells rang this morning. Nobody has pulled those ropes in thirty years."
    face: "They say the Bone King wore [King Edran's](edran) face, once. Or what the dark left of it."
    # once the Oracle is dead
    lights: "The cold lights over [Blackmarsh](blackmarsh) have gone out. My brother slept the whole night through."
    wind: "Hot wind comes up the marsh wells now. Smells like a smithy. Like [the Abyss](abyss), Mirela says."
    # once the Last Wanderer is dead
    lanterns: "The lanterns burn steadier since you came up. Nobody says why. Nobody needs to."
  }

  # Level names, as the side panel, the map and the log show them.
  # max: 26
  area: {
    town: "Emberhold"
    fields: "Ashen Fields"
    marsh: "Blackmarsh"
    # {n}: the floor, 1 to 3
    crypt: "Crypt of the Fallen {n}"
    throne: "Throne of the Bone King"
    grotto: "Sunken Grotto {n}"
    oracle_pool: "The Oracle's Pool"
    abyss: "The Burning Abyss {n}"
    hearth: "The Hearth Below"
  }

  # Where a path leads, before the level there exists: "Leads to {place}".
  region: {
    town: "Emberhold"
    fields: "the Ashen Fields"
    marsh: "Blackmarsh"
    crypt: "the Crypt of the Fallen"
    grotto: "the Sunken Grotto"
    abyss: "the Burning Abyss"
  }

  # Logged the first time the hero enters a level; {area} is its name.
  lore: {
    town: "Emberhold. The last lit town before the dark. Lanterns burn all night here."
    fields: "The Ashen Fields. Moonlight on the ash of a burned forest."
    marsh: "Blackmarsh. Cold lights drift over the water. Do not follow them."
    crypt: "{area}. A royal tomb; the air tastes of dust."
    grotto: "{area}. Cold water presses down; the crystals hum."
    abyss: "{area}. The rock itself is bleeding."
    hearth: "{area}. The braziers lean away from the middle of the room."
  }

  shop: {
    smith: "Hadrik's Forge"
    alch: "Mirela's Remedies"
  }

  item: {
    # {n} gold coins on the ground or in a shop list
    gold: "{n} gold"
    healing_potion: "Healing Potion"
    mana_potion: "Mana Potion"
    town_portal_scroll: "Scroll of Town Portal"
    # one of Hadrik's gambles; {base} is a gamble.* noun
    unidentified: "Unidentified {base}"
    fresh_stock: "Fresh stock"
    # A Magic item: prefix.*, base.*, suffix.*; either affix may be empty
    # and spaces around an empty one are dropped. Reorder freely.
    magic: "{prefix} {base} {suffix}"
    # A Rare item: rare.first.* and rare.second.*
    rare: "{first} {second}"
    # Tooltip lines of potions, scrolls and Hadrik's services; one line each.
    desc: {
      healing_potion: "Restores a large portion of life"
      mana_potion: "Restores a large portion of mana"
      town_portal_scroll: "Opens a portal back to Emberhold"
      unidentified: """
Hadrik's pick from the depth you have reached.
Could be anything. No refunds."""
      fresh_stock: "Hadrik hauls out new stock, and Mirela does too."
    }
  }

  # A Rare or Unique item's kind under its name: "Rare Chain Mail".
  rarity: {
    rare: "Rare {base}"
    unique: "Unique {base}"
  }

  # Equipment slots, the inventory's left column.
