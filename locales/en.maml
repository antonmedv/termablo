    wisp: "Will-o'-Wisp"
    drowned: "Drowned Dead"
    horror: "Marsh Horror"
    spider: "Grotto Spider"
    golem: "Crystal Golem"
    imp: "Fire Imp"
    hellspawn: "Hellspawn"
