  # Unique items: a proper name (a noun, it may carry a gender) and a line of
  # flavor. See docs/lore.md, "Named things".
  unique: {
    last_wanderers_shroud: {
      name: "Last Wanderer's Shroud"
      flavor: "Still warm. It was never yours, and now it is."
    }
    wanderers_shroud: {
      name: "Wanderer's Shroud"
      flavor: "Worn by one who never stopped walking."
    }
    shard_of_night: {
      name: "Shard of Night"
      flavor: "It drinks the torchlight."
    }
    hollow_crown: {
      name: "Hollow Crown"
      flavor: "The king it belonged to did not need a skull."
    }
    emberbrand: {
      name: "Emberbrand"
      flavor: "Its edge never cools."
    }
    the_last_lantern: {
      name: "The Last Lantern"
      flavor: "It burns when all else is dark."
    }
    moonstride: {
      name: "Moonstride"
      flavor: "Footsteps like falling snow."
    }
    band_of_ashes: {
      name: "Band of Ashes"
      flavor: "Warm to the touch, always."
    }
    gravewardens_coat: {
      name: "Gravewarden's Coat"
      flavor: "Stitched from the shrouds of the unquiet."
    }
    eye_of_the_deep: {
      name: "Eye of the Deep"
      flavor: "It blinks when you are not looking."
    }
    crown_of_the_drowned: {
      name: "Crown of the Drowned"
      flavor: "Water still drips from its rim."
    }
    bloodfist: {
      name: "Bloodfist"
      flavor: "Never clean. Never dry."
    }
    kingsbane: {
      name: "Kingsbane"
      flavor: "Seven crowns have rolled beneath it."
    }
    starfall_plate: {
      name: "Starfall Plate"
      flavor: "Forged from a fallen star; it remembers the sky."
    }
  }

  # What an unidentified item from Hadrik is called by its slot: see item.unidentified.
  gamble: {
    weapon: "Weapon"
    shield: "Shield"
    helm: "Helm"
    armor: "Armor"
    gloves: "Gloves"
    boots: "Boots"
    ring: "Ring"
    amulet: "Amulet"
  }

  # Monsters and townsfolk by ID: nouns. English marks the nouns that take
  # "an" with gender "an". Names starting "The" are bosses, used without an article.
  monster: {
    rat: "Plague Rat"
    bat: "Cave Bat"
    fallen: "Fallen One"
