# Termablo in German. Translated from en.maml; see docs/translating.md.
# Plural forms: one, other. Genders: m, f, n, pl.
{
  msg: {
    welcome_help: "Drücke ? für Hilfe. Hauptmann Voss bei der Taverne hat Arbeit für dich."
    enter: "Gebiet betreten: {area}."
    far_beyond: "Etwas hier ist dir weit überlegen."
    fountain: "Das kalte Wasser schließt deine Wunden."
    portal_step: "Du trittst durch das Portal."
    portal_collapse: "Das Portal fällt hinter dir in sich zusammen."
    portal_open: "Ein schimmerndes blaues Portal reißt auf."
    see_item: "Hier liegt etwas: {item}. (g zum Aufheben)"
    see_items: "Hier liegen mehrere Gegenstände. (g zum Aufheben)"
    pickup_gold: "Du hebst {n} Gold auf."
    pickup_potion: {
        m: "Du hebst einen {item} auf."
        f: "Du hebst eine {item} auf."
        n: "Du hebst ein {item} auf."
        other: "Du hebst einen {item} auf."
      }
    belt_no_room: {
        m: "In deinem Gürtel ist kein Platz für noch einen {item}."
        f: "In deinem Gürtel ist kein Platz für noch eine {item}."
        n: "In deinem Gürtel ist kein Platz für noch ein {item}."
        other: "In deinem Gürtel ist kein Platz mehr für {item}."
      }
    pickup_scroll: {
        m: "Du hebst einen {item} auf."
        f: "Du hebst eine {item} auf."
        n: "Du hebst ein {item} auf."
        other: "Du hebst eine {item} auf."
      }
    pickup_item: "Aufgehoben: {item}."
    pack_full: "Dein Rucksack ist voll."
    pack_too_full: "Dein Rucksack ist zu voll, um das zu tauschen."
    nothing_to_pick_up: "Hier gibt es nichts aufzuheben."
    notice_item: "Du bemerkst etwas am Boden."
    explored: "Hier gibt es nichts mehr zu erkunden."
    spot: "{who} kommt in Sicht."
    boss_destroyed: "{who} ist vernichtet!"
    elite_slain: "{who} ist erschlagen!"
    monster_dies: "{who} stirbt."
    out_of_range: "{who} ist außer Reichweite."
    no_target: "Kein Ziel in Sicht."
    no_mana: "Nicht genug Mana."
    level_up: "Du hast Stufe {n} erreicht! (c: 5 Attributpunkte verteilen)"
    open_chest: "Du öffnest die Truhe."
    altar_cold: "Der Altar ist jetzt kalt."
    altar_restore: "Blutlicht umspült dich. Du bist wiederhergestellt."
    altar_xp: "Verbotenes Wissen durchflutet deinen Geist. (+{n} EP)"
    altar_gift: "Der Altar bietet ein Geschenk dar."
    slain: "Du bist gefallen. Dein Ende: {who}."
    no_healing_potions: "Du hast keine Heiltränke."
    full_life: "Dein Leben ist bereits voll."
    drink_healing: "Du trinkst einen Heiltrank."
    no_mana_potions: "Du hast keine Manatränke."
    full_mana: "Dein Mana ist bereits voll."
    drink_mana: "Du trinkst einen Manatrank."
    already_in_town: "Du bist bereits in der Stadt."
    no_scrolls: "Du hast keine Schriftrollen des Stadtportals."
    boneking_raises: "Der Knochenkönig erweckt die Toten!"
    boneking_greets: "Der Knochenkönig: „Wieder eine Fackel zum Auslöschen. Knie nieder und tritt meinem Hofstaat bei.“"
    boneking_dead: "Die Grüfte verstummen. Kehre zu Hauptmann Voss zurück."
    oracle_reforms: "Die Seherin zerfließt zu Nebel und formt sich neu."
    oracle_lights: "Kalte Lichter sammeln sich um die Seherin."
    oracle_greets: "Die Ertrunkene Seherin: „Ich habe dein Ende gesehen, kleine Flamme. Es ist nass und kalt.“"
    oracle_dead: "Der Gesang der Seherin verstummt. Noch tiefer brennt etwas ... Kehre zu Voss zurück."
    wanderer_greets: "Der Letzte Wanderer: „Wieder ein Fremder. Sie schicken immer einen Fremden.“"
    wanderer_portal: "Der Letzte Wanderer tritt aus dem Portal. Es fällt hinter ihm in sich zusammen."
    wanderer_follows: "Der Letzte Wanderer folgt dir."
    wanderer_home: "Der Letzte Wanderer: „Du hast mir den Weg nach Hause gezeigt.“"
    wanderer_cuts: "{who} blutet unter der Klinge des Letzten Wanderers."
    wanderer_kills: "{who} fällt unter der Klinge des Letzten Wanderers."
    wanderer_taunt: "Der Letzte Wanderer: „Mir haben sie auch ein Schwert gegeben. Und die Rede eines Hauptmanns.“"
    town_empty: "In Emberhold ist niemand mehr außer dir."
    forge_cold: "Hadriks Esse erkaltet."
    wanderer_last_words: "Der Letzte Wanderer: „Geh weiter.“"
    wanderer_dead: "Das rote Licht erlischt, und das Dunkel lässt das Feuer los."
    unseal_here: "Wo er gewartet hat, öffnet sich ein Weg hinab."
    unseal_far: "Tief unten, im Herd, öffnet sich ein Weg hinab."
    running: {
        m: "{who} rennt um sein Leben."
        f: "{who} rennt um ihr Leben."
        n: "{who} rennt um sein Leben."
        pl: "{who} rennen um ihr Leben."
        other: "{who} rennt um sein Leben."
      }
    quest_reward: "{who} gibt dir {n} Gold und dazu: {item}."
    quest_new: "Neuer Auftrag: {name}."
    topic_new: "In der Stadt könntest du nachfragen: {topic}."
    cannot_afford: "Das kannst du dir nicht leisten."
    belt_full: "Dein Gürtel ist voll."
    gamble: "Hadrik wickelt es aus: {item}. {n}g, kein Umtausch."
    reroll: "Hadrik holt für {n}g frische Ware hervor."
    bought: "Gekauft: {item} für {n}g."
    sold: "Verkauft: {item} für {n}g."
    equip: "Angelegt: {item}."
    unequip: "Abgelegt: {item}."
    drop: "Weggeworfen: {item}."
    mirela_healthy: "Mirela mustert dich. „Gesund wie ein Ochse. Kauf etwas, Liebes.“"
    mirela_free: "Mirela versorgt deine Wunden. „Für die Jungen kostet das nichts. Und jetzt kauf etwas, Liebes.“"
    mirela_broke: "Mirela schüttelt den Kopf. „Kräuter kosten Münzen, Liebes.“"
    mirela_partial: "Mirela tut, was deine {n}g erlauben. „Komm mit mehr wieder, Liebes.“"
    mirela_paid: "Mirela versorgt deine Wunden für {n}g. „So. Und jetzt kauf etwas, Liebes.“"
  }
  ref: {
    the: {
        m: "der {name}"
        f: "die {name}"
        n: "das {name}"
        pl: "die {name}"
        other: "der {name}"
      }
    a: {
        m: "ein {name}"
        f: "eine {name}"
        n: "ein {name}"
        pl: "{name}"
        other: "ein {name}"
      }
    death_flames: { text: "die Todesflammen ({name})", gender: "pl" }
  }
  talk: {
    hadrik: {
      greet: "Stahl gegen das Dunkel. Sieh dich um. Die [Esse](forge) ist heiß; das ist sie immer."
      greet_again: "Wieder da. Was muss geflickt werden?"
      greet_boneking: "Heut früh die Glocken der Gruft gehört. Dachte schon, ich werd wunderlich. Dein Werk? Dann hast du dir den guten Stahl verdient."
      greet_oracle: "Der letzte [Fremde](stranger), den ich für die Tiefe gerüstet hab, kam nie zur Reparatur zurück."
      greet_wanderer: "Die Esse loderte weiß auf, als er fiel, dann beruhigte sie sich. Vierzig Jahre, so was hab ich nie an ihr gesehen. An diesem Amboss bist du willkommen."
      greet_hurt: "Du blutest mir auf den Amboss. Erst Mirela. Dann Stahl."
      greet_broke: "Schauen kostet nichts. Der Rest schon."
      greet_kingsbane: "Königstöter. Die letzte Schneide hab ich der Axt gegeben, für den [Vater](father) des Hauptmanns. Zeig sie Voss. Oder lass es."
      greet_kingsbane_again: "Halt die Schneide geölt. Sie hat es sich verdient."
      greet_crown: "In meiner Schmiede nimmst du die Krone ab. Sie macht das Feuer unruhig."
      greet_crown_again: "Krone. Runter."
      forge: "Vierzig Jahre hüte ich sie. Das Hüten geht von Hand zu Hand, von Schmied zu Schmied. Was in ihrem Bauch brennt, ist die [Glut](ember) selbst. An dem Tag, an dem sie ausgeht, fliehen wir. Das ist keine Redensart."
      ember: "Die Leute glauben, sie steht auf einem Sockel am Platz. Sie lebt in meiner Esse. Jede Laterne der Stadt wird hier entzündet. Ich rede nicht darüber, und du wirst es auch nicht."
      ember_again: "Ich hab gesagt, ich rede nicht darüber."
      stranger: "Hat dasselbe Schwert gekauft wie du. Zahlte in alter Münze, feilschte nicht. Ging am Moor vorbei und immer weiter. Seinen Wetzstein hab ich noch. Den wird er zurückwollen."
      stranger_after: "Er ist also doch heimgekommen. Heute Nacht leg ich seinen Wetzstein ins Feuer."
      cult: "Zu mir kamen sie zuerst, der [Glutkult](cult). Wollten, dass ich das Feuer ausgehen lasse und nichts mehr schuldig bin. Ich hab ihnen die Tür gezeigt, den Hammer in der Hand."
      portals: "Asche aus der Esse, in Papier gefaltet. Jeder Funke kennt den Heimweg zum Herd, also auch die Asche. Ich kehr sie zusammen, Mirela faltet sie."
      aldous: "Aldous war einer von denen. Jetzt hockt er bei den Gräbern und erzählt jedem, der stehen bleibt, die [Glut](ember) sei eine Wunde. Vielleicht ist sie das. Eine Wunde ist besser als ein Grab. Sag ihm nicht, dass ich vielleicht gesagt hab."
      pell: "Der Junge am Brunnen. Kam einmal an die Esse, um sich zu wärmen. Stand eine Stunde am Feuer und taute nicht auf."
    }
    mirela: {
      greet: "Setz dich, setz dich. Du riechst nach Rauch und Grabstaub. Zeig her, was gebrochen ist."
      greet_again: "Schon wieder da, Liebes? Lass dich ansehen."
      greet_boneking: "Die Glocken der Gruft haben mich heute früh geweckt. Ich habe geweint, Liebes, und weiß nicht, warum.\nVoss wird dich als Nächstes zu [ihr](oracle) schicken. Bevor du gehst, frag mich nach ihr. Bitte."
      greet_oracle: "Es ist so still, Kind. Mein Kristall hat keinen Laut mehr gegeben, seit du heraufgekommen bist.\nIch bin dir nicht böse, Liebes. Du hast getan, wofür man dich bezahlt hat. Aber leg deine Hand auf den Boden. Er ist warm."
      greet_wanderer: "Du bist zurückgekommen. Er nie, nicht wirklich. Setz dich, Liebes, lass mich nach den Verbrennungen sehen."
      greet_hurt: "Ach, Kind, sieh dich an. Setz dich, bevor du umfällst."
      greet_nopots: "Nicht eine Flasche am Gürtel? Da unten? Setz dich, Liebes. Das richten wir."
      greet_crown: "An meinem Tisch nimmst du die Krone ab, Liebes. Sie flüstert, und ich bin zu alt zum Zuhören."
      greet_crown_again: "Die Krone, Liebes. Runter damit."
      oracle: "Mein Kristall stammt aus ihrer Grotte. Wenn sie träumt, singt er. Sie jagt niemanden, Kind. Sie hält etwas nieder, unter dem Wasser. Ich weiß nicht, was. Ich weiß nur, dass es heiß ist.\nVoss nennt es, ihr ein Ende machen. Ich nenne es, eine Tür öffnen. Geh hinab, wenn du musst, aber hör zu, bevor du die Klinge hebst."
      oracle_again: "Ich habe dir gesagt, was mein Kristall mir sagt. Voss hat ein Schwert, und ich habe einen Stein, der singt. Du entscheidest, wem du glaubst."
      oracle_after: "Mein Kristall singt nicht mehr. Die ganze Stadt schläft jetzt ruhig. Ich nicht. Was immer sie niedergehalten hat, steigt nun durch den [Abgrund](abyss) herauf."
      blackmarsh: "Die Menhire sind ihre. Sie hat sie auf ihrem Weg ins Wasser aufgerichtet, so wie Edran seine Altäre. Die Lichter jagen nicht, Liebes. Sie fragen. [Pell](pell) hat Ja gesagt."
      abyss: "Unter ihrem Teich brennt der Fels. Dort wurde die Kohle herausgeschlagen, wenn man den alten Liedern glaubt. Ich fange an, ihnen zu glauben."
      ember: "Das warme Licht kam von unten herauf. Mein Licht, das kalte, kam von ihr. Die Stadt lebt zwischen beiden und glaubt, sie lebe von einem."
      pell: "Armes Lämmchen. Das Wasser ist in ihn gedrungen. Er hört sie, wie mein Kristall sie hört, nur kann er sie nachts nicht aufs Regal stellen."
      pell_oracle: "Er hat kein Wort gesagt, seit mein Kristall verstummt ist. Abends sitze ich bei ihm. Es scheint ihn nicht zu stören."
      pell_oracle_again: "Immer noch kein Wort. Ich bringe ihm Suppe. Er isst sie nicht, aber er hält die Schüssel."
      pell_wanderer: "Heute Morgen hat er gesprochen, Liebes! Er hat um Brot gebeten. Nur Brot. Ich habe wieder geweint."
      pell_wanderer_again: "Er ist kalt, aber er isst. Das ist ein Anfang."
    }
    voss: {
      greet: "Wanderer. Gut. Wir brauchen eine Klinge, die nicht zittert.\nÖstlich hinter den Feldern, vier Ebenen tief in der [Gruft](crypt), sitzt der [Knochenkönig](boneking) auf seinem Thron aus Rippen. Vernichte ihn.\nHalte eine [Portalrolle](portals) bereit. Komm lebend zurück."
      greet_again: "Du atmest noch. Gut. Der [Knochenkönig](boneking) sitzt vier Ebenen tief in der [Gruft](crypt). Bring mir seinen Staub."
      boneking_reward: "Der Knochenkönig ist Staub? Dann dürfen die Glocken der Gruft wieder läuten.\nNimm das — es gehörte [meinem Vater](father). Und das Gold, natürlich."
      oracle_reward: "Die Seherin, verstummt ... Ich hätte nie gedacht, dass ich schlafen könnte, ohne sie zu hören.\nUnter ihrem Teich brennt der Fels. [Der Abgrund](abyss) hat keinen Boden, sagt man. Sei vorsichtig.\nIch habe schon einmal [jemanden](stranger) hinuntergeschickt. Irgendwann habe ich aufgehört, die Tage zu zählen."
      greet_boneking: "In der Gruft ist es still. Jetzt: das [Schwarzmoor](blackmarsh), nördlich der Felder.\nFolge den kalten Lichtern hinab in die Grotte. Mach der [Seherin](oracle) ein Ende."
      greet_boneking_again: "Das [Schwarzmoor](blackmarsh), nördlich der Felder. Folge den kalten Lichtern hinab. Lass sie dir nicht nach Hause folgen."
      greet_oracle: "Du hast mehr getan, als irgendeiner von uns gewagt hätte.\nMirela sagt, der Wind riecht jetzt nach Schmiede. Soll sie. Wenn du tiefer musst, [der Abgrund](abyss) wartet unter dem Teich der Seherin."
      greet_oracle_again: "Was im [Abgrund](abyss) wartet, steht auf keiner meiner Karten. Geh vorsichtig, oder geh gar nicht."
      greet_wanderer: "Die Laternen brennen wieder. Wer er auch war, einst war er einer von uns.\nGeh weiter, Fremder. Dafür heuern wir dich an."
      greet_wanderer_again: "Die Wache schläft wieder in Schichten. Das ist dein Werk. Mach keine Rede daraus."
      greet_hurt: "Du blutest mir das Tor voll. Geh zu Mirela, dann zu mir."
      greet_kingsbane: "Diese Axt. Königstöter. Mein [Vater](father) hat sie hinuntergetragen. Behalt sie. Er hätte lieber, dass sie schwingt, als dass sie rostet."
      greet_kingsbane_again: "Du trägst sie noch. Gut."
      greet_crown: "Ist das die Krone des [Knochenkönigs](boneking)? Trag sie nicht auf dem Platz. Die Leute erinnern sich."
      greet_crown_again: "Die Krone, Fremder. Nicht auf meinem Platz."
      crypt: "Die königliche Gruft, östlich hinter den Aschefeldern. Vier Ebenen, kalt und staubig. Die Kohlenbecken entzünden sich von selbst. Bleib ihnen fern."
      boneking: "Vier Ebenen unter der Kapelle, auf einem Thron aus Rippen. Mein [Vater](father) ist ihm mit einer Axt nachgestiegen. Bring mir seinen Staub."
      boneking_after: "Staub, sagst du. Gut. Ich glaube es, wenn ich die Glocken höre."
      father: "Er nahm Königstöter mit in die [Gruft](crypt) und kam nicht zurück. Am nächsten Morgen wählte die Wache mich. Es gab niemanden sonst."
      father_again: "Ich habe dir gesagt, was es zu sagen gibt. Lass es."
      father_after: "Du hast zurückgebracht, was ihm gehörte. Das ist mehr, als wir anderen geschafft haben. Frag mich nicht weiter."
      oracle: "Sie hat sich in der Grotte unter dem [Schwarzmoor](blackmarsh) ertränkt, und jetzt ruft sie die Verirrten zu sich hinab. Mach dem ein Ende.\nMirela wird dir sagen, dass sie etwas niederhält. Mirela hört auf einen Stein. Ich begrabe die Leute, denen dieser Stein vorsingt."
      oracle_after: "Verstummt. Jetzt schlafe ich. Seltsam, wie laut eine Stille sein kann."
      stranger: "Vor dir war schon einer da. Gut mit der Klinge. Ich schickte ihn hinab, am Teich der Seherin vorbei. Für dieselbe Arbeit heuere ich in der Regel nicht zweimal an."
      stranger_after: "Wer er auch war, einst war er einer von uns. Lass es dabei."
      cult: "Verräter. Vor einer Generation gingen sie hinab, um das Feuer zurückzugeben. Manche sind noch immer dort unten und geben."
      aldous: "Was vom Kult übrig ist. Ich lasse ihn bei den Gräbern sitzen, weil die Toten ihm nicht zuhören. Du solltest es auch nicht."
      pell: "Der Junge ist den Moorlichtern gefolgt und kalt zurückgekommen. Wenn sie fort ist, wird ihm wieder warm. Das sage ich seiner Schwester."
      pell_oracle: "Der Junge hat kein Wort gesagt, seit du heraufgekommen bist. Gib ihm Zeit. Die Kälte braucht eine Weile, bis sie geht."
      pell_oracle_again: "Gib dem Jungen Zeit."
    }
    aldous: {
      greet: "Wieder eine von Voss' Klingen. Setz dich, wenn du magst; die Gräber haben nichts gegen Gesellschaft. Frag mich nach dem [Kult](cult). Die Stadt erzählt dir, was wir waren. Ich erzähle dir, was wir gesehen haben."
      greet_again: "Atmest noch. Das Feuer ist sich über dich noch nicht einig."
      greet_boneking: "Edran liegt also endlich still. Du hast ihm einen Gefallen getan. Er würde dir danken, hätte das Dunkel ihm einen Mund gelassen."
      greet_oracle: "Leg deine Hand auf den Boden. Warm, nicht wahr? Das hat sie festgehalten. Du hast den Pfropfen gezogen, Wanderer. Jetzt sehen wir, was heraufkommt."
      greet_oracle_again: "Heute wärmer. Morgen noch wärmer."
      greet_wanderer: "Er war, was das Feuer aus jedem von uns machen will. Du hast ihn niedergestreckt. Es wird einen neuen machen. Es ist geduldig. Ich auch."
      greet_hurt: "Du blutest? Geh zu Mirela. Das Feuer mag den Geruch."
      greet_crown: "Edrans Krone. Hörst du sie schon? Du wirst."
      cult: "Wir waren keine Verräter. Wir waren die Einzigen, die zugehört haben. Die [Glut](ember) hat nie uns gehört, also gingen wir hinab, um sie zurückzugeben. Das Feuer hat sich über uns gefreut. Die, die blieben, hat es neu geformt. Ich bin gerannt. Das ist meine ganze Ketzerei."
      ember: "Die Stadt sagt, Edran habe sie heraufgetragen. Er hat sie herausgeschnitten. Das Dunkel ist nicht hungrig, Wanderer. Es ist eine Wunde, die sich schließen will, und Emberhold ist der Splitter darin. Frag Hadrik, warum er nie schläft."
      edran: "Ein Dieb mit Krone. Seine eigene [Seherin](oracle) flehte ihn an, sie zurückzulegen. Er behielt sie, und das Dunkel nahm sein Gesicht als Lohn."
      abyss: "Ich war dort, wo du hingehst. Der Fels blutet dort. Dort hat Edran die Kohle herausgeschnitten, und es hat sich nie geschlossen. Woraus sie auch geschnitten wurde, es ist dort unten, und es ist wach."
      abyss_after: "Jetzt ist es offen. Riech an den Brunnen. Was als Nächstes heraufkommt, wird nicht klein sein, und nicht dumm."
      oracle: "Sie ist die Einzige von uns, die richtig bezahlt hat. Sie hat sich ins Wasser gelegt, um uns das Feuer vom Leib zu halten, und sie hat es Generationen lang gehalten. Voss will sie tot sehen. Natürlich will er das. Er hat nie auch nur einmal unter seine eigenen Stiefel geschaut."
      oracle_after: "Sie hat es Generationen lang gehalten. Du hast es an einem Nachmittag zunichtegemacht. Ich urteile nicht. Ich bin gerannt, weißt du noch."
      stranger: "Ich bin ihm auf meinem Weg herauf begegnet, unter dem Teich. Er fragte, wie tief es hinabgeht. Ich sagte ihm die Wahrheit: ganz hinab. Er dankte mir. Er lächelte."
      stranger_after: "Das also macht das Feuer aus einem Mann, der den ganzen Weg zu ihm hinabgeht. Ich hatte gehofft, es sei nur auf mich zornig."
      pell: "Der Junge hört sie. Ich höre das andere. Zusammen ergibt das eine schlechte Nacht Schlaf."
      aldous: "Bruder. Es gibt keinen Orden mehr, dessen Bruder man sein könnte. Behalte den Titel, wenn du magst; er ist alles, was ich mit heraufgebracht habe."
    }
    pell: {
      greet: "Du bist warm. Hier oben sind alle warm."
      greet_again: "Das Wasser redet wieder. Nicht mit dir."
      greet_boneking: "Die Glocken. Sie hat sie gespürt, unter dem Moor. Sie ist müde. Festhalten ist schwer, wenn man allein ist."
      greet_oracle: "(Pell sieht in den Brunnen und sagt nichts. Das Wasser ist ganz still.)"
      greet_oracle_again: "(Pell sieht nicht auf.)"
      greet_wanderer: "Mir ist kalt. Mir war noch nie kalt. Ist das so, wenn ich nur ich bin?"
      greet_wanderer_again: "Meine Schwester sagt, ich darf wieder ins Moor. Ich glaub, ich will nicht."
      oracle: "Sie ist kalt, damit wir nicht brennen. Sie hat mich gefragt, ob ich ein bisschen davon für sie halte. Ich hab Ja gesagt. Jetzt bin ich auch kalt."
      oracle_after: "(Pell schüttelt den Kopf. Von ihr spricht er nicht.)"
      blackmarsh: "Die Lichter haben nicht gerufen. Sie haben gefragt. Die meisten sagen Ja. Ich hab Ja gesagt."
    }
    any: {
      ember: "König [Edran](edran) trug die Glut mit bloßen Händen von unten herauf. Jede Laterne in Emberhold wird an Hadriks [Esse](forge) entzündet, und die Esse an der Glut. Das Dunkel macht am Tor halt."
      edran: "Der erste König. Er stieg allein hinab und kam mit Feuer zurück. Das Dunkel nahm ihm dafür sein Gesicht, dann seinen Schädel. Auf dem Weg nach oben errichtete er [Altäre](altars); manche stehen noch."
      altars: "Edran ließ auf jedem einen Tropfen seines Blutes, um eine weitere Stunde sicheren Weges zu erkaufen. Blute selbst auf einen, und der Handel zahlt sich aus. Einmal."
      forge: "Hadriks Esse ist seit vierzig Jahren nicht ausgegangen. Frag ihn danach, wenn du gern finster angestarrt wirst."
      portals: "Lies eine Portalrolle, und du stehst wieder am Brunnenplatz. Hadrik fegt die Asche dafür zusammen, Mirela faltet sie. Frag ihn, warum es funktioniert."
      crypt: "Die königliche Gruft, östlich des Tors hinter den Aschefeldern. König [Edran](edran) ruht dort mit seinem Hofstaat. Ruht ist ein großzügiges Wort. Der Hauptmann weiß am meisten darüber."
      boneking: "Er sitzt vier Ebenen tief auf seinem Thron aus Rippen, unter einer hohlen Krone. Es heißt, er sei noch nicht fertig damit, König zu sein."
      boneking_after: "Der Knochenkönig ist Staub, heißt es. Die Glocken der Gruft dürfen wieder läuten."
      father: "Der Vater des Hauptmanns nahm eine alte Axt mit in die Gruft. Der Hauptmann redet nicht darüber. Du solltest es auch nicht."
      blackmarsh: "Nördlich der Felder. Kalte Lichter treiben über dem Wasser. Folge ihnen nicht. Alle folgen ihnen. Mirela lauscht diesem Wasser; frag sie."
      oracle: "Des Königs eigene Seherin. Sie riet ihm, die Kohle nicht zu nehmen. Als er nicht hören wollte, ging sie unter dem [Schwarzmoor](blackmarsh) ins Wasser und kam nie wieder hoch."
      oracle_after: "Die Moorlichter sind erloschen. Die Leute sagen, es ist vorbei. Mirela sagt gar nichts."
      abyss: "Unter dem Teich der Seherin brennt der Fels. Es heißt, der Abgrund hat keinen Boden. Der [Glutkult](cult) ist dort hinabgegangen."
      cult: "Vor einer Generation beschlossen einige, dem Dunkel stehe seine Kohle zu. Sie gingen hinab, um zu bezahlen. Das Feuer formte sie neu. Einer kam zurück: [Bruder Aldous](aldous), drüben bei den Gräbern. Bring ihn bloß nicht ins Reden."
      stranger: "Frag Hadrik. Er hat ihm sein Schwert verkauft und etwas von ihm behalten."
      aldous: "Kam letzten Winter aus dem Abgrund zurück, auf einer Seite verbrannt. Nennt sich Bruder. Sitzt auf dem Friedhof und redet mit den Steinen."
      pell: "Der Junge am Brunnen. Ist den Moorlichtern gefolgt und kalt zurückgekommen. Seine Schwester spricht seinen Namen nach Einbruch der Dunkelheit nicht aus."
      stranger_after: "Die Laternen brennen wieder. Niemand spricht seinen Namen aus. Niemand kannte ihn."
    }
  }
  journal: {
    boneking: {
      taken: "Hauptmann Voss will den Knochenkönig vernichtet sehen. Er sitzt auf seinem Thron aus Rippen, vier Ebenen tief in der Gruft der Gefallenen, östlich des Tors hinter den Aschefeldern. Voss' Vater ist ihm mit einer Axt nachgestiegen und nicht zurückgekehrt."
      done: "Der Knochenkönig ist Staub, und die Grüfte sind verstummt. Voss wird es von dir hören wollen."
      rewarded: "Voss hat in Gold bezahlt und dir etwas gegeben, das seinem Vater gehörte. Die Glocken der Gruft dürfen wieder läuten."
    }
    oracle: {
      taken: "Voss will, dass die Ertrunkene Seherin ein Ende findet. Sie ging ins Wasser unter dem Schwarzmoor, nördlich der Felder, und ruft die Verirrten zu sich hinab. Folge den kalten Lichtern hinab in die Versunkene Grotte."
      done: "Der Gesang der Seherin ist verstummt. Noch tiefer brennt etwas. Voss sollte davon erfahren."
      rewarded: "Voss hat bezahlt und dich gewarnt: Unter ihrem Teich brennt der Fels, und der Brennende Abgrund hat keinen Boden."
    }
    wanderer: {
      taken: "Etwas ist aus dem Abgrund heraufgestiegen, als die Seherin fiel. Jedes Licht erlischt in seiner Nähe, und es sieht aus wie du: der Fremde, den Emberhold vor dir angeheuert hat. Halte den Letzten Wanderer auf, bevor er die Esse erreicht."
      done: "Der Letzte Wanderer ist gefallen. Das Dunkel hat das Feuer losgelassen, und die Laternen von Emberhold brennen wieder."
    }
  }
  topic: {
    rumors: "Neueste Gerüchte"
    ember: "Glut"
    edran: "König Edran"
    altars: "Altäre"
    forge: "Esse"
