    already_in_town: "Du bist bereits in der Stadt."
    no_scrolls: "Du hast keine Schriftrollen des Stadtportals."
    boneking_raises: "Der Knochenkönig erweckt die Toten!"
    boneking_greets: "Der Knochenkönig: „Wieder eine Fackel zum Auslöschen. Knie nieder und tritt meinem Hofstaat bei.“"
    boneking_dead: "Die Grüfte verstummen. Kehre zu Hauptmann Voss zurück."
    oracle_reforms: "Die Seherin zerfließt zu Nebel und formt sich neu."
    oracle_lights: "Kalte Lichter sammeln sich um die Seherin."
    oracle_greets: "Die Ertrunkene Seherin: „Ich habe dein Ende gesehen, kleine Flamme. Es ist nass und kalt.“"
    oracle_dead: "Der Gesang der Seherin verstummt. Noch tiefer brennt etwas ... Kehre zu Voss zurück."
    wanderer_greets: "Der Letzte Wanderer: „Wieder ein Fremder. Sie schicken immer einen Fremden.“"
    wanderer_portal: "Der Letzte Wanderer tritt aus dem Portal. Es fällt hinter ihm in sich zusammen."
    wanderer_follows: "Der Letzte Wanderer folgt dir."
    wanderer_home: "Der Letzte Wanderer: „Du hast mir den Weg nach Hause gezeigt.“"
    wanderer_cuts: "{who} blutet unter der Klinge des Letzten Wanderers."
    wanderer_kills: "{who} fällt unter der Klinge des Letzten Wanderers."
    wanderer_taunt: "Der Letzte Wanderer: „Mir haben sie auch ein Schwert gegeben. Und die Rede eines Hauptmanns.“"
    town_empty: "In Emberhold ist niemand mehr außer dir."
    forge_cold: "Hadriks Esse erkaltet."
    wanderer_last_words: "Der Letzte Wanderer: „Geh weiter.“"
    wanderer_dead: "Das rote Licht erlischt, und das Dunkel lässt das Feuer los."
    unseal_here: "Wo er gewartet hat, öffnet sich ein Weg hinab."
    unseal_far: "Tief unten, im Herd, öffnet sich ein Weg hinab."
    running: {
