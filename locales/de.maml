  ref: {
    the: {
        m: "der {name}"
        f: "die {name}"
        n: "das {name}"
        pl: "die {name}"
        other: "der {name}"
      }
    a: {
        m: "ein {name}"
        f: "eine {name}"
        n: "ein {name}"
        pl: "{name}"
        other: "ein {name}"
      }
    death_flames: { text: "die Todesflammen ({name})", gender: "pl" }
  }
  talk: {
    hadrik: {
      greet: "Hadrik: „Stahl gegen das Dunkel. Sieh dich um.“"
      after_oracle: "Hadrik: „Der Letzte, den ich für die Tiefe gerüstet habe, kam nie zur Reparatur zurück.“"
    }
    voss: {
      intro: "Wanderer. Gut. Wir brauchen eine Klinge, die nicht zittert.\nDie Glut hält das Dunkel fern. Das Dunkel will sie zurück.\nÖstlich des Tors, hinter den Aschefeldern, liegt die Gruft der Gefallenen.\nVier Ebenen tief sitzt der Knochenkönig auf seinem Thron aus Rippen. Vernichte ihn.\nUnd im Norden, im Schwarzmoor, ruft die Ertrunkene Seherin die Verirrten ins Wasser.\nKauf Tränke bei Mirela. Halte eine Portalrolle bereit. Komm lebend zurück."
      boneking_reward: "Der Knochenkönig ist Staub? Dann dürfen die Glocken der Gruft wieder läuten.\nNimm das — es gehörte meinem Vater. Und das Gold, natürlich."
      oracle_reward: "Die Seherin, verstummt ... Ich hätte nie gedacht, dass ich schlafen könnte, ohne sie zu hören.\nUnter ihrem Teich brennt der Fels. Der Abgrund hat keinen Boden, sagt man. Sei vorsichtig.\nIch habe schon einmal jemanden hinuntergeschickt. Irgendwann habe ich aufgehört, die Tage zu zählen."
      after_boneking: "In der Gruft ist es still. Jetzt: das Schwarzmoor, nördlich der Felder.\nFolge den kalten Lichtern hinab in die Grotte. Mach der Seherin ein Ende."
      after_oracle: "Du hast mehr getan, als irgendeiner von uns gewagt hätte.\nWenn du tiefer musst ... der Abgrund wartet unter dem Teich der Seherin."
      after_wanderer: "Die Laternen brennen wieder. Wer er auch war, einst war er einer von uns.\nGeh weiter, Fremder. Dafür heuern wir dich an."
    }
  }
  rumor: {
    braziers: "Es heißt, die Kohlenbecken in der Gruft entzünden sich bei Einbruch der Dämmerung von selbst. Niemand hütet sie."
    brother: "Mein Bruder ist den Lichtern ins Schwarzmoor gefolgt. Er kam nass zurück. Und nicht mehr richtig."
    torch: "Halt deine Fackel hoch. Das Dunkel da unten ist nicht leer — es ist hungrig."
    forge: "Hadriks Esse ist seit vierzig Jahren nicht ausgegangen. Er sagt, an dem Tag, an dem sie ausgeht, fliehen wir."
    glimmer: "Seltene Dinge schimmern im Dunkeln. Goldenes Licht heißt: etwas Altes, mit einem Namen."
    crystal: "Der Kristall der alten Mirela wurde aus der Grotte gegraben. Er singt, wenn die Seherin träumt."
    scroll: "Eine Portalrolle ist billiger als ein Begräbnis."
    stranger: "Vor dir war schon ein Fremder hier. Kaufte dasselbe Schwert. Ging am Moor vorbei und immer weiter."
    edran: "König Edran trug die Glut mit bloßen Händen herauf. Es kostete ihn sein Gesicht."
    uncle: "Mein Onkel ist dem Glutkult beigetreten. Sagte, wir seien dem Dunkel etwas schuldig. Er ging hinab, um zu bezahlen."
    holding: "Mirela sagt, die Seherin jagt niemanden. Sie hält etwas nieder."
  }
