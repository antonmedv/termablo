  unique: {
    last_wanderers_shroud: {
      name: { text: "Leichentuch des Letzten Wanderers", gender: "n" }
      flavor: "Noch warm. Es gehörte nie dir, und jetzt doch."
    }
    wanderers_shroud: {
      name: { text: "Leichentuch des Wanderers", gender: "n" }
      flavor: "Getragen von einem, der nie aufhörte zu gehen."
    }
    shard_of_night: {
      name: { text: "Splitter der Nacht", gender: "m" }
      flavor: "Er trinkt das Fackellicht."
    }
    hollow_crown: {
      name: { text: "Hohlkrone", gender: "f" }
      flavor: "Der König, dem sie gehörte, brauchte keinen Schädel."
    }
    emberbrand: {
      name: { text: "Glutbrand", gender: "m" }
      flavor: "Seine Schneide kühlt nie ab."
    }
    the_last_lantern: {
      name: { text: "Die Letzte Laterne", gender: "f" }
      flavor: "Sie brennt, wenn alles andere dunkel ist."
    }
    moonstride: {
      name: { text: "Mondschritt", gender: "m" }
      flavor: "Schritte wie fallender Schnee."
    }
    band_of_ashes: {
      name: { text: "Reif der Asche", gender: "m" }
      flavor: "Warm in der Hand, immer."
    }
    gravewardens_coat: {
      name: { text: "Mantel des Grabwächters", gender: "m" }
      flavor: "Genäht aus den Leichentüchern der Ruhelosen."
    }
    eye_of_the_deep: {
      name: { text: "Auge der Tiefe", gender: "n" }
      flavor: "Es blinzelt, wenn du nicht hinsiehst."
    }
    crown_of_the_drowned: {
      name: { text: "Krone der Ertrunkenen", gender: "f" }
      flavor: "Noch immer tropft Wasser von ihrem Rand."
    }
    bloodfist: {
      name: { text: "Blutfaust", gender: "f" }
      flavor: "Nie sauber. Nie trocken."
    }
    kingsbane: {
      name: { text: "Königstöter", gender: "m" }
      flavor: "Sieben Kronen sind unter ihm gerollt."
    }
    starfall_plate: {
      name: { text: "Sternfallharnisch", gender: "m" }
      flavor: "Aus einem gefallenen Stern geschmiedet; er erinnert sich an den Himmel."
    }
  }
