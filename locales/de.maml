    unequip: "Abgelegt: {item}."
    drop: "Weggeworfen: {item}."
    mirela_healthy: "Mirela mustert dich. „Gesund wie ein Ochse. Kauf etwas, Liebes.“"
    mirela_free: "Mirela versorgt deine Wunden. „Für die Jungen kostet das nichts. Und jetzt kauf etwas, Liebes.“"
    mirela_broke: "Mirela schüttelt den Kopf. „Kräuter kosten Münzen, Liebes.“"
    mirela_partial: "Mirela tut, was deine {n}g erlauben. „Komm mit mehr wieder, Liebes.“"
    mirela_paid: "Mirela versorgt deine Wunden für {n}g. „So. Und jetzt kauf etwas, Liebes.“"
